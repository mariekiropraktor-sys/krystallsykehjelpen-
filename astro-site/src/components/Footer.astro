---
// Footer: en kort oppsummering, ikke en kopi av menyen (godkjent 2026-11-09).
// Krystallsyke-undersidene og de enkelte tjenestene ligger i menyen og på
// sidene selv. Diagnosesidene hentes fra Svimmelhet-fanen, så nye publiserte
// diagnoser dukker opp her automatisk.
import { getNavigationTabs } from "../data/navigation";

const year = new Date().getFullYear();
const navigationTabs = await getNavigationTabs();

const diagnosisLinks = (navigationTabs.find((t) => t.label === "Svimmelhet")?.items ?? []).filter(
  (item) => item.kind === "link" && item.enabled !== false && item.href !== "/svimmelhet/",
);

const columns = [
  {
    title: "Svimmelhet",
    links: [{ label: "Krystallsyke", href: "/svimmelhet/krystallsyke/" }, ...diagnosisLinks.map((l) => ({ label: l.label, href: l.href }))],
  },
  {
    title: "Hjelp og behandling",
    links: [
      { label: "Krystallsykehjelpen hjemme", href: "/hjemme/" },
      { label: "Øvelsesbibliotek", href: "/ovelsesbibliotek/" },
      { label: "Finn behandler", href: "/finn-behandler/" },
      { label: "Priser", href: "/priser/" },
    ],
  },
  {
    title: "Om",
    links: [
      { label: "Møt Marie", href: "/mott-marie/" },
      { label: "Om Krystallsykehjelpen", href: "/om-krystallsykehjelpen/" },
      { label: "Artikler", href: "/blogg/" },
      { label: "Spørsmål og svar", href: "/faq/" },
      { label: "Kontakt", href: "/kontakt/" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-name">Krystallsykehjelpen</span>
        <p class="footer-tagline">Trygg kunnskap om krystallsyke og svimmelhet, skrevet av kiropraktor Marie Hermansen.</p>
        <div class="footer-contact">
          <a href="tel:+4746384492">+47 463 84 492</a>
          <a href="mailto:mariekiropraktor@gmail.com" class="footer-desktop-only">mariekiropraktor@gmail.com</a>
          <a href="/kontakt/" class="footer-desktop-only">Garderbakken 1, Fetsund</a>
        </div>
        <a href="/fa-hjelp/#bestill" class="footer-btn">Bestill time</a>
      </div>
      {columns.map((col) => (
        <details class="footer-col" open>
          <summary><h4>{col.title}</h4></summary>
          <nav aria-label={col.title}>
            {col.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        </details>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© {year} Krystallsykehjelpen</span>
      <a href="/personvern/" class="footer-legal">Personvern</a>
    </div>
  </div>
</footer>

<script>
  // Mobil: lenkegruppene er lukkede nedtrekk. PC: alltid åpne.
  const mq = window.matchMedia("(max-width: 720px)");
  function syncFooter() {
    document.querySelectorAll(".footer-col").forEach((d) => {
      (d as HTMLDetailsElement).open = !mq.matches;
    });
  }
  syncFooter();
  mq.addEventListener("change", syncFooter);
</script>

<style>
  .site-footer {
    background: var(--navy);
    color: #cbd8ef;
    padding: 48px 0 28px;
    margin-top: 20px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 36px;
  }
  .footer-grid > * { min-width: 0; }
  .site-footer h4 {
    color: #fff;
    font-family: var(--font-display);
    margin-bottom: 12px;
    font-size: 1rem;
  }
  .site-footer a {
    color: #cbd8ef;
    text-decoration: none;
    display: block;
    margin-bottom: 8px;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }
  .site-footer a:hover { color: #fff; }
  .footer-brand { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .footer-name { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: #fff; }
  .footer-brand p { margin: 0; font-size: 0.92rem; line-height: 1.55; color: #cbd8ef; max-width: 32ch; }
  .footer-contact { margin-top: 6px; }
  .footer-contact a { margin-bottom: 4px; }
  .site-footer .footer-btn {
    margin: 10px 0 0; background: #fff; color: var(--navy); font-weight: 700;
    padding: 10px 18px; border-radius: 999px;
  }
  .site-footer .footer-btn:hover { background: var(--sky); color: var(--navy); }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 18px;
    font-size: 0.82rem;
    color: #9db0d1;
    display: flex; flex-wrap: wrap; gap: 6px 18px; justify-content: space-between;
  }
  .site-footer .footer-bottom .footer-legal { display: inline; margin: 0; font-size: inherit; color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .site-footer .footer-bottom .footer-legal:hover { color: #fff; }
  /* Nedtrekk: på PC ser de ut som vanlige kolonner */
  .footer-col summary { list-style: none; cursor: default; pointer-events: none; }
  .footer-col summary::-webkit-details-marker { display: none; }
  @media (max-width: 900px) and (min-width: 721px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .site-footer { padding: 32px 0 20px; }
    .footer-grid { grid-template-columns: 1fr; gap: 0; margin-bottom: 20px; }
    .footer-brand { gap: 6px; margin-bottom: 18px; }
    .footer-tagline, .footer-desktop-only { display: none; }
    .footer-contact { margin-top: 0; }
    .site-footer .footer-btn { margin-top: 6px; }
    .footer-col { border-top: 1px solid rgba(255, 255, 255, 0.14); }
    .footer-col:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
    .footer-col summary {
      pointer-events: auto; cursor: pointer; padding: 14px 0;
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-col summary h4 { margin: 0; }
    .footer-col summary::after { content: "+"; color: #cbd8ef; font-size: 1.3rem; line-height: 1; }
    .footer-col[open] summary::after { content: "–"; }
    .footer-col nav { padding: 0 0 10px; }
    .footer-col summary:focus-visible { outline: 2px solid var(--turquoise); outline-offset: 2px; }
  }
</style>

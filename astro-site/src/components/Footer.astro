---
import { getNavigationTabs, footerBehandlingExtras } from "../data/navigation";

const year = new Date().getFullYear();
const navigationTabs = await getNavigationTabs();

function visibleLinks(tabLabel) {
  const tab = navigationTabs.find((t) => t.label === tabLabel);
  return (tab?.items ?? []).filter((item) => item.kind === "link" && item.enabled !== false);
}

const svimmelhetLinks = visibleLinks("Svimmelhet");
const hjelpDegSelvLinks = visibleLinks("Hjelp deg selv");
const behandlingLinks = [...visibleLinks("Behandling"), ...footerBehandlingExtras];
const omLinks = visibleLinks("Om");
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4>Svimmelhet</h4>
        {svimmelhetLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div>
        <h4>Hjelp deg selv</h4>
        {hjelpDegSelvLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div>
        <h4>Behandling</h4>
        {behandlingLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div>
        <h4>Om</h4>
        {omLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
    <div class="footer-bottom-row">
      <div class="footer-contact">
        <a href="tel:+4746384492">+47 46384492</a>
        <a href="mailto:mariekiropraktor@gmail.com">mariekiropraktor@gmail.com</a>
        <a href="/kontakt/">Garderbakken 1, Fetsund</a>
      </div>
      <div class="footer-bottom">© {year} Krystallsykehjelpen</div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #cbd8ef;
    padding: 48px 0 28px;
    margin-top: 20px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-bottom: 32px;
  }
  .site-footer h4 {
    color: #fff;
    font-family: var(--font-display);
    margin-bottom: 12px;
    font-size: 1rem;
  }
  .site-footer a {
    color: #cbd8ef;
    text-decoration: none;
    display: block;
    margin-bottom: 8px;
    font-size: 0.92rem;
  }
  .site-footer a:hover { color: #fff; }
  .footer-contact { display: flex; flex-direction: column; margin-bottom: 20px; }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 20px;
    font-size: 0.82rem;
    color: #9db0d1;
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

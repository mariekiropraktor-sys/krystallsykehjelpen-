---
import { MARIE_URL } from "../config/marie";

export interface Props {
  bg?: "beige" | "sky";
}

const { bg = "beige" } = Astro.props;
---

<section class={`marie-stripe marie-stripe-${bg}`}>
  <div class="container marie-stripe-inner">
    <div class="marie-stripe-photo-wrap">
      <picture>
        <source srcset="/marie-hermansen.webp" type="image/webp" />
        <img
          src="/marie-hermansen.jpg"
          alt="Marie Hermansen, kiropraktor og grunnlegger av Krystallsykehjelpen"
          width="480"
          height="480"
          loading="lazy"
          class="marie-stripe-photo"
        />
      </picture>
    </div>
    <div class="marie-stripe-top">
      <span class="marie-stripe-label">Hvem står bak</span>
      <h2 class="marie-stripe-heading">Marie Hermansen, kiropraktor</h2>
    </div>
    <div class="marie-stripe-bottom">
      <p class="marie-stripe-body">
        Jeg startet Krystallsykehjelpen for at flere skal få riktig hjelp mot svimmelhet, uansett hvor i landet de bor.
      </p>
      <a href={MARIE_URL} class="marie-stripe-link">Møt Marie →</a>
    </div>
  </div>
</section>

<style>
  .marie-stripe { padding: 30px 0; }
  .marie-stripe-beige { background: var(--beige); }
  .marie-stripe-sky { background: var(--sky); }

  .marie-stripe-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "photo top"
      "bottom bottom";
    column-gap: 16px;
    row-gap: 14px;
    align-items: center;
  }

  .marie-stripe-photo-wrap { grid-area: photo; }
  .marie-stripe-top { grid-area: top; }
  .marie-stripe-bottom { grid-area: bottom; }

  .marie-stripe-photo {
    width: 72px;
    height: 72px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--turquoise);
    flex-shrink: 0;
    display: block;
  }

  .marie-stripe-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .marie-stripe-heading {
    font-family: var(--font-display);
    color: var(--navy);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }

  .marie-stripe-body {
    font-family: var(--font-body);
    color: var(--navy);
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0 0 10px;
    max-width: 56ch;
  }

  .marie-stripe-link {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
  }
  .marie-stripe-link:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .marie-stripe-inner {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "photo top"
        "photo bottom";
      column-gap: 28px;
      row-gap: 6px;
      max-width: 760px;
      align-items: center;
    }

    .marie-stripe-photo { width: 112px; height: 112px; }

    .marie-stripe-heading { font-size: 1.3rem; }
    .marie-stripe-bottom { margin-top: 4px; }
  }
</style>

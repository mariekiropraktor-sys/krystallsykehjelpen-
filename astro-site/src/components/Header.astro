---
export interface Props {
  activePath?: string;
}
const { activePath = "" } = Astro.props;

const links = [
  { href: "/krystallsyken/", label: "Krystallsyke & svimmelhet" },
  { href: "/ovelsesbibliotek/", label: "Øvelser" },
  { href: "/blogg/", label: "Artikler" },
  { href: "/finn-behandler/", label: "Finn behandler" },
  { href: "/om-krystallsykehjelpen/", label: "Om oss" },
];
---

<header class="site-header">
  <div class="nav">
    <a href="/" class="logo">
      <img src="/logo.png" alt="Krystallsykehjelpen" class="logo-icon" />
      <span class="logo-text">
        <span class="logo-title">Krystallsykehjelpen</span>
        <span class="logo-tagline">Spesialisert på svimmelhet</span>
      </span>
    </a>

    <div class="nav-actions">
      <a href="/fa-hjelp/" class="btn btn-ghost btn-nav desktop-cta">Få hjelp</a>
      <button class="hamburger" id="menu-open-btn" aria-label="Åpne meny" aria-controls="mobile-menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
      </button>
    </div>
  </div>
</header>

<div class="menu-backdrop" id="menu-backdrop"></div>
<aside class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-top">
    <span class="mobile-menu-title">Meny</span>
    <button class="hamburger" id="menu-close-btn" aria-label="Lukk meny">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
    </button>
  </div>

  <ul class="mobile-menu-links">
    {links.map((link) => (
      <li>
        <a href={link.href} class={activePath === link.href ? "active" : ""}>{link.label}</a>
      </li>
    ))}
  </ul>

  <form class="mobile-menu-search" action="/sok/" method="get">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
    <input type="text" name="q" placeholder="Søk..." aria-label="Søk" />
    <button type="submit" aria-label="Søk">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
    </button>
  </form>

  <a href="/fa-hjelp/" class="btn btn-primary mobile-menu-cta">Få hjelp</a>
</aside>

<script>
  const openBtn = document.getElementById("menu-open-btn");
  const closeBtn = document.getElementById("menu-close-btn");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("menu-backdrop");

  function openMenu() {
    menu?.classList.add("show");
    backdrop?.classList.add("open");
    openBtn?.setAttribute("aria-expanded", "true");
    requestAnimationFrame(() => menu?.classList.add("open"));
  }

  function closeMenu() {
    menu?.classList.remove("open");
    backdrop?.classList.remove("open");
    openBtn?.setAttribute("aria-expanded", "false");
    setTimeout(() => menu?.classList.remove("show"), 250);
  }

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 var(--line), 0 4px 16px rgba(22, 56, 117, 0.04);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 24px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo-icon { width: 38px; height: 38px; flex-shrink: 0; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
  .logo-title { font-family: var(--font-display); font-size: 1.08rem; color: var(--navy); font-weight: 600; }
  .logo-tagline { font-size: 0.72rem; color: var(--ink-soft); font-weight: 500; }

  .nav-actions { display: flex; align-items: center; gap: 14px; }
  .btn-nav { padding: 9px 18px; font-size: 0.86rem; }

  .btn-ghost { background: transparent; border: 1.5px solid var(--navy); color: var(--navy); }
  .btn-ghost:hover { background: var(--sky); }

  @media (max-width: 900px) {
    .desktop-cta { display: none; }
  }

  .hamburger {
    display: flex;
    width: 40px;
    height: 40px;
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
    color: var(--navy);
    flex-shrink: 0;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }
  .hamburger:hover { border-color: var(--navy-2); }

  /* MENYPANEL */
  .menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(22, 56, 117, 0.35);
    z-index: 90;
  }
  .menu-backdrop.open { display: block; }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 84vw);
    background: #fff;
    z-index: 95;
    padding: 20px;
    box-shadow: -16px 0 40px rgba(22, 56, 117, 0.18);
    transform: translateX(100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
  }
  .mobile-menu.show { display: block; }
  .mobile-menu.open { transform: translateX(0); }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .mobile-menu-title { font-family: var(--font-display); font-weight: 600; color: var(--navy); font-size: 1rem; }

  .mobile-menu-links { list-style: none; margin: 0 0 20px; padding: 0; }
  .mobile-menu-links li { border-bottom: 1px solid var(--line); }
  .mobile-menu-links a {
    display: block;
    padding: 14px 4px;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }
  .mobile-menu-links a.active { color: var(--accent); }

  .mobile-menu-search {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--sky);
    border-radius: 999px;
    padding: 8px 8px 8px 16px;
    margin-bottom: 20px;
  }
  .mobile-menu-search svg { flex-shrink: 0; color: var(--ink-soft); }
  .mobile-menu-search input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--navy);
    min-width: 0;
  }
  .mobile-menu-search button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: var(--navy);
    color: #fff;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
  }

  .mobile-menu-cta { display: flex; justify-content: center; width: 100%; }
  @media (min-width: 901px) {
    .mobile-menu-cta { display: none; }
  }
</style>

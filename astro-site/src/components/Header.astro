---
import { getNavigationTabs, BOOKING_URL } from "../data/navigation";

export interface Props {
  activePath?: string;
}
const { activePath = "" } = Astro.props;

const navigationTabs = await getNavigationTabs();

function isVisible(item) {
  return item.kind === "link" && item.enabled !== false;
}

// Fanen for gjeldende side er allerede åpen når menyen åpnes — beregnes
// server-side ut fra activePath, ingen JS-omberegning trengs ved åpning.
const activeTabIndex = navigationTabs.findIndex((tab) =>
  tab.items.some((item) => item.kind === "link" && item.href === activePath),
);
---

<header class="site-header">
  <div class="nav">
    <a href="/" class="logo">
      <img src="/logo-new.png" alt="Krystallsykehjelpen" class="logo-icon" />
      <span class="logo-text">
        <span class="logo-title">Krystallsykehjelpen</span>
        <span class="logo-tagline">Spesialisert på svimmelhet</span>
      </span>
    </a>

    <div class="nav-actions">
      <a href="/fa-hjelp/" class="btn btn-ghost btn-nav header-cta">Få hjelp</a>
      <button class="hamburger" id="menu-open-btn" aria-label="Åpne meny" aria-controls="mobile-menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
      </button>
    </div>
  </div>
</header>

<div class="menu-backdrop" id="menu-backdrop"></div>
<aside class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-top">
    <span class="mobile-menu-title">Meny</span>
    <button class="hamburger" id="menu-close-btn" aria-label="Lukk meny">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
    </button>
  </div>

  <form class="mobile-menu-search" action="/sok/" method="get">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
    <input type="text" name="q" placeholder="Søk i Krystallsykehjelpen" aria-label="Søk i Krystallsykehjelpen" />
    <button type="submit" aria-label="Søk">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
    </button>
  </form>

  <div class="nav-tabs">
    {navigationTabs.map((tab, i) => {
      const isOpen = i === activeTabIndex;
      return (
        <div class="nav-tab">
          <button
            type="button"
            class="nav-tab-trigger"
            aria-expanded={isOpen ? "true" : "false"}
            aria-controls={`tab-panel-${i}`}
            id={`tab-trigger-${i}`}
          >
            <span>{tab.label}</span>
            <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <div class={`nav-tab-panel-wrap ${isOpen ? "open" : ""}`} data-tab-wrap>
            <div class="nav-tab-panel-inner">
              <ul
                class="nav-tab-panel"
                id={`tab-panel-${i}`}
                role="region"
                aria-labelledby={`tab-trigger-${i}`}
              >
                {tab.items.map((item) =>
                  item.kind === "divider" ? (
                    <li class="nav-divider" role="presentation" />
                  ) : isVisible(item) ? (
                    <li>
                      <a
                        href={item.href}
                        class={item.href === activePath ? "active" : ""}
                        aria-current={item.href === activePath ? "page" : undefined}
                      >
                        <span class="nav-link-label">{item.label}</span>
                        {item.description && <span class="nav-link-desc">{item.description}</span>}
                      </a>
                    </li>
                  ) : null,
                )}
              </ul>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn btn-primary mobile-menu-cta">Bestill time</a>
</aside>

<script>
  const openBtn = document.getElementById("menu-open-btn");
  const closeBtn = document.getElementById("menu-close-btn");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("menu-backdrop");

  function openMenu() {
    menu?.classList.add("show");
    backdrop?.classList.add("open");
    openBtn?.setAttribute("aria-expanded", "true");
    requestAnimationFrame(() => menu?.classList.add("open"));
  }

  function closeMenu() {
    menu?.classList.remove("open");
    backdrop?.classList.remove("open");
    openBtn?.setAttribute("aria-expanded", "false");
    setTimeout(() => menu?.classList.remove("show"), 250);
    openBtn?.focus();
  }

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.classList.contains("open")) closeMenu();
  });

  // Faner — uavhengige av hverandre, flere kan være åpne samtidig. Åpen
  // tilstand ved menyåpning er allerede satt server-side (activeTabIndex i
  // Header.astro); scriptet håndterer kun brukerens egne klikk/tastetrykk.
  document.querySelectorAll(".nav-tab-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const wrap = btn.nextElementSibling;
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", isOpen ? "false" : "true");
      wrap?.classList.toggle("open", !isOpen);
    });
  });
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 var(--line), 0 4px 16px rgba(22, 56, 117, 0.04);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 24px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    min-width: 0;
  }

  .logo-icon { width: 38px; height: 38px; flex-shrink: 0; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
  .logo-title { font-family: var(--font-display); font-size: 1.08rem; color: var(--navy); font-weight: 600; white-space: nowrap; }
  .logo-tagline { font-size: 0.72rem; color: var(--ink-soft); font-weight: 500; white-space: nowrap; }

  .nav-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .btn-nav { padding: 9px 18px; font-size: 0.86rem; }

  .btn-ghost { background: transparent; border: 1.5px solid var(--navy); color: var(--navy); }
  .btn-ghost:hover { background: var(--sky); }

  @media (max-width: 768px) {
    .logo-tagline { display: none; }
    .header-cta { padding: 7px 12px; font-size: 0.8125rem; }
  }

  .hamburger {
    display: flex;
    width: 40px;
    height: 40px;
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
    color: var(--navy);
    flex-shrink: 0;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }
  .hamburger:hover { border-color: var(--navy-2); }

  /* MENYPANEL */
  .menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(22, 56, 117, 0.35);
    z-index: 90;
  }
  .menu-backdrop.open { display: block; }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(360px, 88vw);
    background: #fff;
    z-index: 95;
    padding: 20px;
    box-shadow: -16px 0 40px rgba(22, 56, 117, 0.18);
    transform: translateX(100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
    flex-direction: column;
  }
  .mobile-menu.show { display: flex; }
  .mobile-menu.open { transform: translateX(0); }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  .mobile-menu-title { font-family: var(--font-display); font-weight: 600; color: var(--navy); font-size: 1rem; }

  .mobile-menu-search {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--sky);
    border-radius: 999px;
    padding: 8px 8px 8px 16px;
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  .mobile-menu-search svg { flex-shrink: 0; color: var(--ink-soft); }
  .mobile-menu-search input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--navy);
    min-width: 0;
  }
  .mobile-menu-search button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: var(--navy);
    color: #fff;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
  }

  /* FANER */
  .nav-tabs { flex: 1 1 auto; overflow-y: auto; min-height: 0; }
  .nav-tab { border-bottom: 1px solid var(--line); }

  .nav-tab-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: none;
    border: none;
    padding: 14px 4px;
    font-family: var(--font-body);
    font-size: 1.03rem;
    font-weight: 600;
    color: var(--navy);
    cursor: pointer;
    text-align: left;
  }
  .nav-tab-trigger:hover { background: var(--sky); }
  .nav-tab-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 6px; }
  .nav-tab-trigger .chevron { flex-shrink: 0; color: var(--ink-soft); transition: transform 0.2s ease; }
  .nav-tab-trigger[aria-expanded="true"] .chevron { transform: rotate(180deg); }

  .nav-tab-panel-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.2s ease;
  }
  .nav-tab-panel-wrap.open { grid-template-rows: 1fr; }
  .nav-tab-panel-inner { overflow: hidden; min-height: 0; }

  .nav-tab-panel { list-style: none; margin: 0; padding: 0 0 10px; }
  .nav-tab-panel li { border-left: 1.5px solid var(--line); margin-left: 6px; }
  .nav-tab-panel a {
    display: block;
    padding: 7px 12px;
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    margin-left: -1.5px;
    border-left: 3px solid transparent;
  }
  .nav-tab-panel a:hover,
  .nav-tab-panel a:focus-visible {
    background: var(--sky);
  }
  .nav-tab-panel a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .nav-tab-panel a.active {
    background: var(--sky);
    border-left: 3px solid var(--turquoise);
    font-weight: 600;
    border-radius: 0 8px 8px 0;
  }
  .nav-link-label { display: block; }
  .nav-link-desc { display: block; font-size: 0.78rem; font-weight: 400; color: var(--ink-soft); margin-top: 2px; }

  .nav-divider { border-left: none !important; margin: 6px 0 6px 18px; border-top: 1px solid var(--line); height: 0; list-style: none; }

  @media (prefers-reduced-motion: reduce) {
    .nav-tab-panel-wrap, .nav-tab-trigger .chevron, .mobile-menu { transition: none; }
  }

  .mobile-menu-cta { display: flex; justify-content: center; width: 100%; flex-shrink: 0; margin-top: 16px; }
</style>

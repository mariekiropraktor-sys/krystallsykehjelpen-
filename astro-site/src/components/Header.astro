---
export interface Props {
  activePath?: string;
}
const { activePath = "" } = Astro.props;

const links = [
  { href: "/", label: "Hjem" },
  { href: "/om-krystallsykehjelpen/", label: "Om Krystallsykehjelpen" },
  { href: "/krystallsyken/", label: "Krystallsyken" },
  { href: "/ovelsesbibliotek/", label: "Øvelsesbibliotek" },
  { href: "/finn-behandler/", label: "Finn behandler" },
  { href: "/kontakt/", label: "Kontakt oss" },
];

const resourceLinks = [
  { href: "/faq/", label: "FAQ" },
  { href: "/blogg/", label: "Blogg" },
];

const bookingUrl =
  "https://psno-patient-platform-fe.svc.pasientsky.no/embedded/planner/booking?serviceProviderId=54907264-049e-11eb-8fc8-26c6f94d64b7";
---

<header class="site-header">
  <nav class="nav">
    <a href="/" class="logo">
      <img src="/logo.png" alt="Krystallsykehjelpen" class="logo-icon" />
      <span class="logo-text">
        <span class="logo-title">Krystallsykehjelpen</span>
        <span class="logo-tagline">Spesialisert på svimmelhet</span>
      </span>
    </a>

    <button class="nav-toggle" aria-label="Åpne meny" id="nav-toggle">☰</button>

    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} class={activePath === link.href ? "active" : ""}>
            {link.label}
          </a>
        </li>
      ))}
      <li class={`has-dropdown ${resourceLinks.some((l) => l.href === activePath) ? "active-parent" : ""}`}>
        <button class="dropdown-trigger" aria-expanded="false" aria-controls="ressurser-menu" type="button">
          Ressurser
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
        </button>
        <ul class="dropdown-menu" id="ressurser-menu">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class={activePath === link.href ? "active" : ""}>{link.label}</a>
            </li>
          ))}
        </ul>
      </li>
      <li>
        <a href={bookingUrl} class="btn btn-primary btn-nav">Bestill time</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");
  toggle?.addEventListener("click", () => {
    links?.classList.toggle("open");
  });

  document.querySelectorAll(".dropdown-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const li = btn.closest(".has-dropdown");
      const isOpen = li?.classList.toggle("open");
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  });
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 var(--line), 0 4px 16px rgba(22, 56, 117, 0.04);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 24px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo-icon { width: 38px; height: 38px; flex-shrink: 0; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
  .logo-title { font-family: var(--font-display); font-size: 1.08rem; color: var(--navy); font-weight: 600; }
  .logo-tagline { font-size: 0.72rem; color: var(--ink-soft); font-weight: 500; }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--navy);
    background: var(--sky);
  }

  .nav-links li:has(.btn-nav) { margin-left: 6px; }

  .has-dropdown { position: relative; }
  .dropdown-trigger {
    background: none;
    border: none;
    font: inherit;
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    padding: 8px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-trigger:hover { color: var(--navy); background: var(--sky); }
  .has-dropdown.active-parent .dropdown-trigger { color: var(--navy); background: var(--sky); }
  .dropdown-trigger .chev { transition: transform 0.2s ease; }
  .has-dropdown.open .dropdown-trigger .chev,
  .has-dropdown:hover .dropdown-trigger .chev { transform: rotate(180deg); }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 32px rgba(22, 56, 117, 0.14);
    min-width: 160px;
    padding: 6px;
    display: none;
    list-style: none;
    margin: 0;
    z-index: 60;
  }
  .dropdown-menu a { padding: 10px 12px; border-radius: 8px; display: block; }
  .has-dropdown:hover .dropdown-menu,
  .has-dropdown.open .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu { display: block; }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--navy);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 4px;
  }

  .btn-nav { padding: 9px 18px; font-size: 0.86rem; }

  @media (max-width: 860px) {
    .nav-links {
      position: absolute;
      top: calc(100% + 8px);
      left: 16px;
      right: 16px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 12px 32px rgba(22, 56, 117, 0.14);
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px;
      display: none;
    }
    .nav-links.open { display: flex; }
    .nav-links a { padding: 13px 16px; width: 100%; border-radius: 10px; }
    .nav-links li:has(.btn-nav) { margin: 6px 4px 4px; }
    .nav-toggle { display: block; }
    .btn-nav { width: 100%; justify-content: center; }

    .dropdown-trigger { width: 100%; justify-content: space-between; padding: 13px 16px; }
    .dropdown-menu {
      position: static;
      box-shadow: none;
      border: none;
      padding-left: 14px;
      display: none;
    }
    .has-dropdown.open .dropdown-menu { display: block; }
    .has-dropdown:hover .dropdown-menu { display: none; }
    .has-dropdown.open:hover .dropdown-menu { display: block; }
  }
</style>

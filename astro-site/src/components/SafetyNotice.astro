---
// Gjenbrukbar sikkerhetsboks vist før en manøver/øvelse startes. Teksten er
// fast (gitt direkte av Marie i hjemme-fase2-prompt.md), ikke hentet fra
// Sanity — samme tekst for alle manøvre.
export interface Props {
  heading?: string;
}

const { heading = "Før du starter" } = Astro.props;

const points = [
  "Sørg for at dette er manøveren du har fått anbefalt.",
  "Det kan være lurt å ha en annen person til stede.",
  "Beveg deg rolig mellom stillingene.",
  "Det er vanlig at svimmelhet kan utløses under manøveren.",
  "Stopp dersom du får nye eller tydelig annerledes symptomer enn dem du vanligvis forbinder med krystallsyken.",
];
---

<div class="safety-notice">
  <h3>{heading}</h3>
  <ul>
    {points.map((point) => <li>{point}</li>)}
  </ul>
  <a href="/fa-hjelp/" class="link">Når bør jeg få ny vurdering? →</a>
</div>

<style>
  .safety-notice { background: var(--sky); border-radius: var(--radius); padding: 36px 40px; margin-bottom: 40px; }
  .safety-notice h3 { font-size: 1.25rem; margin: 0 0 16px; }
  .safety-notice ul { margin: 0 0 16px; padding-left: 20px; }
  .safety-notice li { font-size: 0.9rem; line-height: 1.6; color: var(--ink-soft); margin-bottom: 6px; }
  .safety-notice .link { color: var(--accent); font-weight: 600; font-size: 0.88rem; text-decoration: none; }
  .safety-notice .link:hover { text-decoration: underline; }
  @media (max-width: 640px) { .safety-notice { padding: 26px 22px; } }
</style>

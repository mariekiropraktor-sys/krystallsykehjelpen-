---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BestillValg from "../components/BestillValg.astro";
import MarieStripe from "../components/MarieStripe.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  activePath?: string;
  image?: string;
  hideMarie?: boolean;
  marieBg?: "beige" | "sky";
  noindex?: boolean;
}

const { title, description, activePath = "", image, hideMarie = false, marieBg = "beige", noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Delingsbilde (Facebook, Messenger, iMessage, LinkedIn). Sider uten eget
// bilde får standardbildet med logo og forsidens budskap, ellers gjetter
// tjenestene selv og velger et tilfeldig bilde fra siden.
const DEFAULT_OG_IMAGE = "/og-krystallsykehjelpen.jpg";
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, Astro.site).href;
---

<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.ico?v=7" sizes="any" />
  <link rel="icon" href="/favicon-32.png?v=7" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png?v=7" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon-180.png?v=7" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#163875" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="nb_NO" />
  <meta property="og:site_name" content="Krystallsykehjelpen" />
  <meta property="og:image" content={ogImage} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  {!image && <meta property="og:image:alt" content="Krystallsykehjelpen – trygg kunnskap når verden plutselig snurrer" />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <Header activePath={activePath} />
  <main>
    <slot />
  </main>
  {!hideMarie && <MarieStripe bg={marieBg} />}
  <Footer />
  <BestillValg />
</body>
</html>

---
// Prisoversikt: klinikk, videokonsultasjon og hjemmebesøk.
// Prisene er hardkodet her (ikke Sanity), samme som videokonsultasjonssiden.
// Endrer du en videopris, oppdater også /tjenester/videokonsultasjon/.
import Layout from "../../layouts/Layout.astro";
import { BOOKING_URL } from "../../data/navigation";

const klinikk = [
  { tag: "Første gang", title: "Ny pasient", desc: "Undersøkelse og behandling", price: "1 100" },
  { title: "Oppfølging, 40 min", desc: "Behandling og videre plan", price: "855" },
  { title: "Oppfølging, 20 min", desc: "Kort kontroll eller ny manøver", price: "625" },
];

const video = [
  { tag: "Anbefalt første gang", title: "Første time, 40 min", desc: "Gjennomgang og veiledning steg for steg", price: "890" },
  { title: "Oppfølging, 20 min", desc: "Konkrete spørsmål eller kontroll av øvelse", price: "550" },
];
---

<Layout
  title="Priser | Krystallsykehjelpen"
  description="Priser for time på klinikken i Fetsund, videokonsultasjon og hjemmebesøk ved akutt krystallsyke."
  activePath="/priser/"
  marieBg="sky"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Priser</span>
      <h1>Hva koster <em>en time?</em></h1>
      <p class="hero-lead">Her finner du prisene for time på klinikken i Fetsund, videokonsultasjon og hjemmebesøk. Du får alltid vite prisen før timen.</p>
      <nav class="jump" aria-label="Hopp til">
        <a href="#klinikk">Klinikken</a>
        <a href="#video">Video</a>
        <a href="#hjemme">Hjemmebesøk</a>
      </nav>
    </div>
  </section>

  <section class="price-section section-white" id="klinikk">
    <div class="container">
      <div class="shead">
        <div>
          <h2>Time på klinikken</h2>
          <span class="place">Fetsund Kiropraktorsenter, Garderbakken 1</span>
        </div>
        <p>Ved første time undersøker vi deg grundig og behandler hvis funnene tilsier det.</p>
      </div>
      <div class="plist">
        {klinikk.map((row) => (
          <div class="prow">
            <div>
              {row.tag && <span class="tag">{row.tag}</span>}
              <h3>{row.title}</h3>
              <span class="pdesc">{row.desc}</span>
            </div>
            <div class="amt">{row.price}<span>kr</span></div>
          </div>
        ))}
      </div>
      <div class="actions">
        <a href={BOOKING_URL} class="btn btn-primary">Bestill time</a>
      </div>
    </div>
  </section>

  <section class="price-section section-sky" id="video">
    <div class="container">
      <div class="shead">
        <div>
          <h2>Videokonsultasjon</h2>
          <span class="place">Hjemmefra, uansett hvor du bor</span>
        </div>
        <p>Veiledning i øvelser og manøvrer, spørsmål og oppfølging. Passer best når du allerede er undersøkt.</p>
      </div>
      <div class="plist">
        {video.map((row) => (
          <div class="prow">
            <div>
              {row.tag && <span class="tag tag-beige">{row.tag}</span>}
              <h3>{row.title}</h3>
              <span class="pdesc">{row.desc}</span>
            </div>
            <div class="amt">{row.price}<span>kr</span></div>
          </div>
        ))}
      </div>
      <div class="actions">
        <a href="/tjenester/videokonsultasjon/#foresporsel" class="btn btn-primary">Send forespørsel</a>
        <a href="/tjenester/videokonsultasjon/" class="tlink">Les mer om videokonsultasjon →</a>
      </div>
    </div>
  </section>

  <section class="price-section section-beige" id="hjemme">
    <div class="container">
      <div class="shead">
        <div>
          <h2>Hjemmebesøk</h2>
          <span class="place">Når du er for svimmel til å reise</span>
        </div>
        <p>Ved akutt krystallsyke kan det være vanskelig å komme seg til klinikken. Da kan jeg komme hjem til deg.</p>
      </div>
      <span class="when">Kveld og helg</span>
      <div class="hv">
        <div class="hcard">
          <h3>Nærområdet</h3>
          <div class="amt amt-lg">2 500<span>kr</span></div>
          <p>Lillestrøm, Lørenskog og Rælingen kommune</p>
        </div>
        <div class="hcard far">
          <h3>Oslo og andre kommuner</h3>
          <div class="amt amt-lg">2 900<span>kr</span></div>
          <p>Inkludert 400 kr i reisetillegg for bom, parkering og kjøretid</p>
        </div>
      </div>
      <ul class="tk">
        <li>Hjemmebesøk avtales etter forespørsel</li>
        <li>Du får bekreftet pris og tidspunkt før jeg kommer</li>
        <li>Ingen ekstra kostnader i tillegg til prisen over</li>
      </ul>
      <div class="actions">
        <a href="/tjenester/hjemmebesok/#foresporsel" class="btn btn-primary">Send forespørsel</a>
      </div>
      <div class="safe" role="note">
        <span class="safe-icon" aria-hidden="true">!</span>
        <p><strong>Ved akutte, alvorlige symptomer</strong> som lammelser, talevansker, dobbeltsyn, besvimelse eller plutselig kraftig hodepine: ring 113. Legevakt: 116 117.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { background: var(--sky); padding: 64px 0 56px; }
  .eyebrow { font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--navy-2); font-weight: 700; margin-bottom: 10px; display: inline-block; }
  .hero h1 em { font-weight: 500; color: var(--accent); }
  .hero-lead { font-size: 1.02rem; line-height: 1.65; color: var(--ink-soft); margin: 0; max-width: 56ch; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .jump a { background: var(--paper); border-radius: 999px; padding: 9px 16px; text-decoration: none; font-weight: 600; font-size: 0.92rem; color: var(--navy); box-shadow: 0 2px 10px rgba(22, 56, 117, 0.08); }
  .jump a:hover { color: var(--navy-2); }

  .price-section { padding: 60px 0; scroll-margin-top: 80px; }
  .section-white { background: var(--paper); }
  .section-sky { background: var(--sky); }
  .section-beige { background: var(--beige); }

  .shead { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 32px; margin-bottom: 28px; }
  .shead h2 { margin: 0; }
  .shead p { margin: 0; max-width: 46ch; font-size: 0.95rem; }
  .place { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-soft); font-size: 0.92rem; margin-top: 6px; }
  .place::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--turquoise); }

  .plist { background: var(--paper); border-radius: var(--radius); box-shadow: 0 16px 36px rgba(22, 56, 117, 0.08); overflow: hidden; border: 1px solid var(--line); }
  .prow { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); }
  .prow:last-child { border-bottom: 0; }
  .prow h3 { font-size: 1.15rem; margin: 0; }
  .pdesc { display: block; color: var(--ink-soft); font-size: 0.9rem; margin-top: 2px; }
  .tag { display: inline-block; background: var(--sky); color: var(--accent); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 3px 9px; border-radius: 999px; margin-bottom: 6px; }
  .tag-beige { background: var(--beige); color: var(--navy); }
  .amt { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: var(--navy); white-space: nowrap; }
  .amt span { font-family: var(--font-body); font-size: 0.95rem; font-weight: 500; color: var(--ink-soft); margin-left: 4px; }
  .amt-lg { font-size: 2.3rem; margin: 6px 0 4px; }

  .actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 22px; }
  .tlink { color: var(--accent); font-weight: 700; font-size: 0.92rem; text-decoration: none; }
  .tlink:hover { text-decoration: underline; }

  .when { display: inline-block; background: var(--navy); color: #fff; border-radius: 999px; padding: 6px 14px; font-size: 0.85rem; font-weight: 600; margin-bottom: 18px; }
  .hv { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .hcard { background: var(--paper); border-radius: var(--radius); padding: 26px; box-shadow: 0 16px 36px rgba(22, 56, 117, 0.08); border: 2px solid transparent; }
  .hcard h3 { font-size: 1.1rem; margin: 0; }
  .hcard p { margin: 0; font-size: 0.95rem; }
  .hcard.far { border-color: var(--accent); }

  .tk { list-style: none; padding: 0; margin: 22px 0 0; }
  .tk li { position: relative; padding-left: 24px; margin: 8px 0; color: var(--ink); }
  .tk li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 10px; height: 10px; border-radius: 50%; background: var(--turquoise); }

  .safe { margin-top: 28px; background: var(--paper); border-left: 5px solid var(--navy-2); border-radius: var(--radius-sm); padding: 18px 20px; display: flex; gap: 14px; align-items: flex-start; }
  .safe-icon { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--navy-2); color: #fff; font-weight: 700; display: grid; place-items: center; }
  .safe p { margin: 0; font-size: 0.95rem; color: var(--ink); }
  .safe strong { color: var(--navy); }

  @media (max-width: 720px) {
    .hero { padding: 48px 0 44px; }
    .price-section { padding: 48px 0; }
    .hv { grid-template-columns: 1fr; }
    .prow { padding: 18px; }
  }
</style>

---
import Layout from "../../../../layouts/Layout.astro";
import MediaPlaceholder from "../../../../components/MediaPlaceholder.astro";
import { sanityClient } from "sanity:client";
import { safeFetch } from "../../../../lib/safeFetch";
import { inlineHtmlFromBlock } from "../../../../lib/portableText";

export async function getStaticPaths() {
  try {
    const exercises = await sanityClient.fetch(
      `*[_type == "exercise" && defined(slug.current)]{
        "exerciseSlug": slug.current, "categorySlug": category->slug.current
      }`,
    );
    return exercises
      .filter((e) => e.categorySlug)
      .map((e) => ({ params: { categorySlug: e.categorySlug, exerciseSlug: e.exerciseSlug } }));
  } catch (error) {
    console.warn("[ovelsesbibliotek/[categorySlug]/[exerciseSlug]] Kunne ikke hente stier fra Sanity:", error);
    return [];
  }
}

const { categorySlug, exerciseSlug } = Astro.params;

const exercise = await safeFetch(
  `*[_type == "exercise" && slug.current == $exerciseSlug && category->slug.current == $categorySlug][0]{
    title, description, steps, difficultyLevel,
    "category": category->{ title, "slug": slug.current },
    videoOrImage{ asset->{ url, mimeType } }
  }`,
  { exerciseSlug, categorySlug },
  null,
);
---

<Layout
  title={exercise ? `${exercise.title} | Øvelsesbibliotek | Krystallsykehjelpen` : "Øvelsesbibliotek | Krystallsykehjelpen"}
  description={exercise ? `Steg-for-steg-instruksjon for ${exercise.title}.` : "Øvelsesbibliotek – Krystallsykehjelpen."}
  activePath="/ovelsesbibliotek/"
>
  {exercise ? (
    <section class="exercise">
      <div class="container exercise-container">
        <a href={`/ovelsesbibliotek/${categorySlug}/`} class="card-link back-link">← Tilbake til {exercise.category?.title ?? "kategorien"}</a>

        <div class="exercise-head">
          <h1>{exercise.title}</h1>
          {exercise.difficultyLevel && <span class="badge">{exercise.difficultyLevel}</span>}
        </div>

        {exercise.description?.length ? (
          exercise.description.map((block) => <p set:html={inlineHtmlFromBlock(block)} />)
        ) : null}

        {exercise.videoOrImage?.asset?.url ? (
          exercise.videoOrImage.asset.mimeType?.startsWith("video/") ? (
            <video src={exercise.videoOrImage.asset.url} controls class="exercise-media" />
          ) : (
            <img src={exercise.videoOrImage.asset.url} alt={exercise.title} class="exercise-media" />
          )
        ) : (
          <MediaPlaceholder label={`Video/bilde: ${exercise.title}`} />
        )}

        {exercise.steps?.length ? (
          <ol class="steps">
            {exercise.steps.map((step) => <li>{step}</li>)}
          </ol>
        ) : (
          <p>Ingen steg lagt inn ennå.</p>
        )}
      </div>
    </section>
  ) : (
    <section class="container not-found">
      <h1>Fant ikke øvelsen</h1>
      <p>Denne øvelsen finnes ikke.</p>
      <a href="/ovelsesbibliotek/" class="btn btn-primary">Til øvelsesbibliotek</a>
    </section>
  )}
</Layout>

<style>
  .exercise { padding: 56px 0 90px; }
  .exercise-container { max-width: 720px; }
  .back-link { display: inline-block; margin-bottom: 20px; }

  .exercise-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .exercise-head h1 { margin-bottom: 0; }

  .badge {
    display: inline-block; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.02em;
    padding: 4px 12px; border-radius: 999px; background: var(--sky); color: var(--navy-2);
    text-transform: capitalize;
  }

  .exercise-media { width: 100%; border-radius: var(--radius); margin: 24px 0; object-fit: cover; aspect-ratio: 16/9; }

  .steps { padding-left: 22px; margin: 24px 0; }
  .steps li { margin-bottom: 14px; font-size: 1.02rem; line-height: 1.6; color: var(--ink); }

  .not-found { padding: 90px 24px; text-align: center; max-width: 520px; }
</style>

---
import Layout from "../../layouts/Layout.astro";

// Statisk side (output: "static") — kan ikke lese ?q= server-side, siden
// siden pre-rendres én gang uten spørrestreng. Selve søket kjører derfor
// client-side (se scriptet nederst i filen): leser ?q= fra window.location,
// spør Sanity sitt offentlige query-API direkte, og rendrer resultatene i JS.
//
// TODO: Filterknapper (Alle / Øvelser / Artikler) er utsatt til en senere
// runde — bevisst ikke bygget som ikke-funksjonelle knapper for v1.
---

<Layout
  title="Søk | Krystallsykehjelpen"
  description="Søk på symptom, diagnose eller øvelse hos Krystallsykehjelpen."
  activePath=""
>
  <section class="hero hero-simple">
    <div class="container">
      <span class="eyebrow">Søk</span>
      <h1>Finn øvelser og artikler</h1>
      <form class="search-box" id="search-form">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="text" name="q" id="search-input" placeholder="Søk på symptom, diagnose eller øvelse..." />
        <button type="submit" class="search-btn">Søk</button>
      </form>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 60" preserveAspectRatio="none">
      <path d="M0,32 C360,72 1080,0 1440,32 L1440,60 L0,60 Z" fill="#ffffff" />
    </svg>
  </section>

  <section class="section-alt no-top">
    <div class="container">
      <div id="search-status" class="search-status"></div>
      <div id="search-results"></div>
    </div>
  </section>
</Layout>

<script>
  import { HABITUERING_SECTIONS } from "../../lib/habitueringSections";

  const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
  const dataset = import.meta.env.PUBLIC_SANITY_DATASET;

  function groupTitleFor(value) {
    return HABITUERING_SECTIONS[value]?.title ?? value;
  }

  function escapeHtml(value) {
    return (value ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  async function sanityQuery(query, params) {
    const url = new URL(`https://${projectId}.api.sanity.io/v2024-01-01/data/query/${dataset}`);
    url.searchParams.set("query", query);
    for (const [key, value] of Object.entries(params)) {
      url.searchParams.set(`$${key}`, JSON.stringify(value));
    }
    const res = await fetch(url.toString());
    if (!res.ok) throw new Error(`Sanity-spørring feilet: ${res.status}`);
    const data = await res.json();
    return data.result ?? [];
  }

  function exerciseCard(ex) {
    const href = `/ovelsesbibliotek/${ex.groupSlug}/${ex.slug}/`;
    return `
      <a href="${href}" class="card result-card">
        <div class="card-body">
          <span class="result-tag">${escapeHtml(groupTitleFor(ex.groupTitle))}</span>
          <h3>${escapeHtml(ex.title)}</h3>
          <span class="card-link">Se øvelse →</span>
        </div>
      </a>`;
  }

  function postCard(post) {
    const href = `/blogg/${post.slug}/`;
    return `
      <a href="${href}" class="card result-card">
        <div class="card-body">
          ${post.category ? `<span class="result-tag">${escapeHtml(post.category)}</span>` : ""}
          <h3>${escapeHtml(post.title)}</h3>
          ${post.excerpt ? `<p>${escapeHtml(post.excerpt)}</p>` : ""}
          <span class="card-link">Les mer →</span>
        </div>
      </a>`;
  }

  async function runSearch(q) {
    const status = document.getElementById("search-status");
    const results = document.getElementById("search-results");
    if (!status || !results) return;

    if (!q) {
      status.textContent = "";
      results.innerHTML = "";
      return;
    }

    status.textContent = "Søker...";
    results.innerHTML = "";

    const pattern = `*${q}*`;
    try {
      const [exercises, posts] = await Promise.all([
        sanityQuery(
          `*[_type == "exercise" && (title match $q || category->title match $q)]{
            title, "slug": slug.current,
            "groupSlug": coalesce(category->slug.current, habitueringSeksjon),
            "groupTitle": coalesce(category->title, habitueringSeksjon)
          }`,
          { q: pattern },
        ),
        sanityQuery(
          `*[_type == "blogPost" && (title match $q || excerpt match $q)]{
            title, "slug": slug.current, excerpt, category
          }`,
          { q: pattern },
        ),
      ]);

      if (!exercises.length && !posts.length) {
        status.textContent = "";
        results.innerHTML = `
          <div class="no-results">
            <p>Ingen resultater for «${escapeHtml(q)}».</p>
            <p>Sjekk stavemåten, eller <a href="/ovelsesbibliotek/" class="card-link">se hele øvelsesbiblioteket →</a></p>
          </div>`;
        return;
      }

      status.textContent = `Resultater for «${q}»`;
      let html = "";
      if (exercises.length) {
        html += `<h2 class="result-group-heading">Øvelser</h2><div class="card-grid">${exercises.map(exerciseCard).join("")}</div>`;
      }
      if (posts.length) {
        html += `<h2 class="result-group-heading">Artikler</h2><div class="card-grid">${posts.map(postCard).join("")}</div>`;
      }
      results.innerHTML = html;
    } catch (error) {
      console.warn("[sok] Søk feilet:", error);
      status.textContent = "";
      results.innerHTML = `<div class="no-results"><p>Noe gikk galt med søket. Prøv igjen om litt.</p></div>`;
    }
  }

  const form = document.getElementById("search-form");
  const input = document.getElementById("search-input");
  const initialQuery = new URLSearchParams(window.location.search).get("q") ?? "";

  if (input) input.value = initialQuery;
  runSearch(initialQuery);

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input?.value.trim() ?? "";
    const newUrl = q ? `/sok/?q=${encodeURIComponent(q)}` : "/sok/";
    window.history.pushState({}, "", newUrl);
    runSearch(q);
  });
</script>

<style>
  .hero-simple { padding: 56px 0 90px; position: relative; overflow: hidden; text-align: center; }
  .hero-simple .container { max-width: 600px; }
  .eyebrow { font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 10px; display: inline-block; }
  .hero-wave { position: absolute; bottom: -2px; left: 0; width: 100%; line-height: 0; }

  .search-box {
    display: flex; align-items: center; gap: 10px; background: #fff;
    border: 1.5px solid var(--line); border-radius: 999px; padding: 8px 8px 8px 20px;
    box-shadow: 0 8px 24px rgba(22, 56, 117, 0.08); margin-top: 24px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-box:focus-within { border-color: var(--accent); box-shadow: 0 8px 28px rgba(47, 121, 201, 0.18); }
  .search-box svg { flex-shrink: 0; color: var(--ink-soft); }
  .search-box input {
    border: none; outline: none; flex: 1; font-family: var(--font-body);
    font-size: 0.98rem; color: var(--navy); background: transparent; padding: 10px 0; min-width: 0;
  }
  .search-btn {
    background: var(--navy); color: #fff; border: none; border-radius: 999px;
    padding: 12px 22px; font-family: var(--font-body); font-weight: 600; font-size: 0.92rem; cursor: pointer;
  }

  .section-alt { background: var(--paper); padding: 60px 0; }
  .section-alt.no-top { padding-top: 0; padding-bottom: 90px; }

  .search-status { text-align: center; color: var(--ink-soft); font-size: 0.9rem; margin-bottom: 20px; min-height: 1.2em; }
  .result-group-heading { font-size: 1.15rem; margin: 30px 0 16px; }
  .result-group-heading:first-child { margin-top: 0; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .result-card {
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; display: block; box-shadow: 0 12px 28px rgba(22, 56, 117, 0.06);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .result-card:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(22, 56, 117, 0.1); }
  .result-card .card-body { padding: 22px; }
  .result-card h3 { font-size: 1rem; margin: 4px 0 8px; }
  .result-card p { font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 8px; }
  .result-tag {
    display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 3px 10px;
    border-radius: 999px; background: var(--sky); color: var(--navy-2);
  }
  .card-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.86rem; color: var(--navy-2); margin-top: 4px; }

  .no-results { text-align: center; padding: 40px 20px; color: var(--ink-soft); }
  .no-results p { margin: 0 0 8px; }
</style>

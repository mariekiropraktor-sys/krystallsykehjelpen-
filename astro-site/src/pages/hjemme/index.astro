---
import Layout from "../../layouts/Layout.astro";
import ExerciseCard from "../../components/ExerciseCard.astro";
import HelpCTA from "../../components/HelpCTA.astro";
import { safeFetch } from "../../lib/safeFetch";
import { HABITUERING_SECTIONS } from "../../lib/habitueringSections";

// ===== Progressiv, ett-steg-av-gangen-omstrukturering av /hjemme/ =====
// Erstatter den tidligere ene, lange siden (alle utfall stablet under
// hverandre) med en forgrenet flyt der kun ett steg/spørsmål vises om
// gangen. Selve manøver-/øvelsesinstruksjonene ligger IKKE lenger
// duplisert her — resultatsteget i sti A og rehab-kortene lenker videre
// til /ovelsesbibliotek/, som er kilden til sannhet for instruksjonene.
//
// Arkitektur: alle skjermer ligger i DOM-en (rendret av Astro/Sanity som
// vanlig), men kun én er synlig om gangen — styrt av scriptet nederst via
// `[hidden]` og en enkel historikk-stack (for fungerende «← Tilbake» uansett
// hvilken vei besøkende kom inn i et steg fra). Startskjermen (id="steg1")
// er alltid synlig som utgangspunkt; alle andre skjermer har `hidden` satt
// i markupen og vises kun via JS.
//
// Retired i denne omstruktureringen (komponentfilene er IKKE slettet, kun
// avviklet fra denne siden — se sluttrapport):
// - Den gamle «steg 2»-manøverlisten (ManeuverRow, alle 9 dokumenter i én
//   liste) — erstattet av sti A sitt direkte side+kanal-treff.
// - SafetyNotice/VideoGuide (inline video-steg-visning) — instruksjonene
//   vises nå på /ovelsesbibliotek/ i stedet for duplisert her.
// - FollowUpQuestion sitt rike 5-alternativs «Hva skjer nå?»-panel
//   (inkl. det detaljerte akutt-varselet med slag-sjekkliste) — erstattet
//   av sti B sitt enkle ja/nei-spørsmål. Sanity-feltene bak det gamle
//   panelet (followUp*, panel*, acuteWarning*) er IKKE fjernet fra
//   skjemaet eller slettet i Studio, kun ikke lenger hentet/vist her.

const hp =
  (await safeFetch(
    `*[_id == "hjemmePage"][0]{
      flowStartHeading, flowStartSubheading,
      flowCard1Title, flowCard1Subtitle, flowCard2Title, flowCard2Subtitle, flowCard3Title, flowCard3Subtitle,
      flowBackLabel,
      flowAStep1Question, flowAStep1Subtext, flowASideOptions,
      flowAStep2Question, flowAStep2Subtext, flowACanalOptions,
      flowASafetyHeading, flowASafetyText, flowAResultCtaLabel, flowAResultBackLabel,
      flowBStep1Question, flowBYesNoOptions, flowBYesText, flowBYesCtaLabel, flowBNoText, flowBNoCtaLabel,
      flowCStep1Question, flowCDurationOptions,
      restsvimmelhetEyebrow, restsvimmelhetHeading, restsvimmelhetIntro, restsvimmelhetCards,
      restsvimmelhetCard4Heading, restsvimmelhetCard4Body, restsvimmelhetCard4Button1, restsvimmelhetCard4Button2,
      rehabEyebrow, rehabHeading, rehabIntro, rehabLead, rehabCtaHeading, rehabCtaBody, rehabCtaButton,
      rehabGroup2Heading, rehabGroup2Lead,
      hjelpEyebrow, hjelpHeading, hjelpText1, hjelpText2, hjelpButton1, hjelpButton2, attributionText
    }`,
    {},
    null,
  )) ?? {};

const flowData = {
  startHeading: hp.flowStartHeading ?? "Hva trenger du hjelp med?",
  startSubheading: hp.flowStartSubheading ?? "Velg det som passer situasjonen din. Vi guider deg videre – ett steg av gangen.",
  card1Title: hp.flowCard1Title ?? "Jeg har fått diagnosen – hva nå?",
  card1Subtitle: hp.flowCard1Subtitle ?? "Finn riktig øvelse for din situasjon",
  card2Title: hp.flowCard2Title ?? "Jeg har behandlet krystallsyken – hva nå?",
  card2Subtitle: hp.flowCard2Subtitle ?? "Se hva som skjer etterpå",
  card3Title: hp.flowCard3Title ?? "Jeg er fortsatt svimmel",
  card3Subtitle: hp.flowCard3Subtitle ?? "Få hjelp til å forstå hvorfor",
  backLabel: hp.flowBackLabel ?? "← Tilbake",
  aStep1Question: hp.flowAStep1Question ?? "Hvilken side ble du diagnostisert på?",
  aStep1Subtext: hp.flowAStep1Subtext ?? "Dette står vanligvis i diagnosen fra behandleren din.",
  aSideOptions: hp.flowASideOptions?.length ? hp.flowASideOptions : ["Venstre", "Høyre"],
  aStep2Question: hp.flowAStep2Question ?? "Hvilken buegang (kanal)?",
  aStep2Subtext: hp.flowAStep2Subtext ?? "Usikker? Velg «Bakre» – det er den vanligste.",
  aCanalOptions: hp.flowACanalOptions?.length ? hp.flowACanalOptions : ["Bakre buegang", "Laterale buegang", "Fremre buegang"],
  aSafetyHeading: hp.flowASafetyHeading ?? "Viktig",
  aSafetyText: hp.flowASafetyText ?? "Avbryt og kontakt behandler ved sterke smerter, synsforstyrrelser eller andre uvante symptomer.",
  aResultCtaLabel: hp.flowAResultCtaLabel ?? "Se full veiledning →",
  aResultBackLabel: hp.flowAResultBackLabel ?? "Tilbake til start",
  bStep1Question: hp.flowBStep1Question ?? "Har symptomene kommet tilbake etter behandling?",
  bYesNoOptions: hp.flowBYesNoOptions?.length ? hp.flowBYesNoOptions : ["Ja", "Nei"],
  bYesText: hp.flowBYesText ?? "Det er ikke uvanlig at krystallene løsner igjen. Da kan du finne riktig manøver for situasjonen din på nytt, samme fremgangsmåte som sist.",
  bYesCtaLabel: hp.flowBYesCtaLabel ?? "Finn riktig øvelse →",
  bNoText: hp.flowBNoText ?? "Bra! Da handler veien videre mest om gode vaner og gradvis eksponering, slik at balansesystemet venner seg til bevegelse igjen og risikoen for tilbakefall går ned.",
  bNoCtaLabel: hp.flowBNoCtaLabel ?? "Se øvelser og råd →",
  cStep1Question: hp.flowCStep1Question ?? "Hvor lenge har du kjent deg svimmel etter behandling?",
  cDurationOptions: hp.flowCDurationOptions?.length ? hp.flowCDurationOptions : ["Under 1 uke", "1–4 uker", "Mer enn 4 uker"],
};

// --- Sti A: finn riktig øvelse basert på side + kanal ---
// canal-verdiene i Sanity (bakre/horisontal/fremre) mappes posisjonelt til
// flowData.aCanalOptions (indeks 0/1/2 — se beskrivelse på feltet i Studio).
// Ved flere treff per kanal+side (Epley og Semont finnes begge for bakre
// buegang; Barbecue-rull og Gufoni for horisontal) velges laveste `order`
// som primærtreff — dette speiler Maries egen tekst i Sanity direkte:
// Epleys lead-tekst kaller den «den mest brukte og best dokumenterte»,
// Semont kaller seg et alternativ; Gufoni er tekstet som «alternativ
// manøver» til Barbecue-rull. Ingen klinisk vurdering er gjettet her.
const CANAL_VALUES = ["bakre", "horisontal", "fremre"];
const SIDE_VALUES = ["venstre", "hoyre"];

const reponeringRaw = await safeFetch(
  `*[_type == "exercise" && exerciseType == "reponering"]{
    title, "slug": slug.current, canal, side, lead, aftercare, order,
    "categorySlug": category->slug.current
  } | order(order asc)`,
  {},
  [],
);

function findMatch(canalValue, sideValue) {
  return (
    reponeringRaw.find((ex) => ex.canal === canalValue && ex.side === sideValue) ??
    reponeringRaw.find((ex) => ex.canal === canalValue && !ex.side) ??
    null
  );
}

const MATCH_TABLE = {};
for (const canalValue of CANAL_VALUES) {
  for (const sideValue of SIDE_VALUES) {
    const match = findMatch(canalValue, sideValue);
    MATCH_TABLE[`${canalValue}-${sideValue}`] = match
      ? {
          title: match.title,
          lead: match.lead ?? "",
          tips: (match.aftercare ?? []).slice(0, 3),
          href: match.categorySlug ? `/ovelsesbibliotek/${match.categorySlug}/${match.slug}/?fra=hjemme` : `/ovelsesbibliotek/`,
        }
      : null;
  }
}

// --- Rehab (habituering) — Brandt-Daroff er nå med (den gamle
// «steg 2»-listen som viste den separat, er retired, se over) ---
const rehabExercisesRaw = await safeFetch(
  `*[_type == "exercise" && exerciseType == "habituering"]{
    title, "slug": slug.current, habitueringSeksjon, format, duration, lead
  } | order(order asc)`,
  {},
  [],
);

function decorateExercise(ex) {
  return {
    title: ex.title,
    situasjon: HABITUERING_SECTIONS[ex.habitueringSeksjon]?.title ?? "",
    lead: ex.lead,
    duration: ex.duration,
    href: `/ovelsesbibliotek/${ex.habitueringSeksjon}/${ex.slug}/?fra=hjemme`,
  };
}

const rehabExerciseGroup = rehabExercisesRaw.filter((ex) => ex.format !== "read").map(decorateExercise);
const rehabAdviceGroup = rehabExercisesRaw.filter((ex) => ex.format === "read").map(decorateExercise);

const rehabData = {
  eyebrow: hp.rehabEyebrow ?? "Vestibulær rehabilitering",
  heading: hp.rehabHeading ?? "Når balansen trenger litt tid",
  intro: hp.rehabIntro ?? "Etter at krystallsyken er behandlet, kan noen ha nytte av gradvis trening av balanse, hodebevegelser og bevegelsestoleranse.",
  lead: hp.rehabLead ?? "Blant øvelsene under: velg dem som kjennes ubehagelige å gjøre. Det er de bevegelsene kroppen trenger å bli vant til igjen.",
  ctaHeading: hp.rehabCtaHeading ?? "Usikker på hvilke øvelser som passer for deg?",
  ctaBody: hp.rehabCtaBody ?? "I en videokonsultasjon kan øvelsene tilpasses situasjonen din, og du får veiledning i hvordan de skal gjøres.",
  ctaButton: hp.rehabCtaButton ?? "Bestill videokonsultasjon",
  group2Heading: hp.rehabGroup2Heading ?? "Råd for hverdagen",
  group2Lead: hp.rehabGroup2Lead ?? "Dette er ikke øvelser, men vaner og grep som kan gjøre hverdagen tryggere.",
};

const restsvimmelhetData = {
  eyebrow: hp.restsvimmelhetEyebrow ?? "Restsvimmelhet",
  heading: hp.restsvimmelhetHeading ?? "Krystallsyken er bedre – men jeg føler meg fortsatt ustø",
  intro:
    hp.restsvimmelhetIntro ??
    "Dette er en vanlig opplevelse etter behandling. Restsvimmelhet kan blant annet kjennes som ustøhet, bevegelsesfølsomhet eller en følelse av at balansen ikke er helt som før.",
  cards: hp.restsvimmelhetCards?.length
    ? hp.restsvimmelhetCards
    : [
        {
          heading: "Jeg blir svimmel når jeg beveger hodet",
          body: "Mange kjenner at raske hodebevegelser gir en kort følelse av at omgivelsene henger etter. Det er noe man ofte kan trene seg gradvis ut av.",
        },
        {
          heading: "Jeg føler meg ustø når jeg går",
          body: "Det kan kjennes som at underlaget er ujevnt, eller at du må konsentrere deg mer enn før for å gå trygt. Dette bedrer seg for mange gradvis.",
        },
        {
          heading: "Jeg blir verre i butikker og steder med mye synsinntrykk",
          body: "Store rom med mye bevegelse, mønstre og lys kan oppleves overveldende når balansesystemet er ute av vane. Gradvis eksponering er ofte en del av opptreningen.",
        },
      ],
  card4Heading: hp.restsvimmelhetCard4Heading ?? "Jeg føler meg utrygg når jeg ligger eller beveger meg raskt",
  card4Body:
    hp.restsvimmelhetCard4Body ??
    "Svimmelhet som kommer når du legger deg ned eller snur deg i sengen, er typisk for krystallsyke. Det kan bety at krystallene ikke har kommet helt på plass ennå.\n\nManøveren kan gjentas morgen og kveld i to til tre dager. Hvis du ikke merker bedring i løpet av den tiden, kan en ny vurdering være lurt.",
  card4Button1: hp.restsvimmelhetCard4Button1 ?? "Gjør manøveren på nytt",
  card4Button2: hp.restsvimmelhetCard4Button2 ?? "Få en ny vurdering",
};

const helpData = {
  eyebrow: hp.hjelpEyebrow ?? "Trenger du hjelp?",
  heading: hp.hjelpHeading ?? "Usikker på hva som er riktig neste steg?",
  text1:
    hp.hjelpText1 ??
    "Hvis du ikke vet hvilken buegang som er påvirket, hvilken manøver du skal gjøre, eller symptomene dine har endret seg, kan det være bedre med en ny vurdering enn å prøve flere øvelser på egen hånd.",
  text2: hp.hjelpText2 ?? "Videokonsultasjon kan brukes til spørsmål, usikkerhet og veiledning av øvelser og manøvrer.",
  button1: hp.hjelpButton1 ?? "Bestill videokonsultasjon",
  button2: hp.hjelpButton2 ?? "Se alle måter å få hjelp på",
};

const attributionText =
  hp.attributionText ?? "Krystallsykehjelpen er utviklet for å gjøre kunnskap om svimmelhet og krystallsyke lettere tilgjengelig.";
---

<Layout
  title="Krystallsykehjelpen hjemme | Veiledning etter krystallsyke"
  description="Har du fått påvist krystallsyke? Få trinnvis veiledning til manøvrer, informasjon om tiden etter behandling og hjelp ved restsvimmelhet."
  activePath="/hjemme/"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Krystallsykehjelpen hjemme</span>
        <h1>Krystallsykehjelpen hjemme</h1>
        <p class="subheading">Fra diagnose til tryggere hverdag.</p>
        <p class="ingress">Har du fått påvist krystallsyke? Her får du hjelp til å finne veiledningen du har fått anbefalt, gjennomføre behandlingen hjemme og forstå hva du bør gjøre videre.</p>
        <div class="hero-ctas">
          <a href="#steg1" class="btn btn-primary">Start veiledningen</a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/hjemme-hero-illustrasjon.jpg"
          alt="Kvinne som sitter avslappet i sofaen og følger en digital veiledning på nettbrett, med illustrasjon av det indre øret og tre steg i en manøver merket av med et hakemerke"
          class="hero-photo"
        />
      </div>
    </div>
  </section>

  <section class="section-alt no-top">
    <div class="container">
      <div class="prereq">
        <h2>Før du starter</h2>
        <p>Krystallsykehjelpen hjemme er laget for deg som allerede har fått vurdert svimmelheten din og fått påvist krystallsyke.</p>
        <p>For å velge riktig manøver bør du vite hvilken side og buegang som er påvirket, eller hvilken manøver du har fått anbefalt.</p>
        <p>Hvis du ikke vet dette, bør du ikke velge en tilfeldig manøver basert på symptomer alene.</p>
        <div class="prereq-ctas">
          <a href="#steg1" class="btn btn-outline">Jeg vet hvilken behandling jeg skal gjøre</a>
          <a href="/fa-hjelp/" class="btn btn-outline">Jeg er usikker på diagnosen min</a>
        </div>
      </div>
    </div>
  </section>

  <div id="hjemme-flow">
    <!-- Startskjerm — alltid synlig, ingenting annet under kortene. -->
    <section class="steg1" id="steg1" data-screen="start">
      <div class="container">
        <h2>{flowData.startHeading}</h2>
        <p class="start-subheading">{flowData.startSubheading}</p>
        <div class="choice-grid">
          <button type="button" class="choice-card" data-goto="a1">
            <h3>{flowData.card1Title}</h3>
            <p>{flowData.card1Subtitle}</p>
            <span class="link">Kom i gang →</span>
          </button>
          <button type="button" class="choice-card" data-goto="b1">
            <h3>{flowData.card2Title}</h3>
            <p>{flowData.card2Subtitle}</p>
            <span class="link">Kom i gang →</span>
          </button>
          <button type="button" class="choice-card" data-goto="c1">
            <h3>{flowData.card3Title}</h3>
            <p>{flowData.card3Subtitle}</p>
            <span class="link">Kom i gang →</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Sti A, steg 1: side -->
    <section class="flow-screen section-alt" data-screen="a1" hidden>
      <div class="container flow-narrow">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <h2>{flowData.aStep1Question}</h2>
        <p class="flow-subtext">{flowData.aStep1Subtext}</p>
        <div class="answer-grid" id="a1-buttons">
          {flowData.aSideOptions.map((label, i) => (
            <button type="button" class="answer-btn" data-value={SIDE_VALUES[i]}>{label}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- Sti A, steg 2: kanal -->
    <section class="flow-screen section-alt" data-screen="a2" hidden data-match-table={JSON.stringify(MATCH_TABLE)}>
      <div class="container flow-narrow">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <h2>{flowData.aStep2Question}</h2>
        <p class="flow-subtext">{flowData.aStep2Subtext}</p>
        <div class="answer-grid" id="a2-buttons">
          {flowData.aCanalOptions.map((label, i) => (
            <button type="button" class="answer-btn" data-value={CANAL_VALUES[i]}>{label}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- Sti A, resultat -->
    <section class="flow-screen section-alt" data-screen="a-result" hidden>
      <div class="container flow-narrow">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <div class="result-card">
          <h2 id="a-result-title"></h2>
          <p id="a-result-lead"></p>
          <ul class="result-tips" id="a-result-tips"></ul>
          <div class="safety-box">
            <h3>{flowData.aSafetyHeading}</h3>
            <p>{flowData.aSafetyText}</p>
          </div>
          <div class="result-ctas">
            <a href="/ovelsesbibliotek/" id="a-result-cta" class="btn btn-primary">{flowData.aResultCtaLabel}</a>
            <button type="button" class="link" data-reset="start">{flowData.aResultBackLabel}</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Sti B: ja/nei, avdekkes på samme skjerm -->
    <section class="flow-screen section-alt" data-screen="b1" hidden>
      <div class="container flow-narrow">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <h2>{flowData.bStep1Question}</h2>
        <div class="answer-grid answer-grid-yesno" id="b1-buttons">
          <button type="button" class="answer-btn" data-reveal="b-yes">{flowData.bYesNoOptions[0] ?? "Ja"}</button>
          <button type="button" class="answer-btn" data-reveal="b-no">{flowData.bYesNoOptions[1] ?? "Nei"}</button>
        </div>
        <div class="reveal-panel" data-reveal-panel="b-yes" hidden>
          <p>{flowData.bYesText}</p>
          <button type="button" class="btn btn-outline btn-sm" data-goto="a1">{flowData.bYesCtaLabel}</button>
        </div>
        <div class="reveal-panel" data-reveal-panel="b-no" hidden>
          <p>{flowData.bNoText}</p>
          <button type="button" class="btn btn-outline btn-sm" data-goto="rehab">{flowData.bNoCtaLabel}</button>
        </div>
      </div>
    </section>

    <!-- Sti C, steg 1: varighet -->
    <section class="flow-screen section-alt" data-screen="c1" hidden>
      <div class="container flow-narrow">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <h2>{flowData.cStep1Question}</h2>
        <div class="answer-grid" id="c1-buttons">
          {flowData.cDurationOptions.map((label) => (
            <button type="button" class="answer-btn" data-goto="c2">{label}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- Sti C, steg 2: eksisterende restsvimmelhet-innhold -->
    <section class="flow-screen restsvimmelhet" data-screen="c2" hidden>
      <div class="container">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <span class="eyebrow">{restsvimmelhetData.eyebrow}</span>
        <h2>{restsvimmelhetData.heading}</h2>
        <p class="intro">{restsvimmelhetData.intro}</p>

        <div class="restsvimmelhet-grid">
          {restsvimmelhetData.cards.map((card) => (
            <button type="button" class="rest-card" data-goto="rehab">
              <h3>{card.heading}</h3>
              <p>{card.body}</p>
              <span class="link">Se øvelser →</span>
            </button>
          ))}
        </div>

        <div class="rest-card-wide">
          <h3>{restsvimmelhetData.card4Heading}</h3>
          {restsvimmelhetData.card4Body.split("\n\n").map((para) => <p>{para}</p>)}
          <div class="rest-card-ctas">
            <button type="button" class="btn btn-outline btn-sm" data-goto="a1">{restsvimmelhetData.card4Button1}</button>
            <a href="/fa-hjelp/" class="btn btn-outline btn-sm">{restsvimmelhetData.card4Button2}</a>
          </div>
        </div>

        <p class="rest-read-more"><a href="/blogg/restsvimmelhet-etter-krystallsyke/" class="link">Les mer om restsvimmelhet →</a></p>
      </div>
    </section>

    <!-- Rehab — nås fra sti B (Nei) og sti C (steg 2) -->
    <section class="flow-screen rehab section-sky" data-screen="rehab" hidden>
      <div class="container">
        <button type="button" class="flow-back" data-back>{flowData.backLabel}</button>
        <span class="eyebrow">{rehabData.eyebrow}</span>
        <h2>{rehabData.heading}</h2>
        <p class="intro">{rehabData.intro}</p>
        <p class="lead">{rehabData.lead}</p>

        {rehabExerciseGroup.length || rehabAdviceGroup.length ? (
          <>
            {rehabExerciseGroup.length > 0 && (
              <div class="rehab-grid">
                {rehabExerciseGroup.map((ex) => (
                  <ExerciseCard
                    title={ex.title}
                    situasjon={ex.situasjon}
                    lead={ex.lead}
                    duration={ex.duration}
                    payload={{}}
                    href={ex.href}
                    compact
                    linkText="Se øvelse →"
                  />
                ))}
                <div class="rehab-cta">
                  <div>
                    <h3>{rehabData.ctaHeading}</h3>
                    <p>{rehabData.ctaBody}</p>
                  </div>
                  <a href="/tjenester/videokonsultasjon/" class="btn btn-primary">{rehabData.ctaButton}</a>
                </div>
              </div>
            )}

            {rehabAdviceGroup.length > 0 && (
              <div class="rehab-group2">
                <h3>{rehabData.group2Heading}</h3>
                <p class="lead">{rehabData.group2Lead}</p>
                <div class="rehab-grid">
                  {rehabAdviceGroup.map((ex) => (
                    <ExerciseCard
                      title={ex.title}
                      situasjon={ex.situasjon}
                      lead={ex.lead}
                      duration={ex.duration}
                      payload={{}}
                      href={ex.href}
                      compact
                      linkText="Se øvelse →"
                    />
                  ))}
                </div>
              </div>
            )}
          </>
        ) : (
          <p class="exercise-empty">Rehabiliteringsøvelsene er ikke tilgjengelige akkurat nå.</p>
        )}
      </div>
    </section>
  </div>

  <HelpCTA
    eyebrow={helpData.eyebrow}
    heading={helpData.heading}
    text1={helpData.text1}
    text2={helpData.text2}
    button1Label={helpData.button1}
    button2Label={helpData.button2}
  />

  <div class="attribution-band">
    <p class="container">{attributionText}</p>
  </div>
</Layout>

<script>
  // Ren klient-side skjermnavigasjon — ingen data lagres eller sendes til
  // server. En enkel historikk-stack gir fungerende «← Tilbake» uansett
  // hvilken vei besøkende kom inn i et steg fra (flyten forgrener seg).
  const screens = document.querySelectorAll("[data-screen]");
  const history = ["start"];

  function showScreen(name) {
    screens.forEach((el) => {
      el.hidden = el.getAttribute("data-screen") !== name;
    });
    document.getElementById("hjemme-flow")?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function goTo(name) {
    history.push(name);
    showScreen(name);
  }

  function goBack() {
    if (history.length > 1) history.pop();
    showScreen(history[history.length - 1]);
  }

  function resetTo(name) {
    history.length = 0;
    history.push(name);
    showScreen(name);
  }

  document.querySelectorAll("[data-goto]").forEach((el) => {
    el.addEventListener("click", () => goTo(el.getAttribute("data-goto")));
  });
  document.querySelectorAll("[data-back]").forEach((el) => {
    el.addEventListener("click", goBack);
  });
  document.querySelectorAll("[data-reset]").forEach((el) => {
    el.addEventListener("click", () => resetTo(el.getAttribute("data-reset")));
  });

  // Sti A: side (steg 1) → lagre svar, gå til kanal (steg 2)
  let selectedSide = null;
  document.querySelectorAll("#a1-buttons .answer-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      selectedSide = btn.getAttribute("data-value");
      goTo("a2");
    });
  });

  // Sti A: kanal (steg 2) → slå opp treff i match-tabellen, fyll resultatet
  const a2Screen = document.querySelector('[data-screen="a2"]');
  let matchTable = {};
  try {
    matchTable = JSON.parse(a2Screen?.getAttribute("data-match-table") ?? "{}");
  } catch {
    matchTable = {};
  }

  const resultTitle = document.getElementById("a-result-title");
  const resultLead = document.getElementById("a-result-lead");
  const resultTips = document.getElementById("a-result-tips");
  const resultCta = document.getElementById("a-result-cta");

  document.querySelectorAll("#a2-buttons .answer-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const canal = btn.getAttribute("data-value");
      const match = selectedSide ? matchTable[`${canal}-${selectedSide}`] : null;

      if (match) {
        if (resultTitle) resultTitle.textContent = match.title;
        if (resultLead) resultLead.textContent = match.lead;
        if (resultTips) {
          resultTips.innerHTML = "";
          match.tips.forEach((tip) => {
            const li = document.createElement("li");
            li.textContent = tip;
            resultTips.appendChild(li);
          });
        }
        if (resultCta) resultCta.setAttribute("href", match.href);
      } else {
        if (resultTitle) resultTitle.textContent = "Fant ikke en direkte match";
        if (resultLead) resultLead.textContent = "Se hele øvelsesbiblioteket for å finne riktig manøver.";
        if (resultTips) resultTips.innerHTML = "";
        if (resultCta) resultCta.setAttribute("href", "/ovelsesbibliotek/");
      }

      goTo("a-result");
    });
  });

  // Sti B: ja/nei avdekker svaret på samme skjerm (ingen navigasjon)
  document.querySelectorAll("#b1-buttons .answer-btn[data-reveal]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.getAttribute("data-reveal");
      document.querySelectorAll("#b1-buttons .answer-btn[data-reveal]").forEach((b) => {
        b.classList.toggle("selected", b === btn);
      });
      document.querySelectorAll("[data-reveal-panel]").forEach((panel) => {
        panel.hidden = panel.getAttribute("data-reveal-panel") !== key;
      });
    });
  });
</script>


---
import Layout from "../../layouts/Layout.astro";
import HelpCTA from "../../components/HelpCTA.astro";
import { safeFetch } from "../../lib/safeFetch";

// ===== Krystallsykehjelpen hjemme – stegvis pasientveileder =====
// Én tydelig start («Hva trenger du hjelp med?») med tre spor:
//   A  Jeg har fått påvist krystallsyke   (opptil 3 steg)
//   B  Jeg er fortsatt svimmel             (2 steg)
//   C  Jeg er usikker på hva jeg skal gjøre (2 steg)
//
// Faglige prinsipper (godkjent i mockup 2026-10-30):
// - Pasienten gjetter aldri side eller buegang. Alle spørsmål har «Jeg vet
//   ikke», og det leder ALDRI til en manøver, kun til råd om å spørre
//   behandler eller få en vurdering.
// - Manøver vises bare når pasienten kjenner manøveren (+ side), eller side
//   + buegang. Ved flere mulige manøvrer (bakre: Epley/Semont, horisontal:
//   Barbecue-rull/Gufoni) vises begge, og pasienten velger den behandleren
//   anbefalte. Ingen automatisk «vanligst»-valg.
// - Ingen rutinemessige stillingsrestriksjoner vises i veilederen.
// - Selve instruksjonene ligger i øvelsesbiblioteket (kilden til sannhet).
//
// Teksten i veilederen er skrevet her i koden. De gamle flow-feltene i
// Sanity (hjemmePage.flow*, restsvimmelhet*, rehab*) brukes ikke lenger,
// men er ikke slettet.
//
// Arkitektur: alle skjermer rendres statisk og skjules med [hidden]; kun én
// vises om gangen, styrt av scriptet nederst med en enkel historikk-stack.

const hp =
  (await safeFetch(
    `*[_id == "hjemmePage"][0]{
      hjelpEyebrow, hjelpHeading, hjelpText1, hjelpText2, hjelpButton1, hjelpButton2, attributionText
    }`,
    {},
    null,
  )) ?? {};

// --- Manøversider (reponering) fra Sanity, nøklet på slug ---
const reponeringRaw = await safeFetch(
  `*[_type == "exercise" && exerciseType == "reponering"]{
    title, "slug": slug.current, "categorySlug": category->slug.current
  }`,
  {},
  [],
);
const EX = {};
for (const ex of reponeringRaw) {
  EX[ex.slug] = {
    title: ex.title,
    href: ex.categorySlug ? `/ovelsesbibliotek/${ex.categorySlug}/${ex.slug}/?fra=hjemme` : "/ovelsesbibliotek/",
  };
}
const exOr = (slug, fallbackTitle) => EX[slug] ?? { title: fallbackTitle, href: "/ovelsesbibliotek/" };

// --- Øvelser og råd ved restsvimmelhet (habituering) ---
const habRaw = await safeFetch(
  `*[_type == "exercise" && exerciseType == "habituering" && slug.current in ["gradvis-eksponering", "balansetrening-staende", "blikkstabilisering"]]{
    title, "slug": slug.current, habitueringSeksjon, format
  }`,
  {},
  [],
);
const HAB_ORDER = ["gradvis-eksponering", "balansetrening-staende", "blikkstabilisering"];
const habExercises = HAB_ORDER.map((slug) => habRaw.find((ex) => ex.slug === slug))
  .filter(Boolean)
  .map((ex) => ({
    title: ex.title,
    kind: ex.format === "read" ? "Råd" : "Øvelse",
    href: `/ovelsesbibliotek/${ex.habitueringSeksjon}/${ex.slug}/?fra=hjemme`,
  }));

const SIDES = [
  { value: "venstre", label: "Venstre" },
  { value: "hoyre", label: "Høyre" },
];

// Manøvre der pasienten kjenner navnet (sidevalg følger etter, unntatt dyp hodehenging).
const MANEUVERS = [
  { value: "epley", label: "Epley", canalLabel: "Bakre buegang" },
  { value: "semont", label: "Semont", canalLabel: "Bakre buegang" },
  { value: "barbecue-rull", label: "Barbecue-rull (Lempert)", canalLabel: "Horisontal buegang" },
  { value: "gufoni", label: "Gufoni", canalLabel: "Horisontal buegang" },
];

// Ferdige resultatskjermer for «kjenner manøveren + side».
const maneuverResults = MANEUVERS.flatMap((m) =>
  SIDES.map((s) => ({
    id: `res-ex-${m.value}-${s.value}`,
    canalLabel: m.canalLabel,
    ex: exOr(`${m.value}-${s.value}`, `${m.label} – ${s.label.toLowerCase()}`),
  })),
);
const yacovino = exOr("yacovino", "Dyp hodehenging");

const ALARM = [
  "Plutselig, kraftig hodepine",
  "Lammelse, nummenhet eller svakhet i ansikt, arm eller bein",
  "Utydelig tale eller problemer med å finne ord",
  "Dobbeltsyn eller plutselig synstap",
  "Du klarer ikke å stå eller gå uten støtte",
];

const helpData = {
  eyebrow: hp.hjelpEyebrow ?? "Trenger du hjelp?",
  heading: hp.hjelpHeading ?? "Usikker på hva som er riktig neste steg?",
  text1:
    hp.hjelpText1 ??
    "Hvis du ikke vet hvilken buegang som er påvirket, hvilken manøver du skal gjøre, eller symptomene dine har endret seg, kan det være bedre med en ny vurdering enn å prøve flere øvelser på egen hånd.",
  text2: hp.hjelpText2 ?? "Videokonsultasjon kan brukes til spørsmål, usikkerhet og veiledning av øvelser og manøvrer.",
  button1: hp.hjelpButton1 ?? "Bestill videokonsultasjon",
  button2: hp.hjelpButton2 ?? "Se alle måter å få hjelp på",
};
const attributionText =
  hp.attributionText ?? "Krystallsykehjelpen er utviklet for å gjøre kunnskap om svimmelhet og krystallsyke lettere tilgjengelig.";

const VIDEO_URL = "/tjenester/videokonsultasjon/";
const HELP_URL = "/fa-hjelp/";
---

<Layout
  title="Krystallsykehjelpen hjemme | Veiledning etter krystallsyke"
  description="Gratis, trinnvis veiledning etter påvist krystallsyke: finn manøveren du har fått anbefalt, få råd ved restsvimmelhet og vit når du bør søke hjelp."
  activePath="/hjemme/"
>
  <section class="intro">
    <div class="container intro-inner">
      <span class="chip">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        Gratis veiledning · ingen registrering
      </span>
      <h1>Krystallsykehjelpen hjemme</h1>
      <p>Trinnvis hjelp etter at du har fått påvist krystallsyke, og når du fortsatt er svimmel.</p>
    </div>
  </section>

  <section class="app" id="steg1">
    <div class="container app-inner">
      <div class="panel" id="hjemme-flow">
        <div class="progress">
          <button type="button" class="back" data-back hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            Tilbake
          </button>
          <div class="steps" aria-live="polite" data-steps></div>
        </div>

        <noscript>
          <div class="screen">
            <h2>Veilederen krever JavaScript</h2>
            <p class="sub">Du finner alle manøvrer og øvelser i <a href="/ovelsesbibliotek/">øvelsesbiblioteket</a>, og hjelp på <a href={HELP_URL}>Få hjelp</a>.</p>
          </div>
        </noscript>

        <!-- ===== Start ===== -->
        <div class="screen" data-screen="start" data-step="0">
          <h2>Hva trenger du hjelp med?</h2>
          <p class="sub">Velg det som passer best. Vi tar det ett steg av gangen.</p>
          <div class="tracks">
            <button type="button" class="track" data-go="a1">
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></span>
              <span class="track-text"><b>Jeg har fått påvist krystallsyke</b><span>Finn og gjennomfør manøveren du har fått anbefalt.</span></span>
              <span class="arr" aria-hidden="true">›</span>
            </button>
            <button type="button" class="track" data-go="b1">
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0" /><path d="M2 17c2-3 4-3 6 0s4 3 6 0 4-3 6 0" opacity=".5" /></svg></span>
              <span class="track-text"><b>Jeg er fortsatt svimmel</b><span>Veiledning når svimmelheten ikke har gitt seg etter behandling.</span></span>
              <span class="arr" aria-hidden="true">›</span>
            </button>
            <button type="button" class="track" data-go="c1">
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><path d="M12 17h.01" /></svg></span>
              <span class="track-text"><b>Jeg er usikker på hva jeg skal gjøre</b><span>Finn ut om du bør få en undersøkelse eller behandling.</span></span>
              <span class="arr" aria-hidden="true">›</span>
            </button>
          </div>
        </div>

        <!-- ===== Spor A: påvist krystallsyke ===== -->
        <div class="screen" data-screen="a1" data-step="1" data-total="3" hidden>
          <h2>Hva fikk du beskjed om av behandleren?</h2>
          <p class="sub">Velg det du vet sikkert. Det er helt greit å ikke vite.</p>
          <div class="opts">
            <button type="button" class="opt" data-go="a-man">Navnet på manøveren<small>For eksempel Epley eller Barbecue-rull</small></button>
            <button type="button" class="opt" data-go="a-side">Hvilken side og buegang som er rammet</button>
            <button type="button" class="opt unsure" data-go="a-vetikke">Jeg vet ikke</button>
          </div>
        </div>

        <div class="screen" data-screen="a-man" data-step="2" data-total="3" hidden>
          <h2>Hvilken manøver fikk du anbefalt?</h2>
          <div class="opts">
            {MANEUVERS.map((m) => (
              <button type="button" class="opt" data-set={`m=${m.value}`} data-go="a-man-side">{m.label}</button>
            ))}
            <button type="button" class="opt" data-go="res-ovre">Dyp hodehenging</button>
            <button type="button" class="opt unsure" data-go="a-vetikke">Jeg husker ikke</button>
          </div>
        </div>

        <div class="screen" data-screen="a-man-side" data-step="3" data-total="3" hidden>
          <h2>Hvilken side skal manøveren gjøres mot?</h2>
          <p class="sub">Dette står vanligvis i det du fikk fra behandleren.</p>
          <div class="opts two">
            {SIDES.map((s) => (
              <button type="button" class="opt" data-set={`s=${s.value}`} data-go="res-ex-{m}-{s}">{s.label}</button>
            ))}
          </div>
          <div class="opts opts-gap">
            <button type="button" class="opt unsure" data-go="a-vetikke">Jeg vet ikke</button>
          </div>
        </div>

        <div class="screen" data-screen="a-side" data-step="2" data-total="3" hidden>
          <h2>Hvilken side er rammet?</h2>
          <div class="opts two">
            {SIDES.map((s) => (
              <button type="button" class="opt" data-set={`s=${s.value}`} data-go="a-kanal">{s.label}</button>
            ))}
          </div>
          <div class="opts opts-gap">
            <button type="button" class="opt unsure" data-go="a-vetikke">Jeg vet ikke</button>
          </div>
        </div>

        <div class="screen" data-screen="a-kanal" data-step="3" data-total="3" hidden>
          <h2>Hvilken buegang er rammet?</h2>
          <p class="sub">Velg bare hvis du har fått det bekreftet.</p>
          <div class="opts">
            <button type="button" class="opt" data-go="res-bakre-{s}">Bakre buegang</button>
            <button type="button" class="opt" data-go="res-horisontal-{s}">Horisontal buegang</button>
            <button type="button" class="opt" data-go="res-ovre">Øvre buegang</button>
            <button type="button" class="opt unsure" data-go="a-vetikke">Jeg vet ikke</button>
          </div>
        </div>

        <!-- Resultat: kjent manøver + side -->
        {maneuverResults.map((r) => (
          <div class="screen" data-screen={r.id} data-step="done" hidden>
            <span class="res-kicker">Din veiledning</span>
            <h2>{r.ex.title}</h2>
            <p class="res-p">Følg veiledningen steg for steg, og gjør manøveren slik behandleren din viste deg.</p>
            <div class="ex-list">
              <a class="ex" href={r.ex.href}><span>{r.ex.title}<small>{r.canalLabel} · veiledning med film</small></span><span aria-hidden="true">→</span></a>
            </div>
            <ul class="tips">
              <li>Gjenta manøveren så mange ganger som du fikk anbefalt.</li>
              <li>Lett svimmelhet rett etter øvelsen er normalt og går som regel raskt over.</li>
              <li>Ta kontakt hvis det ikke blir bedre etter noen dager, eller hvis svimmelheten endrer seg.</li>
            </ul>
            <div class="note"><b>Stopp og ta kontakt</b>ved sterke smerter, synsforstyrrelser eller andre uvante symptomer.</div>
            <div class="btns"><button type="button" class="btn-link" data-go="start">Start på nytt</button></div>
            <div class="pro">
              <span class="pro-head">Individuell vurdering</span>
              <p>Veiledningen her er gratis. Trenger du at noen ser på akkurat din situasjon, kan du bestille en konsultasjon.</p>
              <div class="btns"><a class="btn btn-ghost" href={VIDEO_URL}>Videokonsultasjon</a><a class="btn-link" href={HELP_URL}>Time på klinikken</a></div>
            </div>
          </div>
        ))}

        <!-- Resultat: bakre buegang + side -->
        {SIDES.map((s) => (
          <div class="screen" data-screen={`res-bakre-${s.value}`} data-step="done" hidden>
            <span class="res-kicker">Bakre buegang · {s.label.toLowerCase()} side</span>
            <h2>Gjør manøveren du fikk anbefalt</h2>
            <p class="res-p">Bakre buegang behandles med Epley- eller Semont-manøveren. Velg den behandleren din anbefalte.</p>
            <div class="ex-list">
              {[exOr(`epley-${s.value}`, `Epley-manøver – ${s.label.toLowerCase()}`), exOr(`semont-${s.value}`, `Semont-manøver – ${s.label.toLowerCase()}`)].map((ex) => (
                <a class="ex" href={ex.href}><span>{ex.title}<small>Bakre buegang · veiledning med film</small></span><span aria-hidden="true">→</span></a>
              ))}
            </div>
            <ul class="tips">
              <li>Fikk du ikke beskjed om hvilken? Epley er den mest brukte for bakre buegang.</li>
              <li>Lett svimmelhet rett etter øvelsen er normalt og går som regel raskt over.</li>
            </ul>
            <div class="note"><b>Stopp og ta kontakt</b>ved sterke smerter, synsforstyrrelser eller andre uvante symptomer.</div>
            <div class="btns"><button type="button" class="btn-link" data-go="start">Start på nytt</button></div>
            <div class="pro">
              <span class="pro-head">Individuell vurdering</span>
              <p>Veiledningen her er gratis. Trenger du at noen ser på akkurat din situasjon, kan du bestille en konsultasjon.</p>
              <div class="btns"><a class="btn btn-ghost" href={VIDEO_URL}>Videokonsultasjon</a><a class="btn-link" href={HELP_URL}>Time på klinikken</a></div>
            </div>
          </div>
        ))}

        <!-- Resultat: horisontal buegang + side -->
        {SIDES.map((s) => (
          <div class="screen" data-screen={`res-horisontal-${s.value}`} data-step="done" hidden>
            <span class="res-kicker">Horisontal buegang · {s.label.toLowerCase()} side</span>
            <h2>Velg manøveren behandleren anbefalte</h2>
            <p class="res-p">Krystallsyke i horisontal buegang finnes i to varianter, som behandles med ulike manøvrer. Hvilken du skal gjøre, avhenger av funnene i undersøkelsen.</p>
            <div class="ex-list">
              {[exOr(`barbecue-rull-${s.value}`, `Barbecue-rull – ${s.label.toLowerCase()}`), exOr(`gufoni-${s.value}`, `Gufoni-manøver – ${s.label.toLowerCase()}`)].map((ex) => (
                <a class="ex" href={ex.href}><span>{ex.title}<small>Horisontal buegang · veiledning med film</small></span><span aria-hidden="true">→</span></a>
              ))}
            </div>
            <div class="note"><b>Husker du ikke hvilken?</b>Da bør du ikke velge selv. Spør behandleren din, eller få en ny vurdering.</div>
            <div class="btns"><button type="button" class="btn-link" data-go="start">Start på nytt</button></div>
            <div class="pro">
              <span class="pro-head">Individuell vurdering</span>
              <p>Veiledningen her er gratis. Trenger du at noen ser på akkurat din situasjon, kan du bestille en konsultasjon.</p>
              <div class="btns"><a class="btn btn-ghost" href={VIDEO_URL}>Videokonsultasjon</a><a class="btn-link" href={HELP_URL}>Time på klinikken</a></div>
            </div>
          </div>
        ))}

        <!-- Resultat: øvre buegang / dyp hodehenging -->
        <div class="screen" data-screen="res-ovre" data-step="done" hidden>
          <span class="res-kicker">Øvre buegang</span>
          <h2>Dyp hodehenging</h2>
          <p class="res-p">Øvre buegang behandles med dyp hodehenging. Manøveren gjøres ofte hos behandler første gang. Ta gjerne kontakt før du prøver den hjemme.</p>
          <div class="ex-list">
            <a class="ex" href={yacovino.href}><span>{yacovino.title}<small>Øvre buegang · veiledning med film</small></span><span aria-hidden="true">→</span></a>
          </div>
          <div class="note"><b>Stopp og ta kontakt</b>ved sterke smerter, synsforstyrrelser eller andre uvante symptomer.</div>
          <div class="btns"><button type="button" class="btn-link" data-go="start">Start på nytt</button></div>
          <div class="pro">
            <span class="pro-head">Individuell vurdering</span>
            <p>Veiledningen her er gratis. Trenger du at noen ser på akkurat din situasjon, kan du bestille en konsultasjon.</p>
            <div class="btns"><a class="btn btn-ghost" href={VIDEO_URL}>Videokonsultasjon</a><a class="btn-link" href={HELP_URL}>Time på klinikken</a></div>
          </div>
        </div>

        <!-- Resultat: vet ikke -->
        <div class="screen" data-screen="a-vetikke" data-step="done" hidden>
          <span class="res-kicker">Det er helt greit</span>
          <h2>Da bør du ikke velge manøver på egen hånd</h2>
          <p class="res-p">Riktig manøver avhenger av hvilken side og buegang som er rammet. Det avgjøres med posisjonstester, ikke ut fra symptomene alene. En manøver for feil side eller buegang hjelper ikke.</p>
          <ul class="tips">
            <li>Spør behandleren som undersøkte deg om side, buegang og manøver.</li>
            <li>Eller få en ny vurdering, så finner vi ut av det sammen.</li>
          </ul>
          <div class="btns"><a class="btn btn-primary" href={VIDEO_URL}>Bestill videokonsultasjon</a><a class="btn btn-ghost" href={HELP_URL}>Andre måter å få hjelp på</a></div>
          <div class="btns btns-gap"><button type="button" class="btn-link" data-go="start">Start på nytt</button></div>
        </div>

        <!-- ===== Spor B: fortsatt svimmel ===== -->
        <div class="screen" data-screen="b1" data-step="1" data-total="2" hidden>
          <h2>Hvordan kjennes svimmelheten nå?</h2>
          <p class="sub">Velg det som ligner mest.</p>
          <div class="opts">
            <button type="button" class="opt" data-go="b-diffus">Ustø, gyngende eller «rar i hodet»<small>Mer en vedvarende følelse enn anfall</small></button>
            <button type="button" class="opt" data-go="b-anfall">Korte anfall av snurring<small>Når jeg legger meg, snur meg i sengen, ser opp eller bøyer meg</small></button>
            <button type="button" class="opt" data-go="b-annet">Annerledes enn før<small>Varer lenge, kommer uten bevegelse, eller med nye symptomer</small></button>
            <button type="button" class="opt unsure" data-go="b-annet">Jeg vet ikke</button>
          </div>
        </div>

        <div class="screen" data-screen="b-diffus" data-step="done" hidden>
          <span class="res-kicker">Restsvimmelhet</span>
          <h2>Ustøhet etter behandling er vanlig</h2>
          <p class="res-p">Mange kjenner seg ustø eller «rar i hodet» i dager eller uker etter at krystallsyken er behandlet. Det betyr ikke nødvendigvis at behandlingen har mislyktes. Balansesystemet trenger ofte litt tid på å venne seg til bevegelse igjen.</p>
          <ul class="tips">
            <li>Hold deg i vanlig aktivitet så godt du kan. Det hjelper balansen å tilpasse seg.</li>
            <li>Utsett deg gradvis for bevegelser og steder som er ubehagelige, i et tempo du tåler.</li>
            <li>Start forsiktig med øvelsene under, og øk litt etter litt.</li>
          </ul>
          {habExercises.length > 0 && (
            <div class="ex-list">
              {habExercises.map((ex) => (
                <a class="ex" href={ex.href}><span>{ex.title}<small>{ex.kind}</small></span><span aria-hidden="true">→</span></a>
              ))}
            </div>
          )}
          <div class="note"><b>Få en ny vurdering</b>hvis det ikke blir bedre i løpet av noen uker, eller hvis det blir verre.</div>
          <div class="btns"><a class="btn-link" href="/blogg/restsvimmelhet-etter-krystallsyke/">Les mer om restsvimmelhet</a><button type="button" class="btn-link" data-go="start">Start på nytt</button></div>
          <div class="pro">
            <span class="pro-head">Individuell vurdering</span>
            <p>Veiledningen her er gratis. Trenger du at noen ser på akkurat din situasjon, kan du bestille en konsultasjon.</p>
            <div class="btns"><a class="btn btn-ghost" href={VIDEO_URL}>Videokonsultasjon</a><a class="btn-link" href={HELP_URL}>Time på klinikken</a></div>
          </div>
        </div>

        <div class="screen" data-screen="b-anfall" data-step="done" hidden>
          <span class="res-kicker">Korte anfall</span>
          <h2>Krystallsyken kan fortsatt være aktiv</h2>
          <p class="res-p">Korte anfall av snurring når du endrer stilling er typisk for krystallsyke. Det kan bety at krystallene ikke har kommet helt på plass, eller at krystallsyken har kommet tilbake, også i en annen buegang.</p>

<script>
  // Ren klient-side skjermnavigasjon. Ingen data lagres eller sendes.
  // «data-go» kan inneholde {m} og {s}, som fylles med valgene pasienten
  // har gjort (manøver og side) via «data-set».
  const panel = document.getElementById("hjemme-flow");
  if (panel) {
    const screens = Array.from(panel.querySelectorAll<HTMLElement>("[data-screen]"));
    const backBtn = panel.querySelector<HTMLButtonElement>("[data-back]");
    const stepsEl = panel.querySelector<HTMLElement>("[data-steps]");
    const state: Record<string, string> = {};
    const history: string[] = ["start"];

    function render(focus: boolean) {
      const current = history[history.length - 1];
      let active: HTMLElement | undefined;
      screens.forEach((el) => {
        const on = el.dataset.screen === current;
        el.hidden = !on;
        if (on) active = el;
      });
      if (!active) return;
      if (backBtn) backBtn.hidden = history.length < 2;
      if (stepsEl) {
        const step = active.dataset.step;
        const total = Number(active.dataset.total || 0);
        if (step === "done") {
          stepsEl.innerHTML = "<span>Ferdig</span>";
        } else if (step && Number(step) > 0 && total) {
          const n = Number(step);
          const bars = Array.from({ length: total }, (_, i) => `<span class="${i < n ? "on" : ""}"></span>`).join("");
          stepsEl.innerHTML = `<span>Steg ${n} av ${total}</span><span class="bar" aria-hidden="true">${bars}</span>`;
        } else {
          stepsEl.innerHTML = "";
        }
      }
      if (focus) {
        const heading = active.querySelector<HTMLElement>("h2");
        if (heading) {
          heading.setAttribute("tabindex", "-1");
          heading.focus({ preventScroll: true });
        }
        const top = panel!.getBoundingClientRect().top;
        if (top < 0 || top > window.innerHeight * 0.4) {
          panel!.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    }

    panel.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>("[data-go]");
      if (!target) return;
      if (target.dataset.set) {
        const [k, v] = target.dataset.set.split("=");
        state[k] = v;
      }
      const go = (target.dataset.go || "").replace(/\{(\w)\}/g, (_, k) => state[k] ?? "");
      if (go === "start") {
        history.length = 0;
        history.push("start");
        for (const k of Object.keys(state)) delete state[k];
      } else if (screens.some((el) => el.dataset.screen === go)) {
        history.push(go);
      } else {
        return;
      }
      render(true);
    });

    backBtn?.addEventListener("click", () => {
      if (history.length > 1) history.pop();
      render(true);
    });

    const toggle = panel.querySelector<HTMLButtonElement>(".alarm-toggle");
    const body = document.getElementById("alarm-body");
    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      if (body) body.hidden = open;
    });

    render(false);
  }
</script>


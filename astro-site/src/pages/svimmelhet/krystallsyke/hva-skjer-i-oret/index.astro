    var omega=0;
    st.eyeDt=dt;
    if(st.tw){var k=st.tw.dur?Math.min(1,(now-st.tw.t0)/st.tw.dur):1,ee=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2;
      var prev=st.theta;st.theta=st.tw.from+(st.tw.to-st.tw.from)*ee;omega=(st.theta-prev)/dt;
      if(st.mode==='n')upTo(1);if(st.mode==='dh'&&st.loose&&!st.home)upTo(1);
      if(k>=1){st.tw=null;st.release=now+(reduce?0:LAT);st.quiet=0}}
    // cupula i et friskt øre: bøyes kort mens hodet roterer, retter seg opp når hodet står stille
    var target=reduce?0:Math.max(-1,Math.min(1,omega/170));
    st.bRot+=(target-st.bRot)*Math.min(1,dt/(st.tw?.12:.45));
    if(st.mode==='n'&&Math.abs(st.bRot)>.15)upTo(3);
    // kupulolitiasis: tung cupula bøyes av tyngdekraften så lenge stillingen holdes
    st.bCup=st.ear==='cupu'?.85*Math.max(0,Math.min(1,st.theta/120)):0;
    if(st.mode==='c'){if(st.tw)upTo(1);if(st.tw&&st.bCup>.05)upTo(2);if(st.bCup>.15)upTo(3)}

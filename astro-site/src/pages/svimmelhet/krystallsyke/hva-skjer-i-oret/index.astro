    $('stTitle').textContent={dh:st.home?'Krystallene er hjemme':'Hva skjer når du legger deg ned',ep:'Epleys manøver for '+(st.side>0?'høyre':'venstre')+' bakre buegang',n:'Et friskt øre',o:'Slik oppstår krystallsyke',c:'Krystaller fast på cupula'}[m]}

      if(now>=st.release){upTo(2);st.s-=(reduce?999:70)*dt;if(st.s<=L_ARC-6){st.s=L_ARC-6;st.entering=false;st.v=0;upTo(3)}}
    }else if(!st.tw&&now>=st.release){
      if(reduce&&st.loose&&!st.home){for(var n=0;n<2000;n++)stepPhysics(.01);st.v=0}else stepPhysics(dt);
      if(st.mode==='dh'&&rolling())upTo(3);
    }
    var roll=draw();
    var settled=!st.tw&&!st.entering&&now>=st.release&&!roll&&Math.abs(st.bRot)<.05&&(!st.loose||st.home||Math.abs(st.v)<3);
    if(settled){st.quiet+=dt}else st.quiet=0;
    if(settled&&st.quiet>.35){
      if((st.mode==='dh'&&st.started&&st.loose&&!st.home)||st.mode==='n'||(st.mode==='c'&&st.bCup>.15))upTo(4);
      if(st.queue.length){var nx=st.queue.shift();setTimeout(nx,reduce?0:700);return}
      st.busy=false;if(!(st.bCup>.15&&!reduce))return;
    }
    raf=requestAnimationFrame(loop);
  }
  function start(mode,btn){if(st.busy)return false;st.busy=true;st.started=true;press(btn);if(st.mode!==mode||mode!=='ep')setMode(mode);return true}

  $('bSit').addEventListener('click',function(){if(start(earMode(),'bSit'))rotate(0,'Sitter')});
  $('bLie').addEventListener('click',function(){if(start(earMode(),'bLie'))rotate(120,'Ligger, hodet bakover')});
  $('bEpley').addEventListener('click',function(){
    if(!start('ep','bEpley'))return;
    var A=st.side>0?'høyre':'venstre',B=st.side>0?'venstre':'høyre';

})();
// ---- Sammenligning: fritt flytende krystaller (kanalolitiasis) og krystaller på cupula (kupulolitiasis) ----
(function(){
  var SNS='http://www.w3.org/2000/svg',$=function(id){return document.getElementById(id)};
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  function mk(tag,a,p){var n=document.createElementNS(SNS,tag);for(var k in a)n.setAttribute(k,a[k]);p.appendChild(n);return n}
  var T=7,AX=58,GX0=16,GX1=254,GY=196,GA=30;
  function E(x){x=Math.max(0,Math.min(1,x));return x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2}
  function build(g,title){
    mk('text',{x:135,y:16,'text-anchor':'middle',class:'svgl'},g).textContent=title;
    mk('path',{d:'M6 42 H34 Q'+AX+' 22 84 42 H262 V96 H84 Q'+AX+' 116 34 96 H6 Z',fill:'var(--sky)',stroke:'var(--navy2)','stroke-width':2},g);
    mk('path',{d:'M38 100 Q'+AX+' 80 78 100 Z',fill:'var(--navy2)'},g);
    var cup=mk('path',{fill:'var(--turkis)','fill-opacity':.45,stroke:'var(--navy2)','stroke-width':1.5},g);
    mk('text',{x:AX,y:112,'text-anchor':'middle',class:'svgs',style:'font-size:10px'},g).textContent='Cupula';
    mk('text',{x:8,y:36,class:'svgs',style:'font-size:10px'},g).textContent='← Utriculus';
    mk('text',{x:260,y:36,'text-anchor':'end',class:'svgs',style:'font-size:10px'},g).textContent='Buegangen →';
    // graf
    mk('line',{x1:GX0,y1:GY,x2:GX1,y2:GY,stroke:'var(--line)','stroke-width':1.5},g);
    mk('line',{x1:GX0,y1:GY-GA-4,x2:GX0,y2:GY+GA+4,stroke:'var(--line)','stroke-width':1.5},g);
    mk('text',{x:GX0+4,y:GY-GA-8,class:'svgs',style:'font-size:10px'},g).textContent='Svimmelhet';
    mk('text',{x:GX1,y:GY+GA+16,'text-anchor':'end',class:'svgs',style:'font-size:10px'},g).textContent='Tid (ca. 1 min) →';
    var line=mk('polyline',{fill:'none',stroke:'var(--accent)','stroke-width':2.5,'stroke-linejoin':'round'},g);
    var note=mk('text',{x:GX0+8,y:GY+GA+16,class:'svgs',style:'font-size:10px;font-weight:500'},g);
    var cr=mk('g',{},g);
    var dots=[0,1,2,3].map(function(i){return mk('circle',{r:3.6,fill:'#fff',stroke:'var(--navy2)','stroke-width':1.6},cr)});
    return {cup:cup,line:line,dots:dots,note:note};
  }
  function cupD(b){var x=AX+b*28;return 'M'+(AX-12)+' 98 Q'+(AX-12+b*10)+' 70 '+(x-10)+' 46 L'+(x+10)+' 46 Q'+(AX+12+b*10)+' 70 '+(AX+12)+' 98 Z'}
  var L=build($('cvL'),'Fritt i buegangen (kanalolitiasis)');
  var Rr=build($('cvR'),'Fast på cupula (kupulolitiasis)');
  var dir='sit',t0=0,raf=0,init=true;
  // posisjon og bøyning som funksjon av tid
  function canalX(t){return dir==='lie'?96+142*E((t-1.4)/3.4):238-142*E((t-1.0)/3.4)}
  function canalB(t){return (canalX(t+.02)-canalX(t-.02))/.04/84*.85}
  function cupB(t){var k=E(t/.6);return dir==='lie'?.85*k:.85*(1-k)}
  function frame(now){
    var t=reduce?T:Math.min(T,(now-t0)/1000);
    var ang=dir==='lie'?-90*E(t/.6):-90+90*E(t/.6);
    $('cvArrow').setAttribute('transform','rotate('+ang.toFixed(1)+')');
    var bl=canalB(t),br=cupB(t),x=canalX(t);
    L.cup.setAttribute('d',cupD(bl));Rr.cup.setAttribute('d',cupD(br));
    L.dots.forEach(function(d,i){d.setAttribute('cx',(x+i*7.5).toFixed(1));d.setAttribute('cy',i%2?88:91)});
    var tx=AX+br*28;Rr.dots.forEach(function(d,i){d.setAttribute('cx',(tx+8+i*1.5-(i>1?br*4:0)).toFixed(1));d.setAttribute('cy',52+i*9)});
    // kurver
    var pl=[],pr=[];for(var s=0;s<=t+1e-6;s+=.05){var gx=(GX0+s/T*(GX1-GX0)).toFixed(1);pl.push(gx+','+(GY-canalB(s)*GA).toFixed(1));pr.push(gx+','+(GY-cupB(s)*GA).toFixed(1))}
    L.line.setAttribute('points',init?'':pl.join(' '));Rr.line.setAttribute('points',init?'':pr.join(' '));
    if(dir==='lie'){L.note.textContent=t>1.3?'Starter etter noen sekunder, går over':'Ingen svimmelhet ennå …';Rr.note.textContent='Starter med en gang, varer mens du ligger'}
    else{L.note.textContent=t>0.1?'Kort svimmelhet motsatt vei':'';Rr.note.textContent='Gir seg når du setter deg opp'}
    if(t<T)raf=requestAnimationFrame(frame);else raf=0;
  }
  function go(d){if(d===dir)return;dir=d;init=false;$('cvLie').setAttribute('aria-pressed',d==='lie');$('cvSit').setAttribute('aria-pressed',d==='sit');
    t0=performance.now();cancelAnimationFrame(raf);raf=requestAnimationFrame(frame)}
  $('cvLie').addEventListener('click',function(){go('lie')});
  $('cvSit').addEventListener('click',function(){go('sit')});
  // hvilestilling: sitter, krystallene ligger ved cupula
  t0=performance.now()-T*1000;frame(performance.now());L.note.textContent='';Rr.note.textContent='';
})();

</script>


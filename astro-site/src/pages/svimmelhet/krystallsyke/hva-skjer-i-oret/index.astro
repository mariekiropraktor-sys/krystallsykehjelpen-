    function run(i){upTo(i+1);rotate(seq[i][0],seq[i][1]);
      st.queue=i<seq.length-1?[function(){run(i+1)}]:[function(){st.theta=0;st.busy=false;draw();$('stTitle').textContent='Krystallene er ført tilbake til utriculus'}]}
    if(Math.abs(st.theta)>1){rotate(0,'Sitter');st.queue=[function(){run(0)}]}else run(0);
  });
  $('bOrigin').addEventListener('click',function(){
    if(!start('o','bOrigin'))return;
    function detach(){st.loose=true;st.home=false;st.entering=true;st.s=TOTAL;st.v=0;upTo(1);st.release=performance.now()+(reduce?0:1200);

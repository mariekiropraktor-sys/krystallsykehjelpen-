---
import Layout from "../../../../layouts/Layout.astro";

// Underside i krystallsyke-klyngen (se Krystallsyke-temaklynge-plan.md i
// prosjektet). Innholdet om hva som skjer i øret og hvorfor krystallene løsner
// er flyttet hit fra /svimmelhet/krystallsyke/, som nå har et kort sammendrag
// med lenke hit. Den interaktive modellen er ren SVG + JavaScript uten
// biblioteker, og stilene er samlet under .hso-klassen så de ikke lekker ut.

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Hjem",
      "item": "https://www.krystallsykehjelpen.no/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Svimmelhet",
      "item": "https://www.krystallsykehjelpen.no/svimmelhet/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Krystallsyke",
      "item": "https://www.krystallsykehjelpen.no/svimmelhet/krystallsyke/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "Hva skjer i øret",
      "item": "https://www.krystallsykehjelpen.no/svimmelhet/krystallsyke/hva-skjer-i-oret/"
    }
  ]
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Er krystallsyke farlig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nei. Krystallsyke er ubehagelig, men ikke farlig. Ingenting i øret er ødelagt, krystallene er bare på feil sted. Plutselig svimmelhet sammen med lammelser, talevansker eller dobbeltsyn er noe annet, og da skal du ringe 113."
      }
    },
    {
      "@type": "Question",
      "name": "Hvorfor varer svimmelheten bare kort tid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Svimmelheten varer så lenge krystallene ruller. Når de har lagt seg i bunnen av buegangen, stopper væsken, og signalet til hjernen roer seg. Derfor går anfallet over, selv om du blir liggende."
      }
    },
    {
      "@type": "Question",
      "name": "Kan krystallene løse seg opp av seg selv?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Det antas at løsnede krystaller kan løses opp eller tas opp igjen over tid, og krystallsyke går ofte over av seg selv. Riktig manøver gir likevel som regel raskere bedring."
      }
    },
    {
      "@type": "Question",
      "name": "Kan man se krystallene på MR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nei, krystallene er for små. Diagnosen stilles ut fra posisjonstester og øyebevegelser."
      }
    }
  ]
};

const pageLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Hva skjer i øret ved krystallsyke?",
  "url": "https://www.krystallsykehjelpen.no/svimmelhet/krystallsyke/hva-skjer-i-oret/",
  "inLanguage": "nb-NO",
  "about": {
    "@type": "MedicalCondition",
    "name": "Benign paroksysmal posisjonsvertigo (krystallsyke)",
    "alternateName": [
      "BPPV",
      "Krystallsyke"
    ]
  },
  "author": {
    "@type": "Person",
    "name": "Marie Hermansen",
    "jobTitle": "Kiropraktor"
  }
};
---

<Layout
  title="Hva skjer i øret ved krystallsyke? Se krystallene bevege seg | Krystallsykehjelpen"
  description="Se med en interaktiv modell hvordan krystaller i bakre buegang gir svimmelhet og nystagmus, forskjellen på kanalolitiasis og kupulolitiasis, og hvorfor Epleys manøver virker."
  activePath="/svimmelhet/krystallsyke/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />

  <div class="hso">

<section class="hero">
  <div class="c">
    <nav class="crumbs"><a href="/">Forside</a> / <a href="/svimmelhet/">Svimmelhet</a> / <a href="/svimmelhet/krystallsyke/">Krystallsyke</a> / Hva skjer i øret</nav>
    <span class="eyebrow">Krystallsyke · Forklart</span>
    <h1>Hva skjer i øret ved krystallsyke?</h1>
    <p class="lead">Svimmelheten kommer av små krystaller som har havnet på feil sted i balanseorganet. Når du ser hvordan de beveger seg, blir det lettere å forstå hvorfor svimmelheten kommer når du legger deg ned, hvorfor den går over etter kort tid, og hvorfor riktig manøver hjelper.</p>
    <div class="actions"><a class="btn" href="#modell">Se modellen ↓</a><a class="tlink" href="#hvorfor">Hvorfor løsner krystallene?</a></div>
  </div>
</section>

<!-- MODELL -->
<section class="sky" id="modell">
  <div class="c">
    <span class="eyebrow">Interaktiv modell</span>
    <h2>Se krystallene bevege seg</h2>
    <p class="narrow">Modellen viser bakre buegang i <span class="lr" data-r="høyre" data-l="venstre">høyre</span> øre, der krystallsyke oftest sitter. Sammenlign et friskt øre med krystallsyke, se hvordan krystallene havner i buegangen, og kjør Epleys manøver for å føre dem hjem igjen.</p>

    <div class="toolbar">
      <div class="tgroup"><span class="tlabel">Øre</span>
        <div class="seg" role="group" aria-label="Velg øre">
          <button type="button" id="bNormal" aria-pressed="false">Friskt øre</button>
          <button type="button" id="bBppv" aria-pressed="true">Krystallsyke</button>
          <button type="button" id="bCupu" aria-pressed="false">Kupulolitiasis</button>
        </div></div>
      <div class="tgroup"><span class="tlabel">Side</span>
        <div class="seg" role="group" aria-label="Velg side">
          <button type="button" id="bRight" aria-pressed="true">Høyre øre</button>
          <button type="button" id="bLeft" aria-pressed="false">Venstre øre</button>
        </div></div>
    </div>
    <div class="model">
      <div class="stage">
        <svg id="scene" viewBox="0 0 560 470" role="img" aria-label="Modell av bakre buegang med ampulle, cupula og utriculus">
          <!-- hodeindikator (nesa peker fremover, mot utriculus) -->
          <g id="head" transform="translate(500 56) rotate(0)">
            <circle r="26" fill="var(--sky)" stroke="var(--navy)" stroke-width="2.5"/>
            <path d="M-25 -5 l-10 5 l10 5" fill="var(--sky)" stroke="var(--navy)" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="-12" cy="-8" r="2.8" fill="var(--navy)"/>
            <path d="M8 -4 q6 4 0 10" fill="none" stroke="var(--navy)" stroke-width="2"/>
          </g>
          <text x="500" y="106" text-anchor="middle" class="svgl" id="headLab">Sitter</text>
          <!-- øyet: nystagmus styres av krystallenes bevegelse -->
          <defs><clipPath id="lid"><path d="M-42 0 Q0 -27 42 0 Q0 27 -42 0 Z"/></clipPath></defs>
          <g id="eye" transform="translate(500 180) scale(1.2)">
            <path d="M-42 0 Q0 -27 42 0 Q0 27 -42 0 Z" fill="var(--white)" stroke="var(--navy)" stroke-width="2.5"/>
            <g clip-path="url(#lid)"><g id="iris2"><circle r="14" fill="var(--accent)"/><g id="spokes" stroke="var(--sky)" stroke-width="1.1" stroke-opacity=".75"></g><circle r="5.5" fill="var(--navy)"/><path d="M0 -14 V-6" stroke="var(--white)" stroke-width="3" stroke-linecap="round"/><circle cy="-10.5" r="2.4" fill="var(--white)"/></g></g>
            <g id="fastArrow" opacity="0"><path d="M0 -24 V-40 M-5 -34 L0 -41 L5 -34" fill="none" stroke="var(--turkis)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
            <g id="rotArrow" opacity="0"><path d="M30 -16 A34 34 0 0 0 -30 -16 M-30 -16 l1 -9 M-30 -16 l8 -3" fill="none" stroke="var(--navy2)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></g>
          </g>
          <text x="500" y="226" text-anchor="middle" class="svgl">Øyet</text>
          <text x="500" y="242" text-anchor="middle" class="svgs" style="font-size:10.5px;font-weight:500" id="eyeLab">Rolig</text>
          <text x="500" y="256" text-anchor="middle" class="svgs" style="font-size:10.5px;font-weight:500" id="eyeLab2"></text>

          <g class="svgm">
            <path d="M28 404 v40" stroke="var(--muted)" stroke-width="2"/>
            <path d="M22 438 l6 9 l6 -9" fill="none" stroke="var(--muted)" stroke-width="2"/>
            <text x="40" y="432">Tyngdekraft</text>
          </g>

          <g id="canal" transform="translate(240 240) rotate(0)">
            <!-- felles skank, opp mot øvre buegang -->
            <path d="M-90.1 -63.1 L-80 -158" fill="none" stroke="var(--navy)" stroke-width="30" stroke-linecap="round" opacity=".22"/>
            <path d="M-90.1 -63.1 L-80 -158" fill="none" stroke="var(--ivory)" stroke-width="25" stroke-linecap="round" opacity=".55"/>
            <!-- beinkanal med perilymfe -->
            <path class="arc" d="M-90.1 63.1 A110 110 0 1 0 -90.1 -63.1" stroke="var(--navy)" stroke-width="32"/>
            <path class="arc" d="M-90.1 63.1 A110 110 0 1 0 -90.1 -63.1" stroke="var(--ivory)" stroke-width="27"/>
            <!-- hinnegang med endolymfe -->
            <path class="arc" d="M-90.1 63.1 A110 110 0 1 0 -90.1 -63.1 L-106 -40 M-90.1 63.1 L-106 40" stroke="var(--navy2)" stroke-width="14"/>
            <path class="arc" d="M-90.1 63.1 A110 110 0 1 0 -90.1 -63.1 L-106 -40 M-90.1 63.1 L-106 40" stroke="var(--sky)" stroke-width="10"/>
            <g class="flow"><path class="arc" d="M-90.1 63.1 A110 110 0 1 0 -90.1 -63.1" stroke="var(--turkis)" stroke-width="3"/></g>
            <!-- utriculus med macula og otokonier -->
            <ellipse cx="-124" cy="0" rx="36" ry="54" fill="var(--ivory)" stroke="var(--navy)" stroke-width="3"/>
            <ellipse cx="-124" cy="0" rx="28" ry="46" fill="var(--sky)" stroke="var(--navy2)" stroke-width="2"/>
            <path d="M-148 16 Q-130 50 -103 34" fill="none" stroke="var(--navy2)" stroke-width="7" stroke-linecap="round"/>
            <g id="oto"></g>
            <!-- ampulle med crista og cupula, ved ampulleenden av buegangen -->
            <g transform="rotate(125) translate(110 0)">
              <ellipse rx="24" ry="27" fill="var(--ivory)" stroke="var(--navy)" stroke-width="3"/>
              <ellipse rx="16" ry="20" fill="var(--sky)" stroke="var(--navy2)" stroke-width="2"/>
              <path d="M17 -9 Q5 0 17 9 Z" fill="var(--navy2)"/>
              <path id="cupula" fill="var(--turkis)" fill-opacity=".55" stroke="var(--navy2)" stroke-width="1.5"/>
            </g>
            <path id="track" d="M-90.1 63.1 A110 110 0 1 0 -90.1 -63.1 L-106 -40 Q-140 -4 -126 30" fill="none"/>
            <g id="crys"></g>
          </g>
          <g id="labels" class="svgl"></g>
        </svg>
        <div class="controls" role="group" aria-label="Velg stilling">
          <button class="chip" id="bSit" aria-pressed="true" type="button">Sitter</button>
          <button class="chip" id="bLie" aria-pressed="false" type="button">Legg deg ned</button>
          <button class="chip" id="bEpley" aria-pressed="false" type="button">Kjør Epleys manøver</button>
          <button class="chip" id="bOrigin" aria-pressed="false" type="button" hidden>Se hvordan krystallsyke oppstår</button>
          <button class="chip quiet" id="bReset" type="button">Start på nytt</button>
        </div>
        <p class="caption">Forenklet modell av <span class="lr" data-r="høyre" data-l="venstre">høyre</span> øre sett fra siden, ikke i riktig målestokk. Stillingene i Epleys manøver er tilnærmet, og animasjonen går raskere enn i virkeligheten.</p>
      </div>
      <div class="side">
        <div class="panel" aria-live="polite">
          <h3 id="stTitle">Hva skjer når du legger deg ned</h3>
          <ol class="steps" id="stepsDH">
            <li data-s="1"><span class="dot"></span><span><b>Hodet endrer stilling.</b> Buegangen snus med hodet.</span></li>
            <li data-s="2"><span class="dot"></span><span><b>Krystallene ruller</b> etter et par sekunder, bort fra ampullen og mot det nye laveste punktet.</span></li>
            <li data-s="3"><span class="dot"></span><span><b>Væsken dras med og bøyer cupula.</b> Sansecellene sender beskjed om at hodet snurrer. Du blir svimmel, og øynene rykker.</span></li>
            <li data-s="4"><span class="dot"></span><span><b>Krystallene ligger stille.</b> Cupula retter seg opp igjen, og svimmelheten gir seg.</span></li>
          </ol>
          <ol class="steps" id="stepsEp" hidden>
            <li data-s="1"><span class="dot"></span><span><b>Hodet bakover, vridd mot <span class="lr" data-r="høyre" data-l="venstre">høyre</span>.</b> Krystallene ruller bort fra ampullen.</span></li>
            <li data-s="2"><span class="dot"></span><span><b>Hodet vris over mot <span class="lr" data-r="venstre" data-l="høyre">venstre</span>.</b> Krystallene ruller videre rundt buegangen.</span></li>
            <li data-s="3"><span class="dot"></span><span><b>Rull over på <span class="lr" data-r="venstre" data-l="høyre">venstre</span> side, nesa mot gulvet.</b> Krystallene når felles skank og faller ut i utriculus.</span></li>
            <li data-s="4"><span class="dot"></span><span><b>Sett deg opp.</b> Krystallene ligger i utriculus, der de ikke gir svimmelhet.</span></li>
          </ol>
          <ol class="steps" id="stepsN" hidden>
            <li data-s="1"><span class="dot"></span><span><b>Hodet beveger seg.</b> Buegangen følger med.</span></li>
            <li data-s="2"><span class="dot"></span><span><b>Væsken henger litt etter</b> og bøyer cupula kort, bare mens hodet er i bevegelse.</span></li>
            <li data-s="3"><span class="dot"></span><span><b>Øynene holder blikket stødig</b> ved å bevege seg motsatt av hodet. Det er en normal refleks.</span></li>
            <li data-s="4"><span class="dot"></span><span><b>Hodet står stille, cupula retter seg opp.</b> Krystallene ligger fast på macula. Ingen svimmelhet.</span></li>
          </ol>
          <ol class="steps" id="stepsC" hidden>
            <li data-s="1"><span class="dot"></span><span><b>Hodet endrer stilling.</b> Buegangen snus med hodet.</span></li>
            <li data-s="2"><span class="dot"></span><span><b>Krystallene sitter fast på cupula</b> og gjør den tung.</span></li>
            <li data-s="3"><span class="dot"></span><span><b>Tyngdekraften bøyer cupula med en gang.</b> Svimmelhet og nystagmus starter uten forsinkelse.</span></li>
            <li data-s="4"><span class="dot"></span><span><b>Det varer så lenge du ligger</b> i samme stilling, og gir seg først når du setter deg opp.</span></li>
          </ol>
          <ol class="steps" id="stepsO" hidden>
            <li data-s="1"><span class="dot"></span><span><b>Krystaller løsner fra macula</b> i utriculus, ofte uten kjent årsak.</span></li>
            <li data-s="2"><span class="dot"></span><span><b>Når du ligger, flyter de mot åpningen</b> til felles skank, som da vender nedover.</span></li>
            <li data-s="3"><span class="dot"></span><span><b>De faller inn i bakre buegang</b> og ruller til det laveste punktet. Ampullen kommer de ikke inn i, fordi cupula stenger.</span></li>
            <li data-s="4"><span class="dot"></span><span><b>Når du setter deg opp, ruller de ned mot ampullen.</b> Nå ligger de klare til å gi svimmelhet neste gang du legger deg ned.</span></li>
          </ol>
          <p class="status"><span>Øyet</span> <span id="eyeTxt">Rolige. Ingen nystagmus.</span></p>
        </div>
      </div>
    </div>
    <div class="zooms">
        <div class="panel">
          <h3 class="ph">Inni utriculus</h3>
          <svg viewBox="0 0 260 150" class="zoom uz" id="uz" aria-hidden="true">
            <rect x="0" y="0" width="260" height="150" rx="14" fill="var(--sky)"/>
            <g id="uzCells"></g>
            <rect x="14" y="78" width="232" height="22" rx="6" fill="var(--turkis)" fill-opacity=".38" stroke="var(--navy2)" stroke-width="1.2"/>
            <g id="uzOto"></g>
            <text x="130" y="142" text-anchor="middle" class="svgs">Macula med sanseceller</text>
            <text x="250" y="94" text-anchor="end" class="svgs" style="font-size:10.5px">Geléhinne</text>
            <text x="12" y="22" class="svgs">Otokonier (krystaller)</text>
          </svg>
          <p class="zcap" id="uzTxt">Krystallene ligger festet i en geléhinne over sansecellene. Når du heller på hodet, glir hinnen litt, og sansecellene merker det.</p>
        </div>
        <div class="panel">
          <h3 class="ph">Inni ampullen</h3>
          <svg viewBox="0 0 260 150" class="zoom" aria-hidden="true">
            <path d="M0 40 H70 Q130 0 190 40 H260 V110 H190 Q130 150 70 110 H0 Z" fill="var(--sky)" stroke="var(--navy2)" stroke-width="2"/>
            <path d="M88 116 Q130 86 172 116 Z" fill="var(--navy2)"/>
            <g id="cilia" stroke="var(--navy)" stroke-width="1.6" stroke-linecap="round"></g>
            <path id="zcup" fill="var(--turkis)" fill-opacity=".45" stroke="var(--navy2)" stroke-width="1.5"/>
            <g id="zdots"></g>
            <g class="zflow" stroke="var(--turkis)" stroke-width="2.5" fill="none" stroke-linecap="round">
              <path id="zarrow" d="M20 75 h36 m-8 -6 l8 6 l-8 6"/>
            </g>
            <text x="6" y="140" class="svgs">← Utriculus</text>
            <text x="254" y="140" text-anchor="end" class="svgs">Buegangen →</text>
            <text x="130" y="134" text-anchor="middle" class="svgs">Crista</text>
            <text x="130" y="26" text-anchor="middle" class="svgs">Cupula</text>
          </svg>
          <p class="zcap" id="zTxt">Cupula står rett. Sansecellene sender et jevnt hvilesignal.</p>
        </div>
    </div>
    <details class="legendbox">
      <summary>Delene i modellen</summary>
      <dl class="legend">
          <div><dt>Utriculus</dt><dd>Sekken der krystallene hører hjemme. Her ligger de fast i en geléhinne over sansecellene.</dd></div>
          <div><dt>Macula og otokonier</dt><dd>Sansefeltet i utriculus (mørk stripe) med krystallene oppå. Merker tyngdekraft og når hodet heller.</dd></div>
          <div><dt>Bakre buegang</dt><dd>En ring av bein (lys) med en tynn hinnegang inni (blå), fylt med væske som heter endolymfe.</dd></div>
          <div><dt>Ampulle</dt><dd>Utvidelsen i enden av buegangen, der den går inn i utriculus.</dd></div>
          <div><dt>Crista og cupula</dt><dd>Crista er en liten kam med sanseceller. Over den står cupula, en gelé som stenger buegangen som en svingdør.</dd></div>
          <div><dt>Felles skank</dt><dd>Den andre enden av buegangen, som den deler med øvre buegang. Det er her krystallene går ut ved Epleys manøver.</dd></div>
        </dl>
    </details>
  </div>
</section>

<!-- KRYSTALLENE -->
<section>
  <div class="c two">
    <div>
      <span class="eyebrow">Krystallene</span>
      <h2>Riktige krystaller, feil sted</h2>
      <p class="pull">Små kalkkrystaller som normalt ligger i utriculus, kan løsne og havne i en av de væskefylte buegangene.</p>
    </div>
    <div>
      <p>I balanseorganet ligger tusenvis av bitte små krystaller av kalsiumkarbonat, <b>otokonier</b>. De hører hjemme i <b>utriculus</b>, der de hjelper deg å merke tyngdekraften og om hodet heller.</p>
      <p><b>Buegangene</b> er laget for å merke at hodet <i>snur</i> seg, ikke for å merke tyngdekraften. Når tunge krystaller havner der, ruller de med tyngdekraften og drar væsken med seg. Da sender buegangen et signal om at hodet snurrer, selv om du ligger helt stille.</p>
      <p>Signalet passer ikke med det øynene og resten av kroppen forteller hjernen. Det er den uoverensstemmelsen som kjennes som kraftig snurring og kvalme.</p>
    </div>
  </div>
</section>

<!-- TO VARIANTER -->
<section class="beige">
  <div class="c">
    <span class="eyebrow">To varianter</span>
    <h2>Krystallene kan flyte fritt eller sitte fast</h2>
    <p class="narrow">Hvordan krystallene ligger, avgjør hvordan svimmelheten oppleves og hvilken manøver som passer. Det er en av grunnene til at riktig undersøkelse betyr så mye.</p>
    <div class="cmpfig">
      <svg viewBox="0 0 560 250" id="cv" role="img" aria-label="Sammenligning av fritt flytende krystaller og krystaller som sitter fast på cupula">
        <g id="cvL"></g><g id="cvR" transform="translate(290 0)"></g>
        <g id="cvG" transform="translate(280 62)">
          <circle r="15" fill="var(--white)" stroke="var(--line)" stroke-width="1.5"/>
          <g id="cvArrow"><path d="M0 -8 V8 M-5 3 L0 9 L5 3" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g>
          <text y="30" text-anchor="middle" class="svgs" style="font-size:10px">Tyngde</text>
        </g>
      </svg>
      <div class="controls" role="group" aria-label="Velg stilling for sammenligningen">
        <button class="chip" id="cvLie" type="button" aria-pressed="false">Legg deg ned</button>
        <button class="chip" id="cvSit" type="button" aria-pressed="true">Sett deg opp</button>
      </div>
      <p class="caption">Ampullen forstørret. Kurvene viser hvor mye cupula bøyes over tid, det vil si hvor svimmel du blir og hvor mye øynene rykker. Ca. ett minutt vises på noen sekunder.</p>
    </div>
    <div class="compare">
      <div class="cmp">
        <small>Vanligst</small>
        <h3>Krystallene flyter fritt</h3>
        <p>Krystallene ligger løst i væsken i buegangen. Når hodet beveges, ruller de, drar væsken med seg og stopper når de har nådd bunnen. Det er dette modellen over viser.</p>
        <dl><dt>Starter</dt><dd>Etter noen sekunder</dd><dt>Varer</dt><dd>Kort, som regel under ett minutt</dd><dt>Gjentas</dt><dd>Blir ofte svakere hvis du gjentar bevegelsen</dd></dl>
      </div>
      <div class="cmp">
        <small>Sjeldnere</small>
        <h3>Krystallene sitter fast på cupula</h3>
        <p>Krystallene har festet seg på cupula, den lille «svingdøren» i buegangen. Den blir tung og bøyes så lenge hodet holdes i samme stilling.</p>
        <dl><dt>Starter</dt><dd>Nesten med en gang</dd><dt>Varer</dt><dd>Så lenge stillingen holdes</dd><dt>Gjentas</dt><dd>Avtar lite</dd></dl>
      </div>
    </div>
    <details class="pro">
      <summary><span class="tag">For fagfolk</span> Kanalolitiasis, kupulolitiasis og Ewalds lover</summary>
      <div class="body">
        <p><b>Kanalolitiasis</b> (frie otokonier i endolymfen) gir nystagmus med latens på noen sekunder, kort varighet (vanligvis &lt; 60 s), crescendo–decrescendo og trettbarhet ved gjentatt testing. Ved oppsetting reverseres nystagmus ofte.</p>
        <p><b>Kupulolitiasis</b> (otokonier festet til cupula, eller en «tung» cupula) gir kort eller ingen latens og vedvarende nystagmus så lenge stillingen holdes. Mest beskrevet i horisontal buegang, med apogeotrop nystagmus.</p>
        <ul>
          <li>I de vertikale buegangene er ampullofugal strøm eksitatorisk (Ewalds 3. lov). Ved Dix-Hallpike beveger otokoniene seg bort fra ampullen i bakre buegang, som da stimuleres.</li>
          <li>Bakre buegang ved kanalolitiasis: oppadslående, torsjonell nystagmus med øvre pol mot underliggende øre.</li>
          <li>Partikler kan også ligge i den korte armen nær ampullen, eller i buegangen nær utriculus, noe som kan gi atypiske funn.</li>
        </ul>
      </div>
    </details>
  </div>
</section>

<!-- HVORFOR -->
<section id="hvorfor">
  <div class="c two">
    <div>
      <span class="eyebrow">Bakgrunn</span>
      <h2>Hvorfor løsner krystallene?</h2>
      <p>Hos mange finnes det ingen tydelig utløsende årsak. Noen forhold ser ut til å gjøre det mer sannsynlig, uten at det betyr en sikker årsakssammenheng.</p>
    </div>
    <div>
      <ul class="dots">
        <li><b>Økende alder.</b> Krystallene og festet deres endrer seg med årene.</li>
        <li><b>Hodeskade</b>, også mindre slag eller fall.</li>
        <li><b>Sykdom i det indre øret</b>, for eksempel etter betennelse i balansenerven.</li>
        <li><b>Lange perioder i samme stilling</b>, som ved sengeleie eller lang tid i tannlegestolen.</li>
        <li>Mulig sammenheng med <b>migrene</b>, <b>benskjørhet</b> og <b>lave vitamin D-nivåer</b>.</li>
      </ul>
      <p style="margin-top:18px">Krystallsyke kan komme tilbake. <a class="tlink" href="/blogg/hvorfor-kommer-krystallsyken-tilbake/">Les om tilbakefall</a></p>
    </div>
  </div>
</section>

<!-- BEHANDLING KORT -->
<section class="navyS">
  <div class="c two">
    <div>
      <span class="eyebrow">Derfor virker behandlingen</span>
      <h2>Krystallene må tilbake dit de kom fra</h2>
    </div>
    <div>
      <p>En reponeringsmanøver er en rekke hodestillinger som får krystallene til å rulle gjennom buegangen og ut i utriculus igjen. Der gjør de ingen skade.</p>
      <p>Hver buegang har sin egen manøver, og retningen avhenger av hvilket øre det gjelder. <b>Feil manøver eller feil side hjelper ikke</b>, og derfor bør buegang og side avklares ved undersøkelse før du gjør øvelsene selv.</p>
      <p style="margin-top:20px"><a class="tlink" style="color:var(--white)" href="/svimmelhet/krystallsyke/#behandling">Les om behandling av krystallsyke</a></p>
    </div>
  </div>
</section>


        $('bEpley').hidden=false;$('bOrigin').hidden=true;st.busy=false;$('stTitle').textContent='Nå har du krystallsyke';}]}];kick()}
    if(Math.abs(st.theta-120)>1){rotate(120,'Ligger, hodet bakover');st.queue=[detach]}else detach();
  });
  $('bReset').addEventListener('click',function(){setEar(st.ear)});
  $('bNormal').addEventListener('click',function(){setEar('normal')});
  $('bBppv').addEventListener('click',function(){setEar('bppv')});

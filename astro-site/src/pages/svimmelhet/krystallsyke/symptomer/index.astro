<script>
(function () {
  // Tegn kurven når den kommer til syne
  const card = document.getElementById("sym-curve");
  if (card) {
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((e) => {
        if (e[0].isIntersecting) { card.classList.add("on"); io.disconnect(); }
      }, { threshold: 0.35 });
      io.observe(card);
    } else card.classList.add("on");
  }

  // Selvsjekk. Logikk (godkjent av Marie 2026-11-15):
  // spm. 6 = ja → alltid faresignal-svar. Spm. 1 og 2 = ja og minst 4 av 5 ja
  // → «ligner typisk krystallsyke». Minst 2 «vet ikke» → tips om å observere.
  // Anbefaler aldri side eller manøver.
  const check = document.getElementById("sym-check");
  const R = document.getElementById("sym-result");
  if (!check || !R) return;
  const ans: Record<string, string> = {};
  const set = (cls: string, h: string | null, p: string, acts = "") => {
    R.className = "result" + (cls ? " " + cls : "");
    R.innerHTML =
      '<span class="lab">' + (cls === "alarm" ? "Søk hjelp i dag" : "Ditt mønster") + "</span>" +
      (h ? "<h3>" + h + "</h3>" : "") + "<p>" + p + "</p>" +
      (acts ? '<div class="acts">' + acts + "</div>" : "");
  };
  const help = '<a class="btn" href="/fa-hjelp/">Få hjelp</a>';
  const render = () => {
    if (ans["6"] === "ja") {
      set("alarm", "Dette bør vurderes av lege samme dag",
        "Slike symptomer i tillegg til svimmelhet kan ha en annen årsak enn krystallsyke. Ring 113 ved plutselige symptomer, ellers legevakt på 116 117.",
        '<a class="btn" href="#faresignaler">Se faresignalene</a>');
      return;
    }
    const keys = ["1", "2", "3", "4", "5"];
    const answered = keys.filter((k) => ans[k]).length;
    if (answered < 5) { set("", null, "Du har svart på " + answered + " av 5. Svar på resten, så ser du hva mønsteret peker mot."); return; }
    const ja = keys.filter((k) => ans[k] === "ja").length;
    const vet = keys.filter((k) => ans[k] === "vet").length;
    if (ans["1"] === "ja" && ans["2"] === "ja" && ja >= 4) {
      set("", "Det du beskriver ligner typisk krystallsyke",
        "Det er et godt tegn, fordi krystallsyke som regel kan behandles effektivt. En undersøkelse avklarer hvilket øre og hvilken buegang det gjelder, slik at du får riktig manøver.",
        help + '<a class="btn ghost" href="/hjemme/">Krystallsykehjelpen hjemme</a>');
      return;
    }
    if (vet >= 2) {
      set("", "Vanskelig å si ennå",
        "Legg merke til hva som skjer neste gang: Hvilken bevegelse utløste det, og omtrent hvor mange sekunder varte snurringen? Skriv det gjerne ned. Det er svært nyttig for den som skal undersøke deg.",
        '<a class="btn ghost" href="#utlosere">Se typiske utløsere</a>');
      return;
    }
    if (ans["1"] === "ja") {
      set("", "Noe ligner, noe passer mindre godt",
        "Svimmelhet ved stillingsendring kan være krystallsyke selv om ikke alt stemmer, men det kan også ha andre årsaker. Det er verdt å få det undersøkt.",
        help + '<a class="btn ghost" href="#annet">Andre årsaker</a>');
      return;
    }
    set("", "Mønsteret passer mindre godt med typisk krystallsyke",
      "Svimmelhet kan ha mange årsaker. Se oversikten over andre tilstander, og ta kontakt med lege eller behandler hvis plagene fortsetter.",
      '<a class="btn ghost" href="#annet">Andre årsaker</a>' + help);
  };
  check.querySelectorAll<HTMLElement>(".q").forEach((q) => {
    const n = q.dataset.q || "";
    const btns = q.querySelectorAll<HTMLButtonElement>("button");
    btns.forEach((b) => b.addEventListener("click", () => {
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      ans[n] = b.dataset.v || "";
      render();
    }));
  });
})();
</script>


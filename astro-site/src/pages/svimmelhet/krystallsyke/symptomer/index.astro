---
import Layout from "../../../../layouts/Layout.astro";

// Underside i krystallsyke-klyngen (se Krystallsyke-temaklynge-plan.md i
// prosjektet). Eier: hvordan krystallsyke kjennes. Erstatter bloggen
// «Kjenner du deg igjen? Er dette krystallsyke?» (301 i vercel.json).
// Mønstrene per buegang bor på /buegangene/, undersøkelsen på /undersokelse/
// – lenk dit, ikke gjenta dem. Selvsjekken anbefaler aldri side eller manøver
// (Maries sikkerhetsregler). Stilene er samlet under .sym-klassen.

const base = "https://www.krystallsykehjelpen.no";
const url = `${base}/svimmelhet/krystallsyke/symptomer/`;
const heroImage = "/symptomer-hero-1400.webp";
const ogImage = "/symptomer-og.jpg";

const phases = [
  { title: "Noen sekunders pause", text: "Du beveger hodet, og det skjer ingenting med en gang." },
  { title: "Snurringen tar til", text: "Bygger seg opp til en tydelig topp. Mange griper tak i noe." },
  { title: "Avtar av seg selv", text: "Som regel borte innen ett minutt, også om du blir liggende." },
  { title: "Ettervirkning", text: "Kvalme, ørhet og ustøhet kan sitte i en stund etterpå." },
];

// Enkle strektegninger (SVG) av hver situasjon. Turkis pil = bevegelsen.
const situations = [
  {
    title: "Å snu seg i sengen",
    text: "Det klassiske: du ruller over på siden og rommet går rundt. Ofte verst til den ene siden.",
    canal: "Bakre eller horisontal buegang",
    svg: `<rect x="30" y="72" width="160" height="10" rx="5" fill="#e5eeec"/><rect x="38" y="58" width="34" height="14" rx="7" fill="#fff" stroke="#163875" stroke-width="2"/><path d="M78 64 H170" stroke="#163875" stroke-width="12" stroke-linecap="round"/><circle cx="60" cy="50" r="13" fill="#f6f0e4" stroke="#163875" stroke-width="2.5"/><path d="M42 26 A26 26 0 0 1 80 28" fill="none" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/><path d="M80 28 l-9 -2 M80 28 l-2 -9" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/>`,
  },
  {
    title: "Å legge seg ned",
    text: "Idet hodet treffer puta. Mange merker det først om kvelden eller når de legger seg på ryggen.",
    canal: "Oftest bakre buegang",
    svg: `<rect x="30" y="80" width="160" height="10" rx="5" fill="#e5eeec"/><path d="M120 76 H178" stroke="#163875" stroke-width="12" stroke-linecap="round"/><path d="M120 76 L78 58" stroke="#163875" stroke-width="13" stroke-linecap="round"/><circle cx="62" cy="52" r="13" fill="#f6f0e4" stroke="#163875" stroke-width="2.5"/><path d="M70 22 Q48 26 40 44" fill="none" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/><path d="M40 44 l1 -9 M40 44 l8 -4" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/>`,
  },
  {
    title: "Å sette seg opp",
    text: "Om morgenen, når du reiser deg fra liggende. Krystallene har ofte samlet seg i løpet av natten.",
    canal: "Oftest bakre buegang",
    svg: `<rect x="30" y="86" width="160" height="10" rx="5" fill="#e5eeec"/><path d="M110 82 H170" stroke="#163875" stroke-width="12" stroke-linecap="round"/><path d="M110 82 L96 42" stroke="#163875" stroke-width="13" stroke-linecap="round"/><circle cx="92" cy="26" r="13" fill="#f6f0e4" stroke="#163875" stroke-width="2.5"/><path d="M58 70 Q56 40 70 22" fill="none" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/><path d="M70 22 l-9 3 M70 22 l1 9" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/>`,
  },
  {
    title: "Å se opp",
    text: "Henge opp gardiner, hente noe fra et høyt skap, se på stjernehimmelen.",
    canal: "Oftest bakre buegang",
    svg: `<path d="M110 104 V54" stroke="#163875" stroke-width="13" stroke-linecap="round"/><circle cx="104" cy="34" r="13" fill="#f6f0e4" stroke="#163875" stroke-width="2.5"/><path d="M114 26 L122 19" stroke="#163875" stroke-width="2.5" stroke-linecap="round"/><rect x="132" y="8" width="54" height="8" rx="4" fill="#e5eeec"/><path d="M128 52 A30 30 0 0 0 120 12" fill="none" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/><path d="M120 12 l1 9 M120 12 l8 3" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/>`,
  },
  {
    title: "Å bøye seg frem",
    text: "Knyte skolissene, plukke opp noe fra gulvet, vaske gulv eller luke i hagen.",
    canal: "Bakre eller øvre buegang",
    svg: `<path d="M110 104 V70" stroke="#163875" stroke-width="13" stroke-linecap="round"/><path d="M110 70 L80 54" stroke="#163875" stroke-width="13" stroke-linecap="round"/><circle cx="66" cy="62" r="13" fill="#f6f0e4" stroke="#163875" stroke-width="2.5"/><rect x="40" y="96" width="34" height="8" rx="4" fill="#e5eeec"/><path d="M46 30 Q30 46 40 74" fill="none" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/><path d="M40 74 l-1 -9 M40 74 l7 -6" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/>`,
  },
  {
    title: "Hos frisøren eller tannlegen",
    text: "Når stolen vippes bakover og hodet legges ned i vasken eller nakkestøtten.",
    canal: "Oftest bakre buegang",
    svg: `<path d="M60 92 H160 M150 92 V104 M70 92 V104" stroke="#e5eeec" stroke-width="8" stroke-linecap="round"/><path d="M150 84 L92 70" stroke="#163875" stroke-width="13" stroke-linecap="round"/><circle cx="74" cy="72" r="13" fill="#f6f0e4" stroke="#163875" stroke-width="2.5"/><rect x="44" y="76" width="24" height="9" rx="4" fill="#e5eeec"/><path d="M84 40 Q64 40 54 54" fill="none" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/><path d="M54 54 l1 -9 M54 54 l9 -2" stroke="#5fc1d6" stroke-width="3" stroke-linecap="round"/>`,
  },
];

const questions = [
  "Svimmelheten kommer når jeg endrer stilling med hodet: legger meg, snur meg i sengen, ser opp eller bøyer meg.",
  "Hvert anfall varer kort, fra noen sekunder til under ett minutt.",
  "Det kjennes som om rommet snurrer eller går rundt.",
  "Det roer seg når jeg holder hodet i ro.",
  "Mellom anfallene er jeg stort sett i form, kanskje litt ustø eller kvalm.",
];

const more = [
  { title: "Kvalme og oppkast", text: "Særlig når den horisontale buegangen er rammet, eller når anfallene kommer tett. Noen kaster opp." },
  { title: "Ustøhet og gyngefølelse", text: "En følelse av å gå på en båt etter anfallene, selv om du ikke snurrer. Kan vare dager." },
  { title: "Tung eller tåkete i hodet", text: "Mange beskriver at de er slitne, ukonsentrerte eller ikke helt til stede i perioder med krystallsyke." },
  { title: "Stiv nakke", text: "Når du unngår å bevege hodet for å slippe anfall, blir nakken fort stiv og øm. Det er en følge, ikke årsaken." },
  { title: "Verst om morgenen", text: "Etter en natt i ro kan krystallene samle seg. De første bevegelsene når du står opp, er ofte de verste." },
  { title: "Redsel for neste anfall", text: "Det er helt vanlig å bli engstelig og forsiktig. Usikkerheten blir ofte mindre straks du vet hva det er." },
];

const diffs = [
  { kicker: "Denne siden", title: "Krystallsyke", me: true, dur: "Sekunder, under ett minutt per anfall", trig: "Bestemte stillinger med hodet", other: "Stort sett i form mellom anfallene" },
  { kicker: "Vestibulær migrene", title: "Lengre episoder", dur: "Minutter til timer, noen ganger dager", trig: "Kan komme av seg selv. Også bevegelse, stress, søvnmangel, lys", other: "Ofte migrene i sykehistorien, lys- og lydømfintlighet", link: { href: "/blogg/krystallsyke-eller-vestibular-migrene/", label: "Slik skiller du dem" } },
  { kicker: "Betennelse på balansenerven", title: "Vestibularisnevritt", dur: "Sammenhengende i dager, bedres gradvis over uker", trig: "Kommer plutselig, uten at du har gjort noe spesielt", other: "Konstant svimmelhet, kvalme og ustø gange, verre ved bevegelse" },
  { kicker: "Ménières sykdom", title: "Anfall med ørepreg", dur: "Fra 20 minutter til flere timer", trig: "Kommer av seg selv, ikke av stilling", other: "Nedsatt hørsel, øresus og trykk i øret under anfallene" },
  { kicker: "Blodtrykksfall", title: "Ør når du reiser deg", dur: "Sekunder", trig: "Å reise seg opp. Ikke å legge seg ned eller snu seg i sengen", other: "Svartner for øynene, ørhet heller enn snurring" },
  { kicker: "PPPD", title: "Vedvarende ustøhet", dur: "De fleste dager, i måneder", trig: "Verre av å stå og gå, travle omgivelser, skjerm og butikker", other: "Gynging og ustøhet, sjelden snurring. Kan komme etter krystallsyke", link: { href: "/blogg/svimmel-i-butikker-eller-av-skjerm/", label: "Svimmel i butikker eller av skjerm?" } },
];

const next = [
  { kicker: "Få det avklart", title: "Hvordan undersøkelsen foregår", text: "Posisjonstester og øyebevegelser viser om det er krystallsyke, i hvilket øre og hvilken buegang.", go: "Les om undersøkelsen →", href: "/svimmelhet/krystallsyke/undersokelse/" },
  { kicker: "Forstå det", title: "Hva skjer i øret?", text: "Se hvordan små krystaller havner på feil sted og lurer balanseorganet.", go: "Se modellen →", href: "/svimmelhet/krystallsyke/hva-skjer-i-oret/" },
  { kicker: "Hjelp deg selv", title: "Krystallsykehjelpen hjemme", text: "Trygg veiledning steg for steg, enten du har fått påvist krystallsyke eller er usikker.", go: "Kom i gang →", href: "/hjemme/" },
];

const faq = [
  { q: "Kan krystallsyke gi svimmelhet hele dagen?", a: "Selve snurringen varer kort. Men kvalmen, ustøheten og ørheten etter anfallene kan henge i, og når anfallene kommer tett, kan det føles som om du er svimmel hele tiden. Er du like svimmel når du sitter helt i ro, bør det vurderes om det er noe annet." },
  { q: "Hvorfor kom det plutselig, uten grunn?", a: "Ofte finnes det ingen tydelig årsak. Krystallene løsner av seg selv, og risikoen øker med alderen. Hodeskader, lange perioder i sengeleie og andre sykdommer i øret kan også utløse det." },
  { q: "Kan begge ørene være rammet?", a: "Det skjer, men det er sjeldnere. Det er mest vanlig etter hodeskader. En undersøkelse viser hvilke sider og buegange som er involvert." },
  { q: "Kan jeg kjøre bil?", a: "Ikke mens du har anfall. Å snu hodet for å se bakover eller i sidespeilet kan utløse svimmelhet. Vent til du har vært uten anfall en stund, og spør behandleren din om du er usikker." },
  { q: "Går det over av seg selv?", a: "Ofte gjør det det, men det kan ta uker. Med riktig manøver blir de fleste bedre langt raskere, gjerne etter én til tre behandlinger." },
];

const sources = [
  { label: "von Brevern M, Bertholon P, Brandt T, et al. Benign paroxysmal positional vertigo: Diagnostic criteria. J Vestib Res. 2015;25(3-4):105–117.", url: "https://pubmed.ncbi.nlm.nih.gov/26756126/" },
  { label: "Bhattacharyya N, Gubbels SP, Schwartz SR, et al. Clinical Practice Guideline: Benign Paroxysmal Positional Vertigo (Update). Otolaryngol Head Neck Surg. 2017;156(3_suppl):S1–S47.", url: "https://pubmed.ncbi.nlm.nih.gov/28248609/" },
  { label: "von Brevern M, Radtke A, Lezius F, et al. Epidemiology of benign paroxysmal positional vertigo: a population based study. J Neurol Neurosurg Psychiatry. 2007;78(7):710–715.", url: "https://pubmed.ncbi.nlm.nih.gov/17135456/" },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Hjem", item: `${base}/` },
    { "@type": "ListItem", position: 2, name: "Svimmelhet", item: `${base}/svimmelhet/` },
    { "@type": "ListItem", position: 3, name: "Krystallsyke", item: `${base}/svimmelhet/krystallsyke/` },
    { "@type": "ListItem", position: 4, name: "Symptomer", item: url },
  ],
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const pageLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "Symptomer på krystallsyke: kjenner du deg igjen?",
  url,
  inLanguage: "nb-NO",
  about: { "@type": "MedicalCondition", name: "Benign paroksysmal posisjonsvertigo (krystallsyke)", alternateName: ["BPPV", "Krystallsyke"] },
  author: { "@type": "Person", name: "Marie Hermansen", jobTitle: "Kiropraktor" },
};
---

<Layout
  title="Symptomer på krystallsyke: kjenner du deg igjen? | Krystallsykehjelpen"
  description="Rommet snurrer når du snur deg i sengen eller ser opp? Se hvordan et typisk anfall av krystallsyke (BPPV) forløper, hva som utløser det, og hva som tyder på noe annet."
  activePath="/svimmelhet/krystallsyke/symptomer/"
  image={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />

  <div class="sym">

<section class="hero">
  <div class="c">
    <nav class="crumbs"><a href="/">Forside</a> / <a href="/svimmelhet/">Svimmelhet</a> / <a href="/svimmelhet/krystallsyke/">Krystallsyke</a> / Symptomer</nav>
    <div class="herogrid">
      <div>
        <span class="eyebrow">Krystallsyke · Symptomer</span>
        <h1>Kjenner du deg igjen? <em>Slik kjennes krystallsyke</em></h1>
        <p class="lead">Rommet snurrer når du snur deg i sengen, legger deg ned eller ser opp. Så roer det seg igjen. Her ser du hvordan et typisk anfall forløper, hva som utløser det, og hva som tyder på at det kan være noe annet.</p>
        <div class="byline">
          <img src="/marie-hermansen-240.webp" alt="" width="60" height="60" />
          <span>Faglig skrevet av <a href="/mott-marie/"><strong>Marie Hermansen</strong></a>, kiropraktor<br />Særlig kompetanse innen krystallsyke og svimmelhet</span>
        </div>
      </div>
      <div class="heroimg"><img src={heroImage} srcset="/symptomer-hero-800.webp 800w, /symptomer-hero-1400.webp 1400w" sizes="(max-width: 860px) 100vw, 520px" alt="Kvinne i gangen som støtter seg mot veggen fordi hun plutselig blir svimmel" width="1400" height="788" fetchpriority="high" /></div>
    </div>
    <div class="facts">
      <div><b>Sekunder</b><strong>Hvert anfall</strong><span>Som regel under ett minutt</span></div>
      <div><b>2–3 av 100</b><strong>Får det i løpet av livet</strong><span>Den vanligste årsaken til svimmelhet fra øret</span></div>
      <div><b>1–3</b><strong>Behandlinger</strong><span>er nok for de fleste med akutt krystallsyke</span></div>
    </div>
  </div>
</section>

<section class="afterhero">
  <div class="c narrow">
    <div class="summary">
      <span class="eyebrow">Kort fortalt</span>
      <p>Krystallsyke gir korte anfall av snurrende svimmelhet når hodet flyttes i bestemte retninger. Anfallet starter noen sekunder etter bevegelsen, topper seg og gir seg som regel innen ett minutt. Mange kjenner seg kvalme eller ustø en stund etterpå. Symptomene gir en god pekepinn, men det er en undersøkelse av øyebevegelsene som avgjør om det er krystallsyke, og i hvilken buegang.</p>
    </div>
    <nav class="jump" aria-label="Hopp til">
      <a href="#anfall">Et typisk anfall</a><a href="#utlosere">Hva utløser det</a><a href="#selvsjekk">Kjenner du deg igjen?</a><a href="#annet">Noe annet?</a><a href="#faresignaler">Faresignaler</a>
    </nav>
  </div>
</section>

<section class="white anchor" id="anfall">
  <div class="c">
    <div class="two">
      <div>
        <span class="eyebrow">Et typisk anfall</span>
        <h2>Kort, kraftig, og så over</h2>
        <p class="pull">Det typiske er ikke hvor sterk svimmelheten er, men mønsteret: samme bevegelse, samme reaksjon, og ro når hodet er i ro.</p>
      </div>
      <div>
        <p>Mange beskriver det som å sitte i en karusell som plutselig settes i gang. Snurringen kommer ikke i samme øyeblikk som du beveger deg, men noen sekunder etter. Den bygger seg opp, når en topp og avtar av seg selv, selv om du blir liggende i samme stilling.</p>
        <p>Etterpå kan du kjenne deg kvalm, ør eller ustø. Den følelsen kan henge igjen i timer, og noen tror derfor at de er svimle hele tiden. Det er nyttig å skille mellom selve anfallet og ettervirkningen når du beskriver plagene for den som undersøker deg.</p>
      </div>
    </div>

    <div class="curvecard" id="sym-curve">
      <svg class="curve" viewBox="0 0 900 300" role="img" aria-label="Kurve over et typisk anfall: rolig i noen sekunder etter bevegelsen, så en kraftig topp som avtar innen ett minutt, og en lav ettervirkning etterpå">
        <defs>
          <linearGradient id="sym-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5fc1d6" stop-opacity=".32" /><stop offset="1" stop-color="#5fc1d6" stop-opacity="0" /></linearGradient>
        </defs>
        <line x1="40" y1="240" x2="870" y2="240" stroke="#dbe5e3" stroke-width="2" />
        <line x1="40" y1="40" x2="40" y2="240" stroke="#dbe5e3" stroke-width="2" />
        <text class="ax" x="40" y="268">BEVEGELSE</text>
        <text class="ax" x="870" y="268" text-anchor="end">TID →</text>
        <line x1="70" y1="60" x2="70" y2="240" stroke="#1e4c96" stroke-width="1.5" stroke-dasharray="4 5" />
        <path d="M70 238 L140 238 C175 238 185 70 230 62 C285 54 320 150 380 205 C420 235 450 220 520 222 C640 225 760 232 860 236 L860 240 L70 240 Z" fill="url(#sym-fill)" />
        <path class="line" d="M70 238 L140 238 C175 238 185 70 230 62 C285 54 320 150 380 205 C420 235 450 220 520 222 C640 225 760 232 860 236" fill="none" stroke="#163875" stroke-width="3.5" stroke-linecap="round" />
        <circle cx="105" cy="238" r="6" fill="#fff" stroke="#256478" stroke-width="2.5" />
        <circle cx="232" cy="62" r="6" fill="#fff" stroke="#256478" stroke-width="2.5" />
        <circle cx="380" cy="205" r="6" fill="#fff" stroke="#256478" stroke-width="2.5" />
        <circle cx="640" cy="225" r="6" fill="#fff" stroke="#256478" stroke-width="2.5" />
        <text class="lbl" x="105" y="212" text-anchor="middle">1</text>
        <text class="lbl" x="232" y="40" text-anchor="middle">2</text>
        <text class="lbl" x="398" y="186">3</text>
        <text class="lbl" x="640" y="205" text-anchor="middle">4</text>
        <text class="sm" x="262" y="80">Rommet snurrer</text>
        <text class="sm" x="410" y="150">Avtar av seg selv</text>
        <text class="sm" x="560" y="196">Kvalm, ør, ustø</text>
        <line x1="70" y1="248" x2="400" y2="248" stroke="#256478" stroke-width="2" />
        <text class="sm keep" x="235" y="285" text-anchor="middle">under ett minutt</text>
        <line x1="420" y1="248" x2="860" y2="248" stroke="#5fc1d6" stroke-width="2" stroke-dasharray="6 6" />
        <text class="sm keep" x="640" y="285" text-anchor="middle">minutter til timer</text>
      </svg>
      <ol class="phases">
        {phases.map((p, i) => (
          <li><strong><i>{i + 1}</i>{p.title}</strong><span>{p.text}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="anchor" id="utlosere">
  <div class="c">
    <span class="eyebrow">Hva utløser det</span>
    <h2>Seks situasjoner mange kjenner igjen</h2>
    <p class="narrow">Det er ikke bevegelsen i seg selv, men hodets stilling i forhold til tyngdekraften som setter i gang anfallet. Derfor kommer det ofte i sengen, og ved å se opp eller bøye seg.</p>
    <div class="sitgrid">
      {situations.map((s) => (
        <div class="sit">
          <svg viewBox="0 0 220 110" aria-hidden="true" set:html={s.svg} />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <span class="k">{s.canal}</span>
        </div>
      ))}
    </div>
    <p class="after"><a class="tlink" href="/svimmelhet/krystallsyke/buegangene/">Se hvorfor buegangen avgjør hva som utløser svimmelheten</a></p>
  </div>
</section>

<section class="white anchor" id="selvsjekk">
  <div class="c">
    <span class="eyebrow">Selvsjekk</span>
    <h2>Kjenner du deg igjen?</h2>
    <p class="narrow">Svar så godt du kan. Dette er ikke en diagnose, men kan hjelpe deg å sortere det du kjenner på før du snakker med en behandler. Usikker? Velg «Vet ikke».</p>
    <div class="check" id="sym-check">
      {questions.map((q, i) => (
        <div class="q" data-q={String(i + 1)}>
          <p>{q}</p>
          <div class="seg" role="group" aria-label="Svar">
            <button type="button" data-v="ja" aria-pressed="false">Ja</button>
            <button type="button" data-v="nei" aria-pressed="false">Nei</button>
            <button type="button" data-v="vet" aria-pressed="false">Vet ikke</button>
          </div>
        </div>
      ))}
      <div class="q alarm" data-q="6">
        <p>Jeg har i tillegg dobbeltsyn, talevansker, nummenhet, lammelser, kraftig hodepine eller store problemer med å gå.</p>
        <div class="seg" role="group" aria-label="Svar">
          <button type="button" data-v="ja" aria-pressed="false">Ja</button>
          <button type="button" data-v="nei" aria-pressed="false">Nei</button>
          <button type="button" data-v="vet" aria-pressed="false">Vet ikke</button>
        </div>
      </div>
      <div class="result" id="sym-result" aria-live="polite">
        <span class="lab">Ditt mønster</span>

---
import Layout from "../../../../layouts/Layout.astro";

// Underside i krystallsyke-klyngen (se Krystallsyke-temaklynge-plan.md i
// prosjektet). Eier: hvorfor og hvordan behandlingen virker, forløp,
// hjemmeøvelser og hva som skjer etterpå. Manøverinstruksjonene bor i
// øvelsesbiblioteket, mønstrene per buegang på /buegangene/ – lenk dit.
// Brandt-Daroff nevnes bevisst ikke (Maries valg). Modellen viser prinsippet,
// ikke en anatomisk nøyaktig Epley. Stilene er samlet under .bhd-klassen.

const base = "https://www.krystallsykehjelpen.no";

const maneuvers = [
  { k: "Bakre buegang", title: "Epley eller Semont", text: "Den vanligste typen. Hodet føres gjennom stillinger som ruller krystallene bakover og ut.", href: "/ovelsesbibliotek/bakre-buegang/", link: "Se manøvrene" },
  { k: "Horisontal buegang", title: "Barbecue-rull eller Gufoni", text: "Du ruller eller legges over på siden i bestemte trinn, slik at krystallene følger den vannrette buegangen ut.", href: "/ovelsesbibliotek/horisontale-buegang/", link: "Se manøvrene" },
  { k: "Øvre buegang", title: "Dyp hodehenging", text: "Den sjeldneste typen. Hodet legges godt bakover og føres så fremover.", href: "/ovelsesbibliotek/ovre-buegang/yacovino/", link: "Se manøveren" },
];

const articles = [
  { k: "Restsvimmelhet", title: "Ustø etter behandling", text: "Hvorfor noen kjenner seg ustø en tid etter at krystallene er på plass.", href: "/blogg/restsvimmelhet-etter-krystallsyke/" },
  { k: "Tilbakefall", title: "Når det kommer tilbake", text: "Hvor vanlig det er, og hva du kan gjøre.", href: "/blogg/hvorfor-kommer-krystallsyken-tilbake/" },
  { k: "Epley virker ikke?", title: "Når manøveren ikke hjelper", text: "Vanlige grunner til at behandlingen ikke slår til.", href: "/blogg/epleys-manover-virker-ikke/" },
];

const faq = [
  { q: "Gjør behandlingen vondt?", a: "Nei. Det kan snurre kraftig i noen sekunder i enkelte stillinger, men det gjør ikke vondt. Si fra hvis du har vondt i nakken eller ryggen, så tilpasser vi manøveren." },
  { q: "Hvorfor er jeg fortsatt litt svimmel etter behandlingen?", a: "Det er vanlig å kjenne seg ustø en tid etterpå, selv når krystallene er på plass. Balansesystemet trenger litt tid på å stille seg inn igjen." },
  { q: "Kan krystallsyke gå over av seg selv?", a: "Ja, ofte. Men riktig manøver gir som regel raskere bedring, og du slipper å gå lenge med svimmelheten." },
  { q: "Hjelper medisiner mot krystallsyke?", a: "Medisiner mot svimmelhet eller kvalme kan dempe plagene, men fjerner ikke krystallene. Behandlingen er manøveren." },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Hjem", item: `${base}/` },
    { "@type": "ListItem", position: 2, name: "Svimmelhet", item: `${base}/svimmelhet/` },
    { "@type": "ListItem", position: 3, name: "Krystallsyke", item: `${base}/svimmelhet/krystallsyke/` },
    { "@type": "ListItem", position: 4, name: "Behandling", item: `${base}/svimmelhet/krystallsyke/behandling/` },
  ],
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const pageLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "Slik behandles krystallsyke",
  url: `${base}/svimmelhet/krystallsyke/behandling/`,
  inLanguage: "nb-NO",
  about: { "@type": "MedicalCondition", name: "Benign paroksysmal posisjonsvertigo (krystallsyke)", alternateName: ["BPPV", "Krystallsyke"] },
  author: { "@type": "Person", name: "Marie Hermansen", jobTitle: "Kiropraktor" },
};
---

<Layout
  title="Behandling av krystallsyke: slik virker manøvrene | Krystallsykehjelpen"
  description="Slik behandles krystallsyke: hvordan manøvrene fører krystallene hjem, hvorfor riktig manøver krever riktig funn, hvor mange behandlinger du trenger, og hva du kan gjøre selv."
  activePath="/svimmelhet/krystallsyke/behandling/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />

  <div class="bhd">

<section class="hero">
  <div class="c">
    <nav class="crumbs"><a href="/">Forside</a> / <a href="/svimmelhet/">Svimmelhet</a> / <a href="/svimmelhet/krystallsyke/">Krystallsyke</a> / Behandling</nav>
    <span class="eyebrow">Krystallsyke · Behandling</span>
    <h1>Slik behandles krystallsyke</h1>
    <p class="lead">Krystallsyke behandles ved å føre krystallene ut av buegangen og tilbake dit de hører hjemme. Det gjøres med en manøver, en serie rolige hodestillinger som er tilpasset hvor krystallene ligger.</p>
    <div class="facts">
      <div><b>1–3</b><strong>Behandlinger</strong><span>De fleste med akutt krystallsyke blir bra</span></div>
      <div><b>Tilpasset</b><strong>Riktig manøver</strong><span>Valgt ut fra buegang og side</span></div>
      <div><b>Ufarlig</b><strong>Kan kjennes ubehagelig</strong><span>Svimmelhet underveis er vanlig</span></div>
    </div>
  </div>
</section>

<section class="afterhero">
  <div class="c two">
    <div>
      <span class="eyebrow">Hvordan det virker</span>
      <h2>Krystallene føres hjem, steg for steg</h2>
      <p>Buegangen er en liten, væskefylt ring. Krystallene følger tyngdekraften. Når hodet føres gjennom bestemte stillinger i riktig rekkefølge, ruller krystallene rundt i buegangen og ut igjen i utriculus, der de ikke lenger gir svimmelhet.</p>
      <p>Hver stilling holdes til svimmelheten har gitt seg, slik at krystallene rekker å legge seg før neste steg. Ingen av stillingene trenger å gjøres raskt.</p>
      <p><a class="tlink" href="/svimmelhet/krystallsyke/hva-skjer-i-oret/">Se hva krystallene gjør i øret</a></p>
    </div>
    <div class="model">
      <svg viewBox="0 0 300 240" role="img" aria-label="Forenklet modell av bakre buegang der krystaller føres tilbake til utriculus">
        <ellipse cx="96" cy="196" rx="62" ry="28" fill="rgba(246,240,228,.12)" stroke="#f6f0e4" stroke-width="2.5" />
        <text x="96" y="230" text-anchor="middle" class="svgl">UTRICULUS</text>
        <circle cx="170" cy="104" r="74" fill="none" stroke="#f6f0e4" stroke-width="16" opacity=".18" />
        <circle cx="170" cy="104" r="74" fill="none" stroke="#f6f0e4" stroke-width="2.5" />
        <circle cx="170" cy="104" r="58" fill="none" stroke="#f6f0e4" stroke-width="2.5" />
        <text x="170" y="108" text-anchor="middle" class="svgl">BAKRE BUEGANG</text>
        <g id="bhd-crystals"></g>
      </svg>
      <p class="cap" id="bhd-cap" aria-live="polite"><b>Før behandling</b>Krystallene ligger i bunnen av buegangen og gir svimmelhet når du legger deg ned.</p>
      <div class="steps" role="group" aria-label="Velg steg i manøveren" id="bhd-steps"></div>
      <div class="play"><button type="button" id="bhd-play">Spill av hele manøveren</button></div>
    </div>
  </div>
</section>

<section class="white">
  <div class="c">
    <span class="eyebrow">Riktig manøver</span>
    <h2>Målrettet, ikke tilfeldig</h2>
    <p class="narrow">Hvilken manøver som hjelper, avhenger av hvilken buegang krystallene ligger i, og i hvilket øre. Derfor kommer behandlingen etter undersøkelsen, ikke før.</p>
    <p class="pull narrow">Epley er svært nyttig ved riktig type krystallsyke, men er ikke løsningen på all krystallsyke.</p>
    <div class="cards">
      {maneuvers.map((m) => (
        <div class="card"><span class="k">{m.k}</span><h3>{m.title}</h3><p>{m.text}</p><a class="tlink" href={m.href}>{m.link}</a></div>
      ))}
    </div>
    <p class="more"><a class="tlink" href="/svimmelhet/krystallsyke/buegangene/">Les mer om de tre buegangene</a></p>
  </div>
</section>

<section>
  <div class="c">
    <span class="eyebrow">Forløpet</span>
    <h2>Hvor mange behandlinger trenger jeg?</h2>
    <p class="narrow">Det avhenger av hva vi finner, hvor du er i forløpet, og hvordan du responderer på behandlingen. Er svimmelheten veldig akutt, ser vi deg ofte igjen allerede dagen etter. Er den mindre akutt, kan det gå et par dager, og i mange tilfeller får du øvelser å gjøre hjemme i mellomtiden.</p>
    <div class="course three">
      <div><b>1–3</b><strong>De fleste med akutt krystallsyke</strong><p>blir bra etter én til tre behandlinger.</p></div>
      <div><b>Flere</b><strong>Eldre</strong><p>trenger ofte noen flere behandlinger før krystallene er på plass.</p></div>
      <div><b>I tillegg</b><strong>Noen trenger mer</strong><p>som behandling av muskler og ledd eller vestibulær rehabilitering for å bli helt bra.</p></div>
    </div>
  </div>
</section>

<section class="white">
  <div class="c">
    <span class="eyebrow">Egenbehandling</span>
    <h2>Øvelser hjemme</h2>
    <p class="narrow">Hvilke øvelser du får, avhenger av hvor du er i forløpet og hvordan du responderer på behandlingen. Øvelser gis når behandleren mener det er hensiktsmessig og trygt for deg.</p>
    <div class="course two-col">
      <div><b>Helt bra</b><strong>Sjelden behov for mer</strong><p>Blir du helt bra etter behandlingen, trenger du sjelden flere øvelser.</p></div>
      <div><b>Henger igjen</b><strong>Trening hjelper</strong><p>Henger svimmelheten eller ustøheten igjen, er det lurt med vestibulær rehabilitering, øyetrening og balanseøvelser.</p></div>
    </div>
    <h3 class="sub-h">Kan jeg gjøre manøveren selv?</h3>
    <p class="narrow">Noen ganger, når buegang og side er kjent og du har fått vist manøveren.</p>
    <div class="self">
      <div class="box">
        <h3>Det kan passe når</h3>
        <ul>
          <li>du er undersøkt og vet hvilken buegang og side det gjelder</li>
          <li>du har fått vist manøveren og fått beskjed om at du kan gjøre den selv</li>
          <li>svimmelheten kommer tilbake på samme måte som før</li>
        </ul>
      </div>
      <div class="box not">
        <h3>Vent og få hjelp hvis</h3>
        <ul>
          <li>du ikke vet hvilken side eller buegang det gjelder</li>
          <li>svimmelheten er ny, annerledes eller ikke henger sammen med bevegelser</li>
          <li>du har nakkeplager, nedsatt bevegelighet eller er redd for å falle</li>
        </ul>
      </div>
    </div>
    <p class="more"><a class="tlink" href="/ovelsesbibliotek/">Til øvelsesbiblioteket</a> <a class="tlink" href="/ovelsesbibliotek/vestibular-rehab/">Vestibulær rehabilitering og balanse</a></p>
  </div>
</section>

<section>
  <div class="c">
    <span class="eyebrow">Etter behandlingen</span>
    <h2>De første dagene</h2>
    <div class="self">
      <div class="box">
        <h3>Vanlig og ufarlig</h3>
        <ul>
          <li>Du kan kjenne deg ustø, «rar i hodet» eller litt kvalm i noen timer eller dager.</li>
          <li>Noen kjenner seg verre rett etter behandlingen. Det går som regel over.</li>
          <li>Du kan bevege deg som normalt. Du trenger ikke sove sittende eller unngå bestemte stillinger.</li>
        </ul>
      </div>
      <div class="box">
        <h3>Ta kontakt igjen hvis</h3>
        <ul>
          <li>den typiske snurringen kommer tilbake når du legger deg ned eller snur deg</li>
          <li>du fortsatt er ustø etter noen uker, selv om snurringen er borte</li>
          <li>svimmelheten endrer seg eller blir verre</li>
        </ul>
      </div>
    </div>
    <div class="cards">
      {articles.map((a) => (
        <div class="card"><span class="k">{a.k}</span><h3>{a.title}</h3><p>{a.text}</p><a class="tlink" href={a.href}>Les artikkelen</a></div>
      ))}
    </div>
    <div class="warn">
      <div class="ic" aria-hidden="true">!</div>
      <div>
        <h3>Når du skal kontakte lege</h3>
        <p>Er svimmelheten konstant, kommer den med hørselstap, eller henger den ikke sammen med bevegelser av hodet, kontakt lege eller legevakt (116 117). Ring 113 ved lammelser, ansiktsskjevhet, talevansker, dobbeltsyn, besvimelse eller plutselig kraftig hodepine.</p>
      </div>
    </div>
  </div>
</section>

<section class="white">
  <div class="c narrow">
    <span class="eyebrow">Spørsmål og svar</span>
    <h2>Det mange lurer på</h2>
    <div class="faq">
      {faq.map((f, i) => (
        <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </div>
</section>

<section class="navyS">
  <div class="c">
    <span class="eyebrow">Bestill time</span>
    <h2>Få riktig behandling</h2>
    <p>Undersøkelse og behandling tar 40 minutter, og du får som regel behandling i samme time.</p>
    <a class="btn onnavy" href="/fa-hjelp/#bestill">Bestill time →</a>
  </div>
</section>

  </div>
</Layout>

<script>
(function () {
  const SNS = "http://www.w3.org/2000/svg";
  const g = document.getElementById("bhd-crystals");
  const cap = document.getElementById("bhd-cap");
  const stepsEl = document.getElementById("bhd-steps");
  const play = document.getElementById("bhd-play");
  if (!g || !cap || !stepsEl || !play) return;
  const reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cx = 170, cy = 104, r = 66;
  // Vinkler i grader (0 = høyre, 90 = ned). Forenklet prinsipp, ikke anatomisk Epley.
  const S: { a: number | null; label: string; t: string }[] = [
    { a: 95, label: "Før behandling", t: "Krystallene ligger i bunnen av buegangen og gir svimmelhet når du legger deg ned." },
    { a: 150, label: "Steg 1", t: "Hodet vris og legges bakover. Krystallene ruller et stykke rundt buegangen. Det kan snurre." },
    { a: 230, label: "Steg 2", t: "Hodet snus til andre siden. Krystallene fortsetter over toppen." },
    { a: 320, label: "Steg 3", t: "Du ruller over på siden. Krystallene nærmer seg åpningen." },
    { a: 400, label: "Steg 4", t: "Du setter deg rolig opp. Krystallene glir ut av buegangen." },
    { a: null, label: "Hjemme", t: "Krystallene er tilbake i utriculus, der de ikke lenger gir svimmelhet." },
  ];
  const offs = [-7, 0, 7, -3, 4];
  const dots = offs.map((_, i) => {
    const c = document.createElementNS(SNS, "circle");
    c.setAttribute("r", i % 2 ? "3.4" : "4.2");
    c.setAttribute("fill", "#5fc1d6");
    c.setAttribute("stroke", "#fff");
    c.setAttribute("stroke-width", "1");
    g.appendChild(c);
    return c;
  });
  let cur = { a: 95, home: 0 };
  let raf = 0;
  let timer = 0;
  function place(a: number, home: number) {
    dots.forEach((d, i) => {
      const aa = ((a + offs[i] * 1.3) * Math.PI) / 180;
      const x = cx + r * Math.cos(aa), y = cy + r * Math.sin(aa);
      const hx = 78 + i * 9, hy = 196 + (i % 2 ? 6 : -4);
      d.setAttribute("cx", (x + (hx - x) * home).toFixed(1));
      d.setAttribute("cy", (y + (hy - y) * home).toFixed(1));
    });
  }
  function go(i: number) {
    const s = S[i];
    const from = { ...cur };
    const to = { a: s.a === null ? 400 : s.a, home: s.a === null ? 1 : 0 };
    const t0 = performance.now();
    cap!.innerHTML = "<b>" + s.label + "</b>" + s.t;
    Array.from(stepsEl!.children).forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
    cancelAnimationFrame(raf);
    (function f(now: number) {
      const k = reduce ? 1 : Math.min(1, (now - t0) / 900);
      const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
      cur = { a: from.a + (to.a - from.a) * e, home: from.home + (to.home - from.home) * e };
      place(cur.a, cur.home);
      if (k < 1) raf = requestAnimationFrame(f);
    })(t0);
  }
  S.forEach((s, i) => {
    const b = document.createElement("button");
    b.type = "button";
    b.textContent = s.label;
    b.setAttribute("aria-pressed", String(i === 0));
    b.addEventListener("click", () => {
      clearTimeout(timer);
      if (i === 0) cur = { a: 95, home: 0 };
      go(i);
    });
    stepsEl.appendChild(b);
  });
  place(95, 0);
  play.addEventListener("click", () => {
    clearTimeout(timer);
    cur = { a: 95, home: 0 };
    let i = 0;
    go(0);
    (function next() {
      i++;
      if (i < S.length) timer = window.setTimeout(() => { go(i); next(); }, reduce ? 600 : 1500);
    })();
  });
})();
</script>

<style is:global>
.bhd{--white:#fff;--muted:rgba(22,56,117,.62);--shadow:0 8px 24px rgba(22,56,117,.07);color:var(--ink);background:var(--sky)}
.bhd .c{max-width:1120px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.bhd .narrow{max-width:720px}
.bhd h1{font-size:clamp(2rem,4.6vw,3rem);line-height:1.1;text-wrap:balance}
.bhd h2{font-size:clamp(1.5rem,3vw,2.1rem);line-height:1.18;margin-bottom:14px;text-wrap:balance}
.bhd h3{font-size:19px;line-height:1.3;margin:0}
.bhd p{font-size:1.08rem;line-height:1.65;color:var(--ink-soft);margin:0}
.bhd p+p{margin-top:14px}
.bhd b,.bhd strong{color:var(--navy)}
.bhd .eyebrow{font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:14px;display:block}
.bhd section{padding:76px 0}
@media(max-width:700px){.bhd section{padding:52px 0}}
.bhd .white{background:var(--white)}
.bhd .btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:15px;padding:13px 22px;border-radius:999px;border:0;background:var(--navy-2);color:var(--white);text-decoration:none}
.bhd .tlink{font-weight:700;color:var(--navy);border-bottom:2px solid var(--turquoise);padding-bottom:2px;text-decoration:none}
.bhd button:focus-visible,.bhd a:focus-visible,.bhd summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.bhd .more{margin-top:22px;font-size:16px;display:flex;flex-wrap:wrap;gap:12px 24px}

.bhd .hero{background:linear-gradient(var(--beige),var(--sky));padding:56px 0 0}
.bhd .crumbs{font-size:13.5px;color:var(--muted);margin-bottom:24px}
.bhd .crumbs a{color:var(--navy-2);font-weight:600;text-decoration:none}
.bhd .hero .lead{margin:18px 0 0;max-width:660px}
.bhd .facts{display:grid;grid-template-columns:repeat(3,1fr);background:var(--white);border-radius:20px;box-shadow:var(--shadow);margin-top:40px;transform:translateY(36px)}
.bhd .facts div{padding:22px 24px;border-left:1px solid var(--line);min-width:0}
.bhd .facts div:first-child{border-left:0}
.bhd .facts b{display:block;font-family:var(--font-display);font-size:28px;line-height:1.1;font-variant-numeric:tabular-nums}
.bhd .facts strong{display:block;color:var(--navy);font-size:15.5px;margin:2px 0}
.bhd .facts span{font-size:14px;color:var(--ink-soft)}
@media(max-width:700px){.bhd .facts{grid-template-columns:1fr}.bhd .facts div{border-left:0;border-top:1px solid var(--line)}.bhd .facts div:first-child{border-top:0}}
.bhd .afterhero{padding-top:108px}

.bhd .two{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
@media(max-width:860px){.bhd .two{grid-template-columns:1fr;gap:24px}}
.bhd .two>*{min-width:0}
.bhd .pull{font-family:var(--font-display);font-size:22px;line-height:1.4;color:var(--navy);border-left:3px solid var(--turquoise);padding-left:20px;margin-top:16px}

.bhd .model{background:var(--navy);border-radius:22px;padding:24px;display:grid;gap:14px}
.bhd .model svg{width:100%;max-width:380px;height:auto;display:block;margin:0 auto}
.bhd .model .cap{color:rgba(255,255,255,.85);font-size:15px;text-align:center;min-height:48px}
.bhd .model .cap b{color:var(--turquoise);display:block;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:2px}
.bhd .steps{display:flex;justify-content:center;gap:6px;flex-wrap:wrap}
.bhd .steps button{font-family:inherit;font-size:13.5px;font-weight:700;color:var(--white);background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.2);border-radius:999px;padding:8px 13px;cursor:pointer}
.bhd .steps button[aria-pressed="true"]{background:var(--white);color:var(--navy);border-color:var(--white)}
.bhd .play{display:flex;justify-content:center}

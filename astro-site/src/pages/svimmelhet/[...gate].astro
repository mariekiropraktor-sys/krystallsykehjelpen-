---
import Layout from "../../layouts/Layout.astro";
import MarieStripe from "../../components/MarieStripe.astro";
import { safeFetch } from "../../lib/safeFetch";
import { svimmelhetPreviewClient, isPreviewingSvimmelhetDrafts } from "../../lib/svimmelhetPreviewClient";

// Oversiktssiden /svimmelhet/ skal gi en EKTE 404 (ingen fil i det hele
// tatt i det statiske bygget) så lenge svimmelhetPage ikke er publisert med
// visible: true. Astro har ingen "vis/skjul"-mekanisme for en helt fast
// side (uten dynamisk segment) — en fil i src/pages/ blir alltid bygget.
//
// Løsningen: et REST-parameter-segment, [...gate].astro (ETT par
// klammer — testet direkte mot denne Astro-versjonens rutematching, se
// node_modules/astro/dist/core/routing/manifest/create.js: den forstår kun
// `[navn]` og `[...navn]`, IKKE en dobbel-klamme `[[...navn]]`-variant, som
// feiler i build med "parameter name must match..."). Når getStaticPaths()
// returnerer én oppføring med `gate: undefined`, bygges nøyaktig
// `/svimmelhet/index.html` og ingenting mer (siden ingen andre oppføringer
// returneres, fanger denne routen aldri opp `/svimmelhet/krystallsyke/`
// eller `/svimmelhet/[slug]/`, som er egne, mer spesifikke ruter). Når
// getStaticPaths() returnerer en TOM liste, bygges ingen fil i det hele
// tatt på /svimmelhet/ — ekte 404, og siden havner heller ikke i en
// eventuell sitemap. `gate`-parameteren brukes ikke til noe utover dette.
export async function getStaticPaths() {
  try {
    const doc = await svimmelhetPreviewClient.fetch(`*[_id == "svimmelhetPage" && visible == true][0]{_id}`);
    if (!doc) return [];
    return [{ params: { gate: undefined } }];
  } catch (error) {
    console.warn("[svimmelhet/[...gate]] Kunne ikke sjekke synlighet:", error);
    return [];
  }
}

const bookingUrl =
  "https://psno-patient-platform-fe.svc.pasientsky.no/embedded/planner/booking?serviceProviderId=54907264-049e-11eb-8fc8-26c6f94d64b7";

const hp = await safeFetch(
  `*[_id == "svimmelhetPage"][0]{
    seoTitle, seoDescription, heroEyebrow, heroHeading, heroLead,
    safetyHeading, safetyText,
    wizardHeading, wizardIntro, wizardFooterText,
    diagnosesHeading,
    balanceHeading, balanceIntro, balanceItems,
    otherCausesHeading, otherCausesIntro, otherCausesItems,
    faq, ctaHeading, ctaText
  }`,
  {},
  {},
  svimmelhetPreviewClient,
);

const diagnoses = await safeFetch(
  `*[_type == "diagnosisPage" && defined(slug.current)] | order(order asc) {
    title, hasOwnPage, ownPagePath, "slug": slug.current,
    cardShortDescription, cardChips, cardWizardQuote, cardImage
  }`,
  {},
  [],
  svimmelhetPreviewClient,
);

function diagnosisHref(d) {
  return d.hasOwnPage && d.ownPagePath ? d.ownPagePath : `/svimmelhet/${d.slug}/`;
}

const seoTitle = hp.seoTitle ?? "Svimmelhet: årsaker, typer og behandling | Krystallsykehjelpen";
const seoDescription =
  hp.seoDescription ??
  "Snurrer det, gynger det eller er du ustø? Få oversikt over de vanligste formene for svimmelhet og finn ut hva som hjelper.";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Hjem", item: "https://www.krystallsykehjelpen.no/" },
    { "@type": "ListItem", position: 2, name: "Svimmelhet", item: "https://www.krystallsykehjelpen.no/svimmelhet/" },
  ],
};

const faqItems = hp.faq ?? [];
const faqLd = faqItems.length && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout title={seoTitle} description={seoDescription} activePath="/svimmelhet/" hideMarie>
  {isPreviewingSvimmelhetDrafts && (
    <div class="preview-banner">Forhåndsvisning (upubliserte utkast er synlige — kun lokalt)</div>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <div class="breadcrumb">
    <div class="container"><a href="/">Forside</a> / Svimmelhet</div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">{hp.heroEyebrow ?? "Svimmelhet"}</span>
      <h1>{hp.heroHeading ?? "Svimmelhet: finn ut hva som skjer, og hva som hjelper"}</h1>
      <p class="lead">
        {hp.heroLead ?? "Svimmelhet er et symptom, ikke en diagnose. Det kan kjennes som at rommet snurrer, at du gynger, eller at du er ustø på beina. Årsaken avgjør hvilken behandling som hjelper. Her får du oversikt over de vanligste formene."}
      </p>
      <div class="hero-ctas">
        <a href="#veiviser" class="btn btn-primary">Finn din type svimmelhet ↓</a>
        <a href="/fa-hjelp/" class="text-link">Få hjelp</a>
      </div>
    </div>
  </section>

  <!-- SIKKERHETSBOKS -->
  <div class="container safety-wrap">
    <div class="warning-box">
      <div class="warning-icon">!</div>
      <div>
        <h3>{hp.safetyHeading ?? "Ring 113 ved plutselig svimmelhet sammen med andre nye symptomer"}</h3>
        <p>
          {hp.safetyText ?? "Det gjelder for eksempel lammelser eller nummenhet, skjev munn, talevansker, dobbeltsyn, store problemer med å stå eller gå, eller plutselig, kraftig hodepine. Ved plutselig hørselstap på ett øre: kontakt fastlege eller legevakt (116 117) samme dag."}
        </p>
      </div>
    </div>
  </div>

  <!-- VEIVISER -->
  <section id="veiviser">
    <div class="container">
      <span class="eyebrow">Veiviser</span>
      <h2>{hp.wizardHeading ?? "Hvordan kjennes svimmelheten?"}</h2>
      <p class="narrow">
        {hp.wizardIntro ?? "Velg beskrivelsen som ligner mest på det du opplever. Dette er ikke en diagnose, men et godt sted å begynne å lese."}
      </p>
      {diagnoses.length ? (
        <div class="wizard-grid">
          {diagnoses.filter((d) => d.cardWizardQuote).map((d) => (
            <a href={diagnosisHref(d)} class="wizard-card">
              <q>{d.cardWizardQuote}</q>
              <div class="wizard-to">{d.title} <span>→</span></div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">Ingen diagnoser publisert ennå.</p>
      )}
      <p class="fine-print">
        {hp.wizardFooterText ?? "Kjenner du deg ikke igjen, eller er det flere som passer? Få hjelp med å finne ut av det"}
      </p>
    </div>
  </section>

  <!-- DIAGNOSEKORT -->
  {diagnoses.length ? (
    <section class="section-sky">
      <div class="container">
        <span class="eyebrow">Diagnoser</span>
        <h2>{hp.diagnosesHeading ?? "De vanligste formene for svimmelhet"}</h2>
        <div class="diagnosis-grid">
          {diagnoses.map((d) => (
            <a href={diagnosisHref(d)} class="diagnosis-card">
              <div class="diagnosis-body">
                <h3>{d.title}</h3>
                {d.cardShortDescription && <p>{d.cardShortDescription}</p>}
                {d.cardChips?.length ? (
                  <div class="chip-row">
                    {d.cardChips.map((chip) => <span class="chip">{chip}</span>)}
                  </div>
                ) : null}
                <span class="text-link">Les mer →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <!-- BALANSESYSTEMET -->
  <section>
    <div class="container balance-grid">
      <div>
        <span class="eyebrow">Slik fungerer balansen</span>
        <h2>{hp.balanceHeading ?? "Hvorfor blir man svimmel?"}</h2>
        <p>
          {hp.balanceIntro ?? "Hjernen bygger opp balansen din av signaler fra flere kilder samtidig. Når én av dem sender feil informasjon, eller signalene ikke stemmer overens, oppstår svimmelhet."}
        </p>
        <ul class="balance-list">
          {(hp.balanceItems ?? []).map((item) => (
            <li><strong>{item.title}</strong> {item.text}</li>
          ))}
        </ul>
      </div>
      <div class="balance-diagram" aria-hidden="true">
        <svg viewBox="0 0 420 320">
          <circle cx="210" cy="160" r="58" fill="var(--navy)" />
          <text x="210" y="166" text-anchor="middle" class="svg-label-lg">Hjernen</text>
          <g stroke="var(--turquoise)" stroke-width="2.5" stroke-dasharray="5 6">
            <line x1="92" y1="62" x2="165" y2="120" />
            <line x1="328" y1="62" x2="255" y2="120" />
            <line x1="210" y1="290" x2="210" y2="220" />
          </g>
          <circle cx="78" cy="52" r="44" fill="var(--sky)" />
          <text x="78" y="49" text-anchor="middle" class="svg-label-sm">Indre</text>
          <text x="78" y="66" text-anchor="middle" class="svg-label-sm">øre</text>
          <circle cx="342" cy="52" r="44" fill="var(--sky)" />
          <text x="342" y="57" text-anchor="middle" class="svg-label-sm">Øynene</text>
          <circle cx="210" cy="276" r="40" fill="var(--beige)" />
          <text x="210" y="273" text-anchor="middle" class="svg-label-sm">Nakke</text>
          <text x="210" y="290" text-anchor="middle" class="svg-label-sm">og kropp</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ANDRE ÅRSAKER -->
  <section class="section-beige">
    <div class="container">
      <span class="eyebrow">Andre årsaker</span>
      <h2>{hp.otherCausesHeading ?? "Svimmelhet kan også ha andre årsaker"}</h2>
      <p class="narrow">
        {hp.otherCausesIntro ?? "Noen årsaker hører hjemme hos fastlegen eller øre-nese-hals-lege. Er du usikker, er fastlegen alltid et godt første sted."}
      </p>
      <div class="other-grid">
        {(hp.otherCausesItems ?? []).map((item) => (
          <div class="other-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {faqItems.length ? (
    <section>
      <div class="container narrow">
        <span class="eyebrow">Spørsmål og svar</span>
        <h2>Vanlige spørsmål om svimmelhet</h2>
        <div class="faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <!-- CTA -->
  <section class="navy-section final-cta">
    <div class="container">
      <h2>{hp.ctaHeading ?? "Usikker på hva slags svimmelhet du har?"}</h2>
      <p>{hp.ctaText ?? "En grundig undersøkelse gir svar på hva som skjer, og hva som hjelper."}</p>
      <div class="hero-ctas center">
        <a href={bookingUrl} class="btn btn-beige">Bestill time →</a>
        <a href="/fa-hjelp/" class="btn btn-ghost-navy">Få hjelp</a>
      </div>
    </div>
  </section>

  <MarieStripe bg="beige" />
</Layout>

<style>
  .preview-banner {
    background: var(--beige); color: var(--navy-2); text-align: center; padding: 8px;
    font-size: 0.82rem; font-weight: 700;
  }
  .breadcrumb { background: var(--sky); padding: 14px 0; font-size: 0.85rem; color: var(--ink-soft); }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .hero { background: linear-gradient(var(--beige), var(--sky)); padding: 72px 0 56px; }
  .eyebrow { font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 12px; display: inline-block; }
  .hero h1 { margin-bottom: 16px; }
  .lead { font-size: 1.05rem; line-height: 1.65; color: var(--ink-soft); max-width: 62ch; margin: 0 0 26px; }
  .hero-ctas { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .hero-ctas.center { justify-content: center; }
  .text-link { color: var(--navy); font-weight: 700; border-bottom: 2px solid var(--turquoise); padding-bottom: 2px; text-decoration: none; }

  .safety-wrap { margin-top: -32px; position: relative; margin-bottom: 8px; }
  .warning-box {
    background: #fff; border: 1.5px solid var(--navy-2); border-radius: var(--radius); padding: 28px 30px;
    display: flex; gap: 18px; box-shadow: 0 8px 24px rgba(22, 56, 117, 0.08);
  }
  @media (max-width: 600px) { .warning-box { flex-direction: column; } }
  .warning-icon {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: var(--navy-2); color: #fff;
    display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 600; font-size: 1.2rem;
  }
  .warning-box h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .warning-box p { font-size: 0.95rem; color: var(--ink-soft); margin: 0; }
  .warning-box p strong, .warning-box p b { color: var(--navy); }

  .narrow { max-width: 720px; }

  .wizard-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 30px; }
  @media (max-width: 760px) { .wizard-grid { grid-template-columns: 1fr; } }
  .wizard-card {
    background: #fff; border-radius: var(--radius); padding: 24px; box-shadow: 0 8px 24px rgba(22, 56, 117, 0.06);
    border: 1px solid transparent; display: flex; flex-direction: column; gap: 10px; text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .wizard-card:hover { border-color: var(--turquoise); transform: translateY(-2px); }
  .wizard-card q { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.4; color: var(--navy); font-weight: 500; quotes: "«" "»"; }
  .wizard-to { margin-top: auto; padding-top: 8px; font-size: 0.9rem; font-weight: 700; color: var(--navy-2); display: flex; justify-content: space-between; border-top: 1px solid var(--line); }
  .fine-print { font-size: 0.9rem; margin-top: 18px; color: var(--ink-soft); }
  .empty-state { color: var(--ink-soft); margin-top: 24px; }

  .section-sky { background: var(--sky); padding: 64px 0; }
  .section-beige { background: var(--beige); padding: 64px 0; }

  .diagnosis-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 30px; }
  @media (max-width: 760px) { .diagnosis-grid { grid-template-columns: 1fr; } }
  .diagnosis-card { border-radius: var(--radius); background: #fff; box-shadow: 0 8px 24px rgba(22, 56, 117, 0.06); overflow: hidden; text-decoration: none; display: block; }
  .diagnosis-body { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .diagnosis-body h3 { color: var(--navy); }
  .diagnosis-body p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-soft); margin: 0; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: 0.78rem; font-weight: 600; color: var(--navy); background: var(--sky); border-radius: 999px; padding: 5px 12px; }
  .diagnosis-card .chip { background: var(--sky); }

  .balance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  @media (max-width: 860px) { .balance-grid { grid-template-columns: 1fr; gap: 28px; } }
  .balance-list { margin-top: 18px; list-style: none; display: grid; gap: 12px; padding: 0; }
  .balance-list li { position: relative; padding-left: 26px; font-size: 1rem; line-height: 1.55; color: var(--ink-soft); }
  .balance-list li::before { content: ""; position: absolute; left: 0; top: 8px; width: 11px; height: 11px; border-radius: 50%; background: var(--turquoise); }
  .balance-list strong { color: var(--navy); }
  .balance-diagram { background: #fff; border-radius: var(--radius); box-shadow: 0 8px 24px rgba(22, 56, 117, 0.06); padding: 28px; }
  .balance-diagram svg { width: 100%; height: auto; display: block; }
  .svg-label-lg { font-family: var(--font-display); font-size: 19px; fill: #fff; font-weight: 600; }
  .svg-label-sm { font-family: var(--font-body); font-size: 13.5px; font-weight: 700; fill: var(--navy); }

  .other-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 30px; }
  @media (max-width: 860px) { .other-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .other-grid { grid-template-columns: 1fr; } }
  .other-card { background: #fff; border-radius: var(--radius-sm); padding: 20px 22px; }
  .other-card h3 { font-size: 1rem; margin-bottom: 6px; }
  .other-card p { font-size: 0.9rem; line-height: 1.55; color: var(--ink-soft); }

  .faq-list details { border-bottom: 1px solid var(--line); padding: 20px 0; }
  .faq-list summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    gap: 16px; font-weight: 600; color: var(--navy); font-size: 1.02rem;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: "+"; font-size: 1.3rem; color: var(--accent); flex-shrink: 0; }
  .faq-list details[open] summary::after { content: "–"; }
  .faq-list p { margin-top: 12px; font-size: 0.95rem; color: var(--ink-soft); }

  .navy-section { background: var(--navy); color: #fff; }
  .navy-section h2 { color: #fff; }
  .navy-section p { color: rgba(255, 255, 255, 0.82); }
  .final-cta { padding: 64px 0; text-align: center; }
  .final-cta p { max-width: 58ch; margin: 0 auto 28px; }
  .btn-beige { background: var(--beige); color: var(--navy); }
  .btn-ghost-navy { background: transparent; border: 1.5px solid rgba(255, 255, 255, 0.5); color: #fff; }
  .btn-ghost-navy:hover { background: rgba(255, 255, 255, 0.1); }
</style>

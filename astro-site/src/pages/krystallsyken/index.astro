---
import Layout from "../../layouts/Layout.astro";
import { getPageSections } from "../../lib/pageSections";
import { urlForImage } from "../../lib/sanityImage";

// Kun hero-illustrasjonen (bilde A) er koblet til Sanity, slik prompten ber
// om — resten av siden er ny, godkjent tekst fra mockupen og er derfor
// hardkodet direkte i komponenten, ikke hentet fra pageSection-dokumenter.
const sections = await getPageSections("krystallsyken");
const heroImage = urlForImage(sections.hero?.mediaAsset, 1200) ?? "/ear-diagram.jpg";

const bookingUrl =
  "https://psno-patient-platform-fe.svc.pasientsky.no/embedded/planner/booking?serviceProviderId=54907264-049e-11eb-8fc8-26c6f94d64b7";

const factItems = [
  { title: "Korte anfall", desc: "Ofte under ett minutt" },
  { title: "Stillingsutløst", desc: "Kommer ved bestemte bevegelser" },
  { title: "Kan behandles", desc: "Med en tilpasset manøver" },
];

const symptomCards = [
  { title: "Når du snur deg i sengen", desc: "Korte, kraftige anfall — ofte tydeligst mot én side." },
  { title: "Når du legger deg eller reiser deg", desc: "Svimmelheten kommer gjerne noen sekunder etter bevegelsen." },
  { title: "Når du ser opp eller bøyer deg", desc: "Bestemte hodeposisjoner kan utløse den samme snurringen." },
  { title: "Ustøhet og kvalme etterpå", desc: "Mange kjenner seg utrygge eller «sjøsyke» mellom anfallene." },
];

const canalCards = [
  { tag: "Vanligst", title: "Bakre buegang", desc: "Undersøkes ofte med Dix-Hallpike eller sideleietest.", rx: 30, ry: 28, w: 90, h: 70 },
  { tag: "Kraftig ved vending", title: "Horisontal buegang", desc: "Kan gi kraftig svimmelhet ved vending i sengen. Undersøkes med liggende rulletest.", rx: 42, ry: 18, w: 100, h: 60 },
  { tag: "Sjeldnere", title: "Fremre buegang", desc: "Kan være vanskeligere å skille fra andre nystagmusmønstre.", rx: 20, ry: 38, w: 70, h: 90 },
];

const causesList = [
  "Økende alder",
  "Hodeskade",
  "Sykdom i det indre øret",
  "Mulig sammenheng med migrene",
  "Mulig sammenheng med benskjørhet",
  "Lave vitamin D-nivåer",
];

const diagSteps = [
  { title: "Sykehistorie", desc: "Hva utløser svimmelheten?" },
  { title: "Posisjonstester", desc: "Dix-Hallpike og liggende rulletest" },
  { title: "Tolkning", desc: "Side, buegang og variant" },
  { title: "Ny test", desc: "Kontroll av responsen etter manøveren" },
];

const remainingSymptomCauses = [
  "fortsatt aktiv BPPV",
  "en annen vestibulær tilstand",
  "vestibulær migrene",
  "PPPD (vedvarende postural-perseptuell svimmelhet)",
  "andre nevrologiske eller medisinske årsaker",
];

const faqItems = [
  {
    q: "Er krystallsyke farlig?",
    a: "Nei, krystallsyke er i seg selv ufarlig, selv om anfallene kan oppleves dramatiske. Det er likevel viktig å skille det fra andre, mer alvorlige årsaker til svimmelhet.",
  },
  {
    q: "Går krystallsyke over av seg selv?",
    a: "Hos noen avtar symptomene gradvis av seg selv over dager til uker, men en målrettet manøver gir som regel raskere og mer forutsigbar bedring.",
  },
  {
    q: "Kan begge ørene rammes?",
    a: "Ja, selv om det er mest vanlig at kun ett øre er rammet om gangen. Begge sider kan i noen tilfeller være involvert samtidig eller ved ulike episoder.",
  },
  {
    q: "Hjelper Epley mot all krystallsyke?",
    a: "Nei. Epley er effektiv ved bestemte varianter i bakre buegang, men andre varianter og buegang krever andre manøvrer.",
  },
  {
    q: "Hvorfor er jeg fortsatt ustø?",
    a: "Restsvimmelhet er vanlig en periode etter behandling. Vedvarende plager bør likevel undersøkes, siden andre tilstander også kan bidra.",
  },
  {
    q: "Bør jeg ta vitamin D?",
    a: "Lave vitamin D-nivåer har vært satt i sammenheng med krystallsyke hos noen, men dette bør vurderes individuelt og gjerne i samråd med lege.",
  },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Hjem", item: "https://www.krystallsykehjelpen.no/" },
    { "@type": "ListItem", position: 2, name: "Krystallsyken", item: "https://www.krystallsykehjelpen.no/krystallsyken/" },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title="Krystallsyke (BPPV): symptomer og behandling"
  description="Hva er krystallsyke, hvilke symptomer er typiske, og hvordan behandles BPPV? Les om bueganger, testing, Epleys manøver og tilbakefall."
  activePath="/krystallsyken/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Krystallsyke (BPPV)</span>
        <h1>Krystallsyke: Når verden plutselig begynner å snurre</h1>
        <p class="lead">Krystallsyke gir korte anfall av snurrende svimmelhet når hodet beveges i bestemte retninger. Det kan oppleves dramatisk, men tilstanden kan som regel undersøkes presist og behandles med en målrettet manøver.</p>
        <div class="hero-actions">
          <a href={bookingUrl} class="btn btn-primary">Bestill time →</a>
          <a href="#symptomer" class="link-arrow">Forstå symptomene ↓</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-img-frame">
          <img src={heroImage} alt="Anatomisk illustrasjon av det indre øret med balanseorganet og buegangene" width="900" height="906" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. FAKTABÅND -->
  <div class="fact-strip-wrap">
    <div class="container">
      <div class="fact-strip">
        {factItems.map((item) => (
          <div class="fact-item">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="fact-strip-spacer"></div>
  </div>

  <!-- 3+4. HVA SKJER I ØRET + ANIMASJON -->
  <section id="symptomer-forstaa">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="eyebrow">01 · Forstå tilstanden</span>
          <h2>Hva skjer egentlig i det indre øret?</h2>
        </div>
        <div>
          <p class="pull-quote">Små kalkpartikler som normalt ligger i utriculus, kan løsne og komme inn i en av de væskefylte buegangene.</p>
          <p>Når hodet beveges, kan partiklene forskyve væsken i buegangen på en måte som ikke passer med den faktiske bevegelsen. Hjernen mottar da motstridende informasjon fra balanseorganene, synet og resten av kroppen — noe som kan oppleves som en intens rotasjonsfølelse.</p>
          <p>Man skiller gjerne mellom <strong>canalolithiasis</strong>, hvor partiklene beveger seg fritt i væsken, og <strong>cupulolithiasis</strong>, hvor partiklene sitter fast på cupula. Skillet har betydning for hvilket symptommønster som oppstår og hvilken manøver som er mest relevant.</p>
          <a href="#buegangene" class="link-arrow">Se de ulike buegangene →</a>
        </div>
      </div>

      <div class="media-frame">
        <video
          id="krystallsyke-video"
          controls
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Animasjon som viser hvordan løse kalkpartikler beveger seg i buegangen og skaper feilsignaler om rotasjon"
        >
          <source src="/videos/krystallsyke%20animasjon.mp4" type="video/mp4" />
        </video>
        <p class="media-caption"><strong>Se hva som skjer:</strong> Animasjonen viser hvordan løse partikler kan bevege seg i buegangen og gi feil signaler om rotasjon.</p>
      </div>
    </div>
  </section>

  <!-- 5. SYMPTOMER -->
  <section class="section-beige" id="symptomer">
    <div class="container">
      <span class="eyebrow">Vanlige kjennetegn</span>
      <h2>Slik oppleves krystallsyke</h2>
      <div class="symptom-grid">
        {symptomCards.map((card, i) => (
          <div class="symptom-card">
            <div class="symptom-num">{i + 1}</div>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </div>
        ))}
      </div>
      <p class="symptom-note">Selve snurreanfallet er vanligvis kort, ofte under ett minutt, mens kvalme og ustøhet kan vare noe lenger etterpå.</p>
    </div>
  </section>

  <!-- 6. FARESIGNALER -->
  <section>
    <div class="container">
      <div class="warning-box">
        <div class="warning-icon">!</div>
        <div>
          <span class="eyebrow warning-eyebrow">Viktig å vite</span>
          <h3>Når det ikke bør forklares som krystallsyke</h3>
          <p>Søk akutt medisinsk hjelp ved ny svimmelhet sammen med:</p>
          <ul>
            <li>lammelser eller tydelig kraftsvikt</li>
            <li>talevansker</li>
            <li>dobbeltsyn</li>
            <li>ny og kraftig hodepine</li>
            <li>uttalt koordinasjonsvansker</li>
            <li>plutselig manglende evne til å gå</li>
            <li>redusert bevissthet eller besvimelse</li>
          </ul>
          <p class="no-margin">Nyoppstått hørselstap, vedvarende kraftig svimmelhet eller et mønster som ikke er tydelig stillingsutløst, bør også vurderes av lege.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. DE TRE BUEGANGENE -->
  <section class="navy-section" id="buegangene">
    <div class="container">
      <span class="eyebrow">Riktig funn · riktig behandling</span>
      <h2>Det er ikke én manøver som passer for alle</h2>
      <p class="navy-lead">Side, buegang og nystagmusmønster avgjør hvilken behandling som er mest relevant.</p>

      <div class="canal-grid">
        {canalCards.map((card) => (
          <div class="canal-card">
            <div class="canal-media">
              <svg width={card.w} height={card.h} viewBox={`0 0 ${card.w} ${card.h}`} fill="none" aria-hidden="true">
                <ellipse cx={card.w / 2} cy={card.h / 2} rx={card.rx} ry={card.ry} stroke="var(--turquoise)" stroke-width="3" />
              </svg>
            </div>
            <span class="canal-tag">{card.tag}</span>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </div>
        ))}
      </div>
      <p class="canal-note">Illustrasjonene er dekorative. Endelig side bør bruke en kvalitetssikret anatomisk figur.</p>
    </div>
  </section>

  <!-- 8. HVORFOR FÅR MAN KRYSTALLSYKE -->
  <section>
    <div class="container">
      <span class="eyebrow">Bakgrunn</span>
      <h2>Hvorfor får man krystallsyke?</h2>
      <p class="section-lead">Mange som får krystallsyke har ingen tydelig utløsende årsak. Enkelte faktorer ser ut til å gjøre det noe mer sannsynlig, uten at det betyr en sikker årsakssammenheng:</p>
      <div class="cause-list">
        {causesList.map((cause) => (
          <div class="cause-item"><span class="cause-dot"></span><p>{cause}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. DIAGNOSTIKK -->
  <section class="sky-section">
    <div class="container">
      <div class="two-col two-col-center">
        <div>
          <span class="eyebrow">Undersøkelse</span>
          <h2>Øyebevegelsene viser vei</h2>
          <p class="mt">Posisjonstester brukes for å fremkalle et mønster som passer med en bestemt side og buegang.</p>
          <p>VNG-briller kan gjøre det lettere å se, forstørre og dokumentere nystagmus. Brillene er et nyttig hjelpemiddel — det avgjørende er korrekt testing og klinisk tolkning av øyebevegelsene.</p>
          <a href="#behandling" class="link-arrow">Slik behandles krystallsyke →</a>
        </div>
        <div class="diag-steps">
          {diagSteps.map((step, i) => (
            <div class="diag-step">
              <div class="diag-num">{i + 1}</div>
              <div><h3>{step.title}</h3><p>{step.desc}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 10+11. BEHANDLING + EGENBEHANDLING -->
  <section id="behandling">
    <div class="container">
      <span class="eyebrow">Behandling</span>
      <h2>Målrettet – ikke tilfeldig</h2>
      <p class="section-lead mt">En reposisjoneringsmanøver fører hodet gjennom bestemte stillinger for å flytte partiklene ut av buegangen. Behandlingen må tilpasses hvilken buegang og variant som er funnet.</p>
      <p class="pull-quote">«Epley er svært nyttig ved riktig variant – men er ikke løsningen på all krystallsyke.»</p>
      <p class="section-lead">Epley og Semont kan være aktuelle ved varianter i bakre buegang. Gufoni eller barbecue-roll kan være aktuelt ved horisontale varianter, mens fremre buegang krever en tilpasset manøver. Mange opplever tydelig bedring etter én eller noen få behandlinger, mens enkelte trenger gjentatte eller andre manøvrer.</p>

      <div class="self-treatment">
        <h3>Kan jeg gjøre Epleys manøver selv?</h3>
        <p class="mt section-lead">Egenbehandling kan være aktuelt når diagnosen og riktig side er kjent. Epley passer ikke for alle typer krystallsyke, og ved usikkerhet bør manøveren først gjennomgås med en behandler.</p>
        <a href="/ovelsesbibliotek/bakre-buegang/" class="link-arrow">Se øvelsene for bakre buegang →</a>
      </div>
    </div>
  </section>

  <!-- 12. ETTER BEHANDLING -->
  <section class="section-beige">
    <div class="container">
      <span class="eyebrow">Etter behandling</span>
      <h2>Når snurringen er borte, men kroppen fortsatt føles ustø</h2>

      <div class="two-col two-col-top mt-lg">
        <div>
          <p>Noen blir symptomfrie med én gang. Andre kjenner mild ustøhet, kvalme eller en «svaiende» følelse i dager eller uker etter en vellykket manøver.</p>
          <div class="info-box">
            <p class="info-box-lead">Vedvarende symptomer kan skyldes:</p>
            <ul>
              {remainingSymptomCauses.map((cause) => <li>{cause}</li>)}
            </ul>
          </div>
          <a href="/blogg/restsvimmelhet-etter-krystallsyke/" class="link-arrow mt">Les om restsvimmelhet →</a>
        </div>
        <div class="side-media">
          <div class="side-media-frame">
            {/* TODO: sett inn bilde om restsvimmelhet/balanse her (4:5-format) — mangler foreløpig, må lastes opp av Marie */}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 13. TILBAKEFALL -->
  <section>
    <div class="container">
      <span class="eyebrow">Å være obs på</span>
      <h2>Krystallsyke kan komme tilbake</h2>
      <p class="section-lead mt">Tilbakefall er ikke uvanlig, også etter vellykket behandling. Et nytt anfall sitter ikke nødvendigvis i samme øre eller buegang som tidligere — det bør derfor undersøkes på nytt hver gang.</p>
      <p class="section-lead">Symptomer som endrer karakter, varer lenge, eller ikke lenger virker tydelig stillingsutløst, bør alltid vurderes på nytt av en behandler.</p>
    </div>
  </section>

  <!-- OM MARIE / KLINIKKEN -->
  <section>
    <div class="container">
      <div class="two-col two-col-center">
        <div class="marie-media">
          <img src="/marie-portrait.jpg" alt="Marie Hermansen, kiropraktor hos Krystallsykehjelpen" />
        </div>
        <div>
          <span class="eyebrow">Hvem står bak</span>
          <h2>Undersøkt av kiropraktor med erfaring på krystallsyke</h2>
          <p class="mt">Krystallsykehjelpen er utviklet av kiropraktor Marie Hermansen, som har jobbet spesialisert med svimmelhet og krystallsyke i over ti år. Vi bruker VNG-briller og målrettede posisjonstester på klinikken i Fetsund for å finne riktig side, buegang og behandling.</p>
          <p class="no-margin">Møt Marie — se «Om Krystallsykehjelpen».</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 14. FAQ -->
  <section class="sky-section">
    <div class="container">
      <span class="eyebrow center">Ofte stilte spørsmål</span>
      <h2 class="center">Det mange lurer på</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 15. AVSLUTTENDE CTA -->
  <section class="navy-section final-cta">
    <div class="container">
      <span class="eyebrow center">Få hjelp</span>
      <h2>Få undersøkt svimmelheten</h2>
      <p>En målrettet undersøkelse kan avklare om symptomene passer med krystallsyke, hvilken side og buegang som er rammet, og hvilken behandling som er mest relevant.</p>
      <a href={bookingUrl} class="btn btn-primary btn-on-navy">Bestill time →</a>
      <small>Svimmelhetsundersøkelse hos kiropraktor Marie Hermansen i Fetsund.</small>
    </div>
  </section>
</Layout>

<script>
  const video = document.getElementById("krystallsyke-video");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (video instanceof HTMLVideoElement && !prefersReducedMotion) {
    video.play().catch(() => {});
  }
</script>

<style>
  :root { color-scheme: light; }

  section { padding: 88px 0; }
  @media (max-width: 640px) { section { padding: 56px 0; } }

  .eyebrow {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); display: block; margin-bottom: 1rem;
  }
  .eyebrow.center { text-align: center; }
  .lead { font-size: 1.15rem; margin-top: 20px; max-width: 520px; color: var(--ink-soft); }
  .section-lead { max-width: 680px; color: var(--ink-soft); }
  .no-margin { margin: 0; }
  .no-margin-bottom { margin-bottom: 0; }
  .mt { margin-top: 16px; }
  .mt-lg { margin-top: 32px; }
  .center { text-align: center; }

  .link-arrow {
    display: inline-flex; align-items: center; gap: 8px; font-weight: 600;
    color: var(--navy); border-bottom: 1.5px solid var(--turquoise); padding-bottom: 2px;
    text-decoration: none; width: fit-content;
  }
  .link-arrow:hover { color: var(--accent); }

  .btn-on-navy { background: #fff; color: var(--navy); }

  /* HERO */
  .hero { background: linear-gradient(180deg, var(--beige) 0%, var(--sky) 100%); padding: 96px 0 0; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; gap: 36px; } }
  .hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; margin-top: 32px; }
  .hero-media {
    background: #fff; border-radius: 28px; box-shadow: 0 12px 32px rgba(22, 56, 117, 0.08);
    padding: 28px; display: flex; align-items: center; justify-content: center;
  }
  .hero-img-frame {
    width: 100%; aspect-ratio: 1 / 1; border-radius: 20px; background: var(--sky);
    position: relative; overflow: hidden;
  }
  .hero-img-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }

  /* FAKTABÅND */
  .fact-strip-wrap { background: var(--sky); padding-bottom: 0; }
  .fact-strip {
    background: #fff; border-radius: 20px; box-shadow: 0 8px 24px rgba(22, 56, 117, 0.06);
    display: grid; grid-template-columns: repeat(3, 1fr); margin-top: -56px; position: relative; z-index: 2;
  }
  @media (max-width: 720px) { .fact-strip { grid-template-columns: 1fr; } }
  .fact-item { padding: 32px 28px; border-right: 1px solid var(--line); }
  .fact-item:last-child { border-right: none; }
  @media (max-width: 720px) {
    .fact-item { border-right: none; border-bottom: 1px solid var(--line); }
    .fact-item:last-child { border-bottom: none; }
  }
  .fact-item h3 { font-size: 1.2rem; margin-bottom: 6px; }
  .fact-item p { margin: 0; font-size: 0.98rem; color: var(--ink-soft); }
  .fact-strip-spacer { height: 56px; background: var(--sky); }

  /* TWO-COL */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .two-col-center { align-items: center; }
  .two-col-top { align-items: start; }
  @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; gap: 28px; } }
  .pull-quote {
    font-family: var(--font-display); font-weight: 500; font-size: 1.5rem; color: var(--navy-2);
    line-height: 1.4; border-left: 3px solid var(--turquoise); padding-left: 24px; margin: 8px 0 28px;
  }

  /* VIDEO */
  .media-frame { background: var(--sky); border-radius: 28px; padding: 20px; margin-top: 48px; }
  .media-frame video { width: 100%; display: block; border-radius: 20px; object-fit: contain; background: var(--sky); }
  .media-caption { font-size: 0.95rem; color: var(--ink-soft); margin-top: 14px; padding: 0 4px; }
  .media-caption strong { color: var(--navy); }

  /* SYMPTOM CARDS */
  .section-beige { background: var(--beige); }
  .symptom-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  @media (max-width: 960px) { .symptom-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .symptom-grid { grid-template-columns: 1fr; } }

---
import Layout from "../layouts/Layout.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { safeFetch } from "../lib/safeFetch";
import { urlForImage } from "../lib/sanityImage";
import { MARIE_URL } from "../config/marie";


const bookingUrl =
  "https://psno-patient-platform-fe.svc.pasientsky.no/embedded/planner/booking?serviceProviderId=54907264-049e-11eb-8fc8-26c6f94d64b7";

// "Siste artikler" — henter dynamisk fra Sanity (blogPost), viser de 3
// nyeste. Bruker den vanlige offentlige klienten (ikke blogPreviewClient) —
// forsiden skal aldri vise upubliserte utkast.
const latestPosts = await safeFetch(
  `*[_type == "blogPost"] | order(publishedDate desc)[0...3]{
    title, "slug": slug.current, excerpt, category, publishedDate, coverImage
  }`,
  {},
  [],
);

function formatDate(dateString) {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("nb-NO", { year: "numeric", month: "long", day: "numeric" });
}

// «Hva kjenner du deg igjen i?» – kortene er skrevet med ordene folk faktisk
// søker på, og lenker til publiserte artikler som svarer på søket.
const journeyCards = [
  {
    title: "Svimmel når du snur deg i sengen?",
    desc: "Det typiske mønsteret ved krystallsyke, og når du bør søke hjelp.",
    href: "/blogg/svimmel-nar-du-snur-deg-i-sengen/",
  },
  {
    title: "Øvelser du kan gjøre hjemme",
    desc: "Epley, Semont, BBQ-rull og flere, med film og steg for steg.",
    href: "/blogg/krystallsyke-5-ovelser-som-hjelper/",
  },
  {
    title: "Fortsatt svimmel etter behandling?",
    desc: "Restsvimmelhet er vanlig, og betyr ikke at behandlingen har mislyktes.",
    href: "/blogg/restsvimmelhet-etter-krystallsyke/",
  },
  {
    title: "Svimmel av skjerm eller i butikken?",
    desc: "Visuell svimmelhet: mulige årsaker og hvordan den kan trenes bort.",
    href: "/blogg/svimmel-i-butikker-eller-av-skjerm/",
  },
];
---

<Layout
  title="Krystallsyke og svimmelhet | Krystallsykehjelpen"
  description="Trygg kunnskap om krystallsyke og svimmelhet: symptomer, øvelser og behandling. Faglig kvalitetssikret av kiropraktor Marie Hermansen."
  activePath="/"
  hideMarie
>
  <!-- 1. Hero – logo sentrert, minimalistisk -->
  <section class="hero">
    <div class="container hero-inner">
      <picture>
        <source srcset="/logo/krystallsykehjelpen-logo-512.webp" type="image/webp" />
        <img
          src="/logo/krystallsykehjelpen-logo-512.png"
          alt="Krystallsykehjelpen-logo: det indre øret med buegangene og sneglehuset"
          width="196"
          height="196"
          loading="eager"
          fetchpriority="high"
          class="hero-logo"
        />
      </picture>
      <span class="eyebrow">Krystallsyke og svimmelhet</span>
      <h1>Trygg kunnskap når verden <em>plutselig snurrer</em></h1>
      <p class="lead">Forstå svimmelheten din. Finn riktig behandling, øvelser og hjelp fra fagpersoner.</p>
      <div class="hero-ctas">
        <a href="/svimmelhet/" class="btn hero-btn-primary">Jeg er svimmel</a>
        <a href="/fa-hjelp/" class="btn hero-btn-secondary">Finn behandling</a>
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,32 C360,72 1080,0 1440,32 L1440,60 L0,60 Z" fill="#ffffff" />
    </svg>
  </section>

  <!-- 1b. Søk + faglig ansvarlig (flyttet ut av heroen) -->
  <section class="hero-trust" aria-label="Søk og faglig ansvarlig">
    <div class="container hero-trust-inner">
      <div class="hero-trust-search">
        <label class="hero-trust-label" for="hero-sok">Søk i kunnskapsbasen</label>
        <form class="search-box" action="/sok/" method="get" role="search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          <input id="hero-sok" type="text" name="q" placeholder="Symptom, diagnose eller øvelse" />
          <button type="submit" class="search-btn">Søk</button>
        </form>
      </div>
      <span class="hero-trust-divider" aria-hidden="true"></span>
      <a href={MARIE_URL} class="hero-byline">
        <picture>
          <source srcset="/marie-hermansen-240.webp" type="image/webp" />
          <img src="/marie-hermansen-240.jpg" alt="" width="72" height="72" loading="lazy" class="hero-byline-photo" />
        </picture>
        <span>
          <span class="hero-byline-name">Marie Hermansen, kiropraktor</span>
          Særlig kompetanse innen krystallsyke og svimmelhet
          <span class="hero-byline-more">Møt Marie →</span>
        </span>
      </a>
    </div>
  </section>

  <!-- 2. Hva kjenner du deg igjen i? -->
  <section class="section-alt no-top">
    <div class="container">
      <div class="section-head">
        <h2>Hva kjenner du deg igjen i?</h2>
        <hr class="heading-rule" />
      </div>
      <div class="journey-grid">
        {journeyCards.map((card) => (
          <a href={card.href} class="card journey-card">
            <div class="card-body">
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
              <span class="card-link">Les mer →</span>
            </div>
          </a>
        ))}
      </div>
      <p class="journey-more"><a href="/ovelsesbibliotek/" class="card-link">Se hele øvelsesbiblioteket →</a></p>

      <div class="hjemme-section">
        <div class="hjemme-content">
          <span class="eyebrow">Krystallsykehjelpen hjemme</span>
          <h3>Få hjelp hjemme, steg for steg</h3>
          <p>Har du fått påvist krystallsyke? Videoveiledninger, manøvrer og hva du kan forvente etter behandling.</p>
          <a href="/hjemme/" class="btn btn-primary">Start her</a>
        </div>
        <div class="hjemme-visual">
          <img
            src="/forsiden-hjemme.jpg"
            alt="Illustrasjon av en person som hjelper partneren sin med hodeposisjonering hjemme, med en videokonsultasjon med en fagperson synlig på en bærbar PC i bakgrunnen"
            class="hjemme-photo"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Siste artikler -->
  <section class="section-alt">
    <div class="container">
      <div class="section-head">
        <h2>Siste artikler</h2>
        <hr class="heading-rule" />
      </div>
      {latestPosts.length ? (
        <div class="card-grid articles-grid">
          {latestPosts.map((post) => (
            <a href={`/blogg/${post.slug}/`} class="card article-card">
              {urlForImage(post.coverImage, 640) ? (
                <img src={urlForImage(post.coverImage, 640)} alt={post.title} class="article-cover" />
              ) : (
                <MediaPlaceholder label={post.title} />
              )}
              <div class="card-body">
                {post.category && <span class="category-badge">{post.category}</span>}
                {post.publishedDate && <span class="post-date">{formatDate(post.publishedDate)}</span>}
                <h3>{post.title}</h3>
                {post.excerpt && <p>{post.excerpt}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p>Ingen artikler publisert ennå.</p>
      )}
      <p class="mt"><a href="/blogg/" class="card-link">Se alle artikler →</a></p>
    </div>
  </section>

</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero { background: var(--beige); padding: 52px 0 76px; position: relative; overflow: hidden; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; max-width: 760px; }
  .hero-logo { display: block; width: 196px; height: 196px; margin-bottom: 24px; }
  .eyebrow { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--navy-2); font-weight: 700; margin-bottom: 12px; display: inline-block; }
  .hero h1 {
    color: var(--navy-deep); font-weight: 500; font-size: clamp(2.1rem, 4.2vw, 3.25rem);
    line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 16px; text-wrap: balance;
  }
  /* Dempet kursiv: navy-2 i stedet for klar accent-blå. */
  .hero h1 em { font-style: italic; font-weight: 400; color: var(--navy-2); }
  .lead { font-size: 1.12rem; line-height: 1.6; color: var(--ink-soft); max-width: 44ch; margin: 0 0 28px; text-wrap: balance; }
  .hero-wave { position: absolute; bottom: -2px; left: 0; width: 100%; height: 44px; line-height: 0; }

  .hero-ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .hero-btn-primary { background: var(--navy); color: #fff; }
  .hero-btn-primary:hover { background: var(--navy-deep); box-shadow: 0 6px 18px rgba(22, 56, 117, 0.25); }
  .hero-btn-secondary { background: transparent; color: var(--navy); border: 1.5px solid rgba(22, 56, 117, 0.6); }
  .hero-btn-secondary:hover { border-color: var(--navy); background: rgba(255, 255, 255, 0.5); }
  .hero-ctas .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  @media (max-width: 640px) {
    .hero { padding: 28px 0 50px; }
    .hero-logo { width: 120px; height: 120px; margin-bottom: 16px; }
    .eyebrow { font-size: 0.7rem; margin-bottom: 8px; }
    .hero h1 { font-size: 1.95rem; margin-bottom: 12px; }
    .lead { font-size: 1rem; margin-bottom: 22px; }
    /* Knappene side om side på mobil, så heroen holdes lav. */
    .hero-ctas { flex-wrap: nowrap; width: 100%; gap: 10px; }
    .hero-ctas .btn { flex: 1; padding-left: 12px; padding-right: 12px; justify-content: center; text-align: center; }
  }

  /* ---------- Søk + faglig ansvarlig ---------- */
  .hero-trust { background: var(--paper); padding: 28px 0 56px; }
  .hero-trust-inner { max-width: 960px; display: grid; grid-template-columns: 1.25fr auto 1fr; gap: 32px; align-items: center; }
  .hero-trust-search { min-width: 0; }
  .hero-trust-label {
    display: block; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-soft); font-weight: 700; margin-bottom: 10px;
  }
  .hero-trust-divider { width: 1px; align-self: stretch; background: var(--line); }
  .hero-byline { display: flex; align-items: center; gap: 16px; text-decoration: none; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.45; }
  .hero-byline picture { flex-shrink: 0; }
  .hero-byline-photo { display: block; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 12px rgba(22, 56, 117, 0.12); }
  .hero-byline-name { display: block; font-family: var(--font-display); font-size: 1.08rem; font-weight: 500; color: var(--navy); }
  .hero-byline-more { display: block; margin-top: 2px; color: var(--navy-2); font-weight: 600; font-size: 0.86rem; }
  .hero-byline:hover .hero-byline-more { text-decoration: underline; }

  @media (max-width: 640px) {
    .hero-trust { padding: 20px 0 40px; }
    .hero-trust-inner { grid-template-columns: 1fr; gap: 20px; }
    .hero-trust-divider { width: 100%; height: 1px; align-self: auto; }
    .hero-byline-photo { width: 60px; height: 60px; }
  }

  .search-box {
    display: flex; align-items: center; gap: 10px; background: #fff;
    border: 1.5px solid var(--line); border-radius: 999px; padding: 5px 5px 5px 16px;
    box-shadow: 0 8px 24px rgba(22, 56, 117, 0.06); width: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-box:focus-within { border-color: var(--accent); box-shadow: 0 8px 28px rgba(47, 121, 201, 0.18); }
  .search-box svg { flex-shrink: 0; color: var(--ink-soft); }
  .search-box input {
    border: none; outline: none; flex: 1; font-family: var(--font-body);
    font-size: 0.92rem; color: var(--navy); background: transparent; padding: 8px 0; min-width: 0;
  }
  .search-btn {
    background: var(--navy); color: #fff; border: none; border-radius: 999px;
    padding: 10px 18px; font-family: var(--font-body); font-weight: 600; font-size: 0.86rem;
    cursor: pointer; flex-shrink: 0;
  }

  .section-alt { background: var(--paper); padding: 60px 0; }
  .section-alt.no-top { padding-top: 0; padding-bottom: 70px; }
  section { padding: 60px 0; }

  .section-head { max-width: 62ch; margin-bottom: 36px; }
  .section-alt.no-top .section-head { text-align: center; margin-left: auto; margin-right: auto; }
  .section-alt.no-top .section-head .heading-rule { margin-left: auto; margin-right: auto; }

  .journey-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 960px) { .journey-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .journey-grid { grid-template-columns: 1fr; gap: 10px; }
    /* Mobil: bare tittel + lenke, så seksjonen holdes kort. */
    .journey-card p { display: none; }
  }
  .journey-more { text-align: center; margin: 22px 0 0; }

  .hjemme-section {
    background: var(--beige); border-radius: var(--radius); padding: 56px;
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center;
    margin-top: 40px;
  }
  .hjemme-content .eyebrow { font-size: 0.78rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--navy-2); font-weight: 700; margin: 0 0 14px; display: block; }
  .hjemme-content h3 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 2.8vw, 2.1rem); line-height: 1.15; margin: 0 0 16px; color: var(--navy); }
  .hjemme-content p { font-size: 1rem; line-height: 1.6; color: var(--ink-soft); margin: 0 0 28px; max-width: 46ch; }
  .hjemme-visual {
    position: relative; background: var(--sky); border-radius: var(--radius-sm);
    box-shadow: 0 16px 36px rgba(22, 56, 117, 0.08); overflow: hidden;
  }
  .hjemme-photo { width: 100%; height: 100%; display: block; aspect-ratio: 4/3.1; object-fit: cover; border-radius: var(--radius-sm); }
  .hjemme-content .btn {
    width: auto; white-space: nowrap; display: inline-flex;
  }
  @media (max-width: 860px) {
    .hjemme-section { grid-template-columns: 1fr; padding: 32px 24px; border-radius: var(--radius); gap: 28px; }
    .hjemme-content p { max-width: none; }
    .hjemme-visual { order: 2; }
    .hjemme-photo { aspect-ratio: 16/11; }
    .hjemme-content { order: 1; }
  }
  .journey-card {
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; display: block; transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 12px 28px rgba(22, 56, 117, 0.06);
  }
  .journey-card:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(22, 56, 117, 0.1); }
  .journey-card .card-body { padding: 24px; }
  .journey-card h3 { font-size: 1.12rem; line-height: 1.25; margin: 0 0 8px; text-wrap: balance; }
  .journey-card p { font-size: 0.88rem; margin: 0 0 12px; color: var(--ink-soft); }

  .icon-circle {
    width: 52px; height: 52px; border-radius: 50%; background: var(--sky);
    display: flex; align-items: center; justify-content: center; margin-bottom: 14px;
  }
  .icon-circle svg { width: 26px; height: 26px; color: var(--navy-2); }
  .card-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.9rem; text-decoration: none; color: var(--navy-2); margin-top: 4px; }
  .mt { margin-top: 20px; }

  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 860px) { .card-grid { grid-template-columns: 1fr; } }
  .card {
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; box-shadow: 0 18px 36px rgba(22, 56, 117, 0.08);
    text-decoration: none; display: block; transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: 0 22px 44px rgba(22, 56, 117, 0.12); }
  .article-cover { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .card-body { padding: 22px; }
  .card-body h3 { margin: 4px 0 8px; }
  .card-body p { margin: 0; color: var(--ink-soft); }
  .post-date { font-size: 0.8rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; }
  .category-badge {
    display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 3px 10px;
    border-radius: 999px; background: var(--sky); color: var(--navy-2); margin-bottom: 6px; margin-right: 6px;
  }

</style>

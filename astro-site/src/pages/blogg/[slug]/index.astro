---
import Layout from "../../../layouts/Layout.astro";
import { safeFetch } from "../../../lib/safeFetch";
import { blogPreviewClient, isPreviewingDrafts } from "../../../lib/blogPreviewClient";
import { blocksToHtml, extractHeadings, estimateReadingTime } from "../../../lib/portableText";
import { urlForImage } from "../../../lib/sanityImage";
import Forfattersignatur from "../../../components/Forfattersignatur.astro";

export async function getStaticPaths() {
  try {
    // blogPreviewClient: i lokal dev med skrivetoken ser denne også
    // drafts.*-utkast (nødvendig for å kunne forhåndsvise upubliserte
    // artikler i det hele tatt) — i en faktisk build faller den tilbake til
    // den vanlige offentlige klienten og ser kun publiserte innlegg.
    const posts = await blogPreviewClient.fetch(
      `*[_type == "blogPost" && defined(slug.current)]{ "slug": slug.current }`,
    );
    return posts.map((p) => ({ params: { slug: p.slug } }));
  } catch (error) {
    console.warn("[blogg/[slug]] Kunne ikke hente stier fra Sanity:", error);
    return [];
  }
}

const { slug } = Astro.params;

const QUERY = `*[_type == "blogPost" && slug.current == $slug][0]{
  title, publishedDate, excerpt, category, shortSummary, keyFacts, warningBox,
  body[]{
    ...,
    _type == "exerciseVideo" => {
      "exercises": exercises[]->{
        title, side, "slug": slug.current,
        "groupSlug": coalesce(category->slug.current, habitueringSeksjon),
        "video": mediaFile.asset->url
      }
    }
  },
  faq, sources, relatedLinks, coverImage, coverImageAlt, metaTitle, metaDescription,
  "author": author->{ name }
}`;

const post = await safeFetch(QUERY, { slug }, null, blogPreviewClient);

function formatDate(dateString) {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("nb-NO", { year: "numeric", month: "long", day: "numeric" });
}

// «Les også»: for lenker til andre artikler henter vi bilde og kategori,
// så kortene kan vise et bilde. Andre lenker (f.eks. /svimmelhet/...) vises
// som kort uten bilde.
const relatedSlugs = (post?.relatedLinks ?? [])
  .map((l) => l.url?.match(/^\/blogg\/([^/]+)\/?$/)?.[1])
  .filter(Boolean);
const relatedPosts = relatedSlugs.length
  ? await safeFetch(
      `*[_type == "blogPost" && slug.current in $slugs]{ "slug": slug.current, category, coverImage }`,
      { slugs: relatedSlugs },
      [],
    )
  : [];
const relatedCards = (post?.relatedLinks ?? []).map((link) => {
  const slugMatch = link.url?.match(/^\/blogg\/([^/]+)\/?$/)?.[1];
  const match = slugMatch ? relatedPosts.find((r) => r.slug === slugMatch) : null;
  return {
    ...link,
    kicker: match ? match.category || "Artikkel" : "Les mer",
    imageUrl: match ? urlForImage(match.coverImage, 640) : undefined,
  };
});

const headings = extractHeadings(post?.body);
const readingTime = estimateReadingTime(post?.body);
const coverUrl = post ? urlForImage(post.coverImage, 1200) : undefined;
const canonicalUrl = post ? `https://www.krystallsykehjelpen.no/blogg/${slug}/` : undefined;

const articleJsonLd = post && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedDate,
  // Forfatter hentes fra Sanity-referansen. Alle fagartikler er skrevet av
  // Marie, så hun er reserve dersom referansen mangler.
  author: {
    "@type": "Person",
    name: post.author?.name || "Marie Hermansen",
    jobTitle: "Kiropraktor",
    url: "https://www.krystallsykehjelpen.no/mott-marie/",
  },
  image: coverUrl,
  mainEntityOfPage: canonicalUrl,
};

const faqJsonLd = post?.faq?.length && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title={post ? `${post.metaTitle || post.title} | Krystallsykehjelpen` : "Blogginnlegg | Krystallsykehjelpen"}
  description={post?.metaDescription || post?.excerpt || "Blogginnlegg fra Krystallsykehjelpen."}
  activePath="/blogg/"
  image={coverUrl}
  hideMarie
>
  {isPreviewingDrafts && (
    <div class="preview-banner">Forhåndsvisning (upubliserte utkast er synlige — kun lokalt)</div>
  )}

  {post ? (
    <>
      {articleJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
      )}
      {faqJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
      )}

      <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>

      <header class="post-hero">
        <div class="container">
          <nav class="crumbs" aria-label="Brødsmuler">
            <a href="/blogg/">Artikler</a>{post.category && <> / <span>{post.category}</span></>}
          </nav>
          <div class={coverUrl ? "post-hero-grid" : "post-hero-grid no-image"}>
            <div class="post-hero-text">
              {post.category && <span class="eyebrow">{post.category}</span>}
              <h1>{post.title}</h1>
              {post.excerpt && <p class="lead">{post.excerpt}</p>}
              <div class="byline">
                <picture>
                  <source srcset="/marie-hermansen-240.webp" type="image/webp" />
                  <img src="/marie-hermansen-240.jpg" alt="" width="44" height="44" />
                </picture>
                <span>
                  <a href="/mott-marie/" class="byline-name">{post.author?.name || "Marie Hermansen"}, kiropraktor</a>
                  <span class="byline-meta">
                    {post.publishedDate && <>{formatDate(post.publishedDate)} · </>}{readingTime} min lesetid
                  </span>
                </span>
              </div>
            </div>
            {coverUrl && (
              <div class="post-hero-image">
                <img src={coverUrl} alt={post.coverImageAlt || post.title} width="1200" height="900" loading="eager" fetchpriority="high" />
              </div>
            )}
          </div>
        </div>
      </header>

      <div class="container article-layout">
        <article class="post-main">
          {post.shortSummary && (
            <div class="summary">
              <span class="box-label">Kort fortalt</span>
              <p>{post.shortSummary}</p>
            </div>
          )}

          {post.keyFacts?.length ? (
            <div class="key-facts">
              {post.keyFacts.map((f) => (
                <div class="key-fact"><b>{f.value}</b><span>{f.label}</span></div>
              ))}
            </div>
          ) : null}

          <div class="post-body" set:html={blocksToHtml(post.body)} />

          {post.warningBox && (
            <aside class="safety" role="note">
              <span class="safety-icon" aria-hidden="true">!</span>
              <div>
                <strong>Når bør du søke rask hjelp?</strong>
                <p>{post.warningBox}</p>
              </div>
            </aside>
          )}

          {post.sources?.length ? (
            <section class="sources">
              <span class="box-label">{post.sources.length === 1 ? "Forskningen bak artikkelen" : "Faglige kilder"}</span>
              <ol>
                {post.sources.map((s) => (
                  <li>
                    <span class="source-label">{s.label}</span>
                    {s.url && <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-link">Les kilden ↗</a>}
                  </li>
                ))}
              </ol>
            </section>
          ) : null}

          {post.faq?.length ? (
            <section class="faq-section">
              <h2>Spørsmål og svar</h2>
              {post.faq.map((item) => (
                <div class="accordion-item">
                  <button class="accordion-trigger" aria-expanded="false">
                    {item.question}
                    <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                  </button>
                  <div class="accordion-panel"><p>{item.answer}</p></div>
                </div>
              ))}
            </section>
          ) : null}

          <Forfattersignatur />
        </article>

        {headings.length > 1 && (
          <aside class="toc">
            <span class="toc-label">Innhold</span>
            <ul>
              {headings.map((h) => (
                <li><a href={`#${h.id}`} data-toc={h.id}>{h.text}</a></li>
              ))}
            </ul>
          </aside>
        )}
      </div>

      {relatedCards.length ? (
        <section class="related">
          <div class="container">
            <h2>Les også</h2>
            <div class="related-grid">
              {relatedCards.map((card) => (
                <a href={card.url} class="related-card">
                  <div class="related-image">
                    {card.imageUrl && <img src={card.imageUrl} alt="" loading="lazy" width="640" height="360" />}
                  </div>
                  <div class="related-text">
                    <small>{card.kicker}</small>
                    <h3>{card.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      <section class="post-cta">
        <div class="container">
          <h2>Usikker på om dette er krystallsyke?</h2>
          <p>Få bekreftet om det er krystallsyke, og hvilken side og buegang som er involvert.</p>
          <a href="/fa-hjelp/" class="btn btn-primary">Få hjelp →</a>
        </div>
      </section>
    </>
  ) : (
    <section class="container not-found">
      <h1>Fant ikke blogginnlegget</h1>
      <p>Dette innlegget finnes ikke, eller er ikke publisert.</p>
      <a href="/blogg/" class="btn btn-primary">Til bloggoversikten</a>
    </section>
  )}
</Layout>

<script>
  // «Øvelse med film»: bytt mellom høyre og venstre side
  document.querySelectorAll(".exercise-video").forEach((box) => {
    const buttons = box.querySelectorAll(".exv-side");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-video");
        const media = box.querySelector(".exv-media");
        if (!media) return;
        media.innerHTML = src
          ? `<video class="exv-video" src="${src}#t=0.1" controls playsinline preload="metadata"></video>`
          : `<div class="exv-soon">Video kommer snart</div>`;
        buttons.forEach((b) => {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-pressed", String(b === btn));
        });
      });
    });
  });

  document.querySelectorAll(".accordion-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const open = btn.closest(".accordion-item")?.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(Boolean(open)));
    });
  });

  // Lesefremdrift: tynn turkis linje øverst som viser hvor langt man har lest
  const bar = document.getElementById("read-progress-bar");
  const article = document.querySelector(".post-main");
  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const done = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${done})`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  // Innholdsfortegnelse: marker avsnittet man leser nå
  const tocLinks = Array.from(document.querySelectorAll("[data-toc]"));
  if (tocLinks.length && "IntersectionObserver" in window) {
    const byId = new Map(tocLinks.map((a) => [a.getAttribute("data-toc"), a]));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          tocLinks.forEach((a) => a.classList.remove("is-active"));
          byId.get(entry.target.id)?.classList.add("is-active");
        });
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>

<style>
  .preview-banner {
    background: #fff3cd; color: #7a5c00; text-align: center; padding: 8px;
    font-size: 0.82rem; font-weight: 700;
  }

  /* Lesefremdrift */
  .read-progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 1000; pointer-events: none; }
  .read-progress span { display: block; height: 100%; background: var(--turquoise); transform: scaleX(0); transform-origin: 0 50%; }

  /* Hero: tekst og bilde side om side, bildet øverst på mobil */
  .post-hero { background: linear-gradient(var(--beige), var(--sky)); padding-block: 28px 56px; }
  .crumbs { font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 26px; }
  .crumbs a { color: var(--navy-2); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .post-hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 44px; align-items: center; }
  .post-hero-grid > * { min-width: 0; }
  .post-hero-grid.no-image { grid-template-columns: 1fr; max-width: 760px; }
  .eyebrow { display: inline-block; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--accent); margin-bottom: 14px; }
  .post-hero h1 { font-size: clamp(1.9rem, 4.2vw, 3rem); line-height: 1.1; text-wrap: balance; margin: 0; }
  .post-hero .lead { font-size: 1.12rem; line-height: 1.6; color: var(--ink-soft); margin: 18px 0 22px; max-width: 56ch; }
  .byline { display: flex; align-items: center; gap: 12px; }
  .byline picture { flex-shrink: 0; display: block; }
  .byline img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; display: block; }
  .byline-name { display: block; font-weight: 600; color: var(--navy); text-decoration: none; font-size: 0.95rem; }
  .byline-name:hover { text-decoration: underline; }
  .byline-meta { display: block; font-size: 0.86rem; color: var(--ink-soft); }
  .post-hero-image { border-radius: 22px; overflow: hidden; box-shadow: 0 20px 50px rgba(22,56,117,0.12); aspect-ratio: 4/3; }
  .post-hero-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 820px) {
    .post-hero-grid { grid-template-columns: 1fr; gap: 24px; }
    .post-hero-image { order: -1; }
  }

  /* Lesekolonne */
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: 56px; align-items: start; padding-block: 44px 56px; }
  @media (max-width: 900px) { .article-layout { grid-template-columns: 1fr; } }
  .post-main { max-width: 680px; min-width: 0; }

  .box-label { display: block; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--accent); margin-bottom: 8px; }
  .summary { background: var(--sky); border-radius: 18px; padding: 22px 24px; margin-bottom: 32px; }
  .summary p { margin: 0; font-size: 1.06rem; line-height: 1.65; color: var(--ink); }

  .key-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: -8px 0 36px; }
  .key-fact { border: 1px solid var(--line); border-radius: 16px; padding: 16px; background: #fff; }
  .key-fact b { display: block; font-family: var(--font-display); font-size: 1.9rem; font-weight: 600; color: var(--navy); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .key-fact span { display: block; margin-top: 6px; font-size: 0.86rem; color: var(--ink-soft); line-height: 1.4; }

  .post-body p { font-size: 1.07rem; line-height: 1.78; margin: 0 0 18px; }
  .post-body h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem); line-height: 1.25; margin: 44px 0 14px; padding-top: 16px;
    position: relative; scroll-margin-top: 100px; text-wrap: balance;
  }
  .post-body h2::before { content: ""; position: absolute; top: 0; left: 0; width: 36px; height: 3px; border-radius: 2px; background: var(--turquoise); }
  .post-body h2:first-child { margin-top: 0; }
  .post-body h3 { font-size: 1.2rem; margin: 30px 0 10px; scroll-margin-top: 100px; }
  .post-body a { color: var(--navy-2); font-weight: 600; text-decoration: underline; text-decoration-color: var(--turquoise); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .post-body a:hover { color: var(--accent); }
  .post-body ul { margin: 0 0 20px; padding-left: 22px; }
  .post-body li { font-size: 1.05rem; line-height: 1.65; color: var(--ink-soft); margin-bottom: 8px; }
  .post-body li::marker { color: var(--turquoise); }
  .post-body blockquote {
    margin: 32px 0; padding: 6px 0 6px 22px; border-left: 3px solid var(--turquoise);
    font-family: var(--font-display); font-style: italic; font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.45; color: var(--navy);
  }

  /* Varselboks: Navy-2 på hvitt, som på krystallsyke-siden (aldri rød) */
  .safety { display: flex; gap: 16px; border: 1.5px solid var(--navy-2); background: #fff; border-radius: 18px; padding: 20px 22px; margin: 36px 0; }
  .safety-icon { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: var(--navy-2); color: #fff; display: grid; place-items: center; font-weight: 700; font-family: var(--font-display); }
  .safety strong { display: block; color: var(--navy); margin-bottom: 4px; }
  .safety p { margin: 0; font-size: 0.98rem; line-height: 1.6; }

  .post-body .checklist-box { background: var(--sky); border-radius: var(--radius); padding: 24px 26px; margin: 28px 0; }
  .post-body .checklist-box h3 { margin: 0 0 14px; font-size: 1.05rem; color: var(--navy); }
  .post-body .checklist-items { list-style: none; margin: 0; padding: 0; }
  .post-body .checklist-items li { display: flex; align-items: flex-start; gap: 12px; font-size: 1rem; line-height: 1.55; color: var(--ink); margin-bottom: 10px; }
  .post-body .checklist-items li:last-child { margin-bottom: 0; }
  .post-body .checklist-mark { flex-shrink: 0; width: 18px; height: 18px; margin-top: 3px; border: 2px solid var(--turquoise); border-radius: 4px; }

  .post-body .fact-box { background: var(--beige); border-radius: var(--radius); padding: 26px; margin: 28px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center; }
  @media (max-width: 640px) { .post-body .fact-box { grid-template-columns: 1fr; } }
  .post-body .fact-box-full { grid-template-columns: 1fr; }
  .post-body .fact-box-label { display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--navy-2); margin-bottom: 8px; }
  .post-body .fact-box-content p { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--ink); }
  .post-body .fact-box-illustration img { width: 100%; border-radius: var(--radius-sm); display: block; }

  .post-body ol { margin: 0 0 20px; padding-left: 24px; }
  .post-body ol li { font-size: 1.02rem; line-height: 1.6; color: var(--ink); margin-bottom: 8px; }
  .post-body .exercise-video { background: var(--sky); border-radius: var(--radius); padding: 20px; margin: 24px 0 36px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .post-body .exv-media { width: 100%; display: flex; justify-content: center; }
  .post-body .exv-video { width: auto; max-width: 100%; max-height: min(70vh, 560px); border-radius: var(--radius-sm); background: #000; display: block; }
  .post-body .exv-soon { width: 100%; max-width: 300px; aspect-ratio: 9/16; max-height: 360px; border-radius: var(--radius-sm); background: #fff; display: grid; place-items: center; font-weight: 700; color: var(--navy-2); }
  .post-body .exv-sides { display: flex; gap: 8px; }
  .post-body .exv-side { font-family: var(--font-body); font-weight: 600; font-size: 0.88rem; border: 1px solid var(--line); background: #fff; color: var(--navy); border-radius: 999px; padding: 7px 14px; cursor: pointer; }
  .post-body .exv-side.is-active { background: var(--navy); color: #fff; border-color: var(--navy); }
  .post-body .exv-links { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .post-body .exv-link { font-weight: 600; color: var(--accent); text-decoration: none; font-size: 0.95rem; }
  .post-body .exv-link:hover { text-decoration: underline; }

  .post-body .warning-box { background: #fff; border: 2px solid var(--navy-2); border-radius: var(--radius-sm); padding: 22px 24px; margin: 28px 0; }
  .post-body .warning-box h3 { margin: 0 0 12px; font-size: 1.05rem; color: var(--navy); }
  .post-body .warning-box ul { margin: 0; padding-left: 20px; }
  .post-body .warning-box li { font-size: 0.98rem; line-height: 1.6; color: var(--ink); margin-bottom: 6px; }
  .post-body .warning-box-callout { background: var(--sky); border-radius: var(--radius-sm); padding: 12px 16px; margin: 16px 0 0; font-size: 0.94rem; font-weight: 600; color: var(--navy); }

  .faq-section { margin: 40px 0; }
  .faq-section h2 { font-size: 1.5rem; margin-bottom: 10px; }
  .accordion-item { border-bottom: 1px solid var(--line); }
  .accordion-item:first-of-type { border-top: 1px solid var(--line); }
  .accordion-trigger {
    width: 100%; text-align: left; background: none; border: none; padding: 16px 4px;
    font-family: var(--font-body); font-weight: 600; font-size: 0.98rem; color: var(--navy);
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
  }
  .accordion-trigger .chev { transition: transform 0.2s ease; flex-shrink: 0; margin-left: 12px; }
  .accordion-item.open .accordion-trigger .chev { transform: rotate(180deg); }
  .accordion-panel { max-height: 0; overflow: hidden; transition: max-height 0.25s ease; }
  .accordion-item.open .accordion-panel { max-height: 300px; }
  .accordion-panel p { padding: 0 4px 16px; margin: 0; color: var(--ink-soft); }


  /* Kilder */
  .sources { background: var(--beige); border-radius: 20px; padding: 22px 24px; margin: 40px 0; }
  .sources ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .sources li { display: flex; flex-direction: column; gap: 6px; }
  .source-label { font-size: 0.94rem; color: var(--ink); line-height: 1.5; }
  .source-link { align-self: flex-start; font-weight: 700; font-size: 0.9rem; color: var(--navy-2); text-decoration: none; border-bottom: 2px solid var(--turquoise); padding-bottom: 1px; }
  .source-link:hover { color: var(--accent); }


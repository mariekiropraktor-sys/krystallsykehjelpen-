---
import Layout from "../../../layouts/Layout.astro";
import MediaPlaceholder from "../../../components/MediaPlaceholder.astro";
import { safeFetch } from "../../../lib/safeFetch";
import { blogPreviewClient, isPreviewingDrafts } from "../../../lib/blogPreviewClient";
import { blocksToHtml, extractHeadings, estimateReadingTime } from "../../../lib/portableText";
import { urlForImage } from "../../../lib/sanityImage";

const bookingUrl =
  "https://psno-patient-platform-fe.svc.pasientsky.no/embedded/planner/booking?serviceProviderId=54907264-049e-11eb-8fc8-26c6f94d64b7";

export async function getStaticPaths() {
  try {
    // blogPreviewClient: i lokal dev med skrivetoken ser denne også
    // drafts.*-utkast (nødvendig for å kunne forhåndsvise upubliserte
    // artikler i det hele tatt) — i en faktisk build faller den tilbake til
    // den vanlige offentlige klienten og ser kun publiserte innlegg.
    const posts = await blogPreviewClient.fetch(
      `*[_type == "blogPost" && defined(slug.current)]{ "slug": slug.current }`,
    );
    return posts.map((p) => ({ params: { slug: p.slug } }));
  } catch (error) {
    console.warn("[blogg/[slug]] Kunne ikke hente stier fra Sanity:", error);
    return [];
  }
}

const { slug } = Astro.params;

const QUERY = `*[_type == "blogPost" && slug.current == $slug][0]{
  title, publishedDate, excerpt, category, shortSummary, body, warningBox,
  faq, sources, relatedLinks, coverImage, metaTitle, metaDescription,
  "author": author->{ name, title, photo }
}`;

const post = await safeFetch(QUERY, { slug }, null, blogPreviewClient);

function formatDate(dateString) {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("nb-NO", { year: "numeric", month: "long", day: "numeric" });
}

const headings = extractHeadings(post?.body);
const readingTime = estimateReadingTime(post?.body);
const coverUrl = post ? urlForImage(post.coverImage, 1200) : undefined;
const canonicalUrl = post ? `https://www.krystallsykehjelpen.no/blogg/${slug}/` : undefined;

const articleJsonLd = post && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedDate,
  author: post.author?.name ? { "@type": "Person", name: post.author.name } : undefined,
  image: coverUrl,
  mainEntityOfPage: canonicalUrl,
};

const faqJsonLd = post?.faq?.length && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title={post ? `${post.metaTitle || post.title} | Krystallsykehjelpen` : "Blogginnlegg | Krystallsykehjelpen"}
  description={post?.metaDescription || post?.excerpt || "Blogginnlegg fra Krystallsykehjelpen."}
  activePath="/blogg/"
>
  {isPreviewingDrafts && (
    <div class="preview-banner">Forhåndsvisning (upubliserte utkast er synlige — kun lokalt)</div>
  )}

  {post ? (
    <>
      {articleJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
      )}
      {faqJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
      )}

      <div class="breadcrumb">
        <div class="container">
          <a href="/blogg/">Blogg</a> / {post.title}
        </div>
      </div>

      <section class="hero">
        <div class="container hero-grid">
          <div>
            {post.category && <span class="badge badge-type">{post.category}</span>}
            <h1>{post.title}</h1>
            {post.excerpt && <p class="lead">{post.excerpt}</p>}
            <div class="meta-row">
              {post.publishedDate && <span class="meta-item">{formatDate(post.publishedDate)}</span>}
              <span class="meta-item">{readingTime} min lesetid</span>
            </div>
          </div>
          <div class="hero-media">
            {coverUrl ? (
              <img src={coverUrl} alt={post.title} class="hero-photo" />
            ) : (
              <MediaPlaceholder label={post.title} />
            )}
          </div>
        </div>
        <svg class="hero-wave" viewBox="0 0 1440 60" preserveAspectRatio="none">
          <path d="M0,32 C360,72 1080,0 1440,32 L1440,60 L0,60 Z" fill="#ffffff" />
        </svg>
      </section>

      <div class="container article-layout">
        <article class="post-main">
          {post.shortSummary && (
            <div class="callout callout-summary">
              <h2>Kort fortalt</h2>
              <p>{post.shortSummary}</p>
            </div>
          )}

          <div class="post-body" set:html={blocksToHtml(post.body)} />

          {post.warningBox && (
            <div class="red-flag">
              <strong>Når bør du søke rask hjelp?</strong> {post.warningBox}
            </div>
          )}

          {post.faq?.length ? (
            <div class="faq-section">
              <h2>Ofte stilte spørsmål</h2>
              {post.faq.map((item) => (
                <div class="accordion-item">
                  <button class="accordion-trigger">
                    {item.question}
                    <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                  </button>
                  <div class="accordion-panel"><p>{item.answer}</p></div>
                </div>
              ))}
            </div>
          ) : null}

          {post.author?.name && (
            <div class="author-row">
              {urlForImage(post.author.photo, 80) && (
                <img src={urlForImage(post.author.photo, 80)} alt={post.author.name} class="author-photo" />
              )}
              <div>
                <strong>Faglig gjennomgått av {post.author.title?.toLowerCase() ?? "kiropraktor"} {post.author.name}</strong>
              </div>
            </div>
          )}

          {post.sources?.length ? (
            <div class="sources">
              <h2>Faglige kilder</h2>
              <ol>
                {post.sources.map((s) => (
                  <li>{s.url ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a> : s.label}</li>
                ))}
              </ol>
            </div>
          ) : null}

          {post.relatedLinks?.length ? (
            <div class="related">
              <h2>Relaterte artikler</h2>
              <div class="related-grid">
                {post.relatedLinks.map((link) => (
                  <a href={link.url} class="related-card">
                    <h3>{link.title}</h3>
                    <span class="rel-arrow">Les mer →</span>
                  </a>
                ))}
              </div>
            </div>
          ) : null}

          <div class="cta-band">
            <h2>Usikker på om dette er krystallsyke?</h2>
            <p>Få bekreftet om det er krystallsyke, og hvilken side og buegang som er involvert.</p>
            <a href={bookingUrl} class="btn cta-btn">Bestill undersøkelse →</a>
          </div>
        </article>

        {headings.length > 1 && (
          <aside class="toc">
            <div class="toc-inner">
              <span class="toc-label">Innhold</span>
              <ul>
                {headings.map((h) => (
                  <li><a href={`#${h.id}`}>{h.text}</a></li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </>
  ) : (
    <section class="container not-found">
      <h1>Fant ikke blogginnlegget</h1>
      <p>Dette innlegget finnes ikke, eller er ikke publisert.</p>
      <a href="/blogg/" class="btn btn-primary">Til bloggoversikten</a>
    </section>
  )}
</Layout>

<script>
  document.querySelectorAll(".accordion-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.closest(".accordion-item")?.classList.toggle("open");
    });
  });
</script>

<style>
  .preview-banner {
    background: #fff3cd; color: #7a5c00; text-align: center; padding: 8px;
    font-size: 0.82rem; font-weight: 700;
  }

  .breadcrumb { background: var(--sky); padding: 14px 0; font-size: 0.85rem; color: var(--ink-soft); }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .hero { padding: 40px 0 70px; position: relative; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 800px) { .hero-grid { grid-template-columns: 1fr; } }
  .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 5px 12px; border-radius: 20px; letter-spacing: 0.02em; margin-bottom: 12px; }
  .badge-type { background: var(--navy); color: #fff; }
  .hero h1 { margin-bottom: 12px; }
  .hero .lead { font-size: 1.05rem; color: var(--ink-soft); }
  .meta-row { display: flex; gap: 18px; margin-top: 16px; flex-wrap: wrap; }
  .meta-item { font-size: 0.85rem; font-weight: 600; color: var(--navy); }
  .hero-media { position: relative; }
  .hero-photo { width: 100%; border-radius: var(--radius); aspect-ratio: 4/3; object-fit: cover; box-shadow: 0 20px 50px rgba(22,56,117,0.12); }
  .hero-wave { position: absolute; bottom: -2px; left: 0; width: 100%; line-height: 0; }

  .article-layout { display: grid; grid-template-columns: 1fr 240px; gap: 48px; align-items: start; padding-bottom: 80px; }
  @media (max-width: 900px) { .article-layout { grid-template-columns: 1fr; } }
  .post-main { max-width: 720px; }

  .callout { background: var(--sky); border-radius: var(--radius); padding: 22px 24px; margin-bottom: 30px; }
  .callout h2 { font-size: 1rem; margin: 0 0 8px; }
  .callout p { margin: 0; color: var(--ink); }

  .post-body p { font-size: 1.02rem; line-height: 1.7; }
  .post-body h2 { font-size: 1.3rem; margin: 32px 0 14px; scroll-margin-top: 100px; }
  .post-body h2:first-child { margin-top: 0; }
  .post-body ul { margin: 0 0 20px; padding-left: 22px; }
  .post-body li { font-size: 1.02rem; line-height: 1.6; color: var(--ink); margin-bottom: 8px; }
  .post-body blockquote {
    background: var(--beige); border-left: 4px solid var(--turquoise); border-radius: var(--radius-sm);
    padding: 20px 24px; margin: 8px 0 28px; font-family: var(--font-display); font-style: italic;
    font-size: 1.08rem; color: var(--navy); line-height: 1.55;
  }

  .red-flag { background: #ffe9eb; color: #7a1720; padding: 16px 18px; border-radius: 8px; margin: 28px 0; }

  .faq-section { margin: 36px 0; }
  .faq-section h2 { font-size: 1.3rem; margin-bottom: 8px; }
  .accordion-item { border-bottom: 1px solid var(--line); }
  .accordion-item:first-of-type { border-top: 1px solid var(--line); }
  .accordion-trigger {
    width: 100%; text-align: left; background: none; border: none; padding: 16px 4px;
    font-family: var(--font-body); font-weight: 600; font-size: 0.98rem; color: var(--navy);
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
  }
  .accordion-trigger .chev { transition: transform 0.2s ease; flex-shrink: 0; margin-left: 12px; }
  .accordion-item.open .accordion-trigger .chev { transform: rotate(180deg); }
  .accordion-panel { max-height: 0; overflow: hidden; transition: max-height 0.25s ease; }
  .accordion-item.open .accordion-panel { max-height: 300px; }
  .accordion-panel p { padding: 0 4px 16px; margin: 0; color: var(--ink-soft); }

  .author-row { display: flex; align-items: center; gap: 12px; margin: 30px 0; padding: 16px; background: var(--sky); border-radius: var(--radius); }
  .author-photo { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .author-row strong { color: var(--navy); font-weight: 600; font-size: 0.92rem; }

  .sources { margin: 30px 0; }
  .sources h2 { font-size: 1.1rem; margin-bottom: 10px; }
  .sources ol { padding-left: 20px; margin: 0; }
  .sources li { font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 6px; line-height: 1.5; }
  .sources a { color: var(--accent); }

  .related { margin: 36px 0; }
  .related h2 { font-size: 1.15rem; margin-bottom: 16px; }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .related-grid { grid-template-columns: 1fr; } }
  .related-card { border: 1px solid var(--line); border-radius: 12px; padding: 16px; text-decoration: none; display: block; }
  .related-card:hover { border-color: var(--navy-2); }
  .related-card h3 { font-size: 0.96rem; color: var(--navy); margin: 0 0 4px; }
  .related-card .rel-arrow { font-size: 0.85rem; color: var(--ink-soft); font-weight: 600; }

  .cta-band { background: var(--navy); color: #fff; text-align: center; padding: 40px 20px; border-radius: 16px; margin: 44px 0 12px; }
  .cta-band h2 { color: #fff; font-size: 1.3rem; margin-bottom: 10px; }
  .cta-band p { color: rgba(255,255,255,0.8); margin-bottom: 20px; font-size: 0.94rem; }
  .cta-btn { background: var(--beige); color: var(--navy); }

  .toc { position: sticky; top: 90px; }
  @media (max-width: 900px) { .toc { display: none; } }
  .toc-inner { border-left: 2px solid var(--line); padding-left: 16px; }
  .toc-label { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent); }
  .toc ul { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .toc a { font-size: 0.86rem; color: var(--ink-soft); text-decoration: none; line-height: 1.4; display: block; }
  .toc a:hover { color: var(--navy); }

  .not-found { padding: 90px 24px; text-align: center; max-width: 520px; }
</style>

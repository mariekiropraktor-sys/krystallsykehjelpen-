---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Om krystallsykehjelpen | Krystallsykehjelpen"
  description="Om krystallsykehjelpen – Krystallsykehjelpen, klinikk for krystallsyke og svimmelhet i Fetsund."
  activePath="/om-oss/"
  hideMarie
>
  <section class="container placeholder">
    <span class="eyebrow">Under bygging</span>
    <h1>Om krystallsykehjelpen</h1>
    <p>Denne siden bygges videre i neste steg – innholdet fra den forrige versjonen flyttes hit med samme komponentstruktur som forsiden.</p>
    <a href="/" class="btn btn-primary">Til forsiden</a>
  </section>
</Layout>

<style>
  .placeholder { padding: 70px 24px 100px; max-width: 640px; }
  .eyebrow { font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
</style>

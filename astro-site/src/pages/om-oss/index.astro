---
// Redirect-side: /om-oss/ → /om-krystallsykehjelpen/. Var tidligere en
// "under bygging"-plassholder for en side som aldri ble ferdigstilt — det
// finnes ikke noe eget Sanity-dokument bak den, kun denne statiske filen.
// Sidefilen er bevisst beholdt (ikke slettet) per oppgavebeskrivelsen, men
// gjort om til en redirect siden /om-krystallsykehjelpen/ er den ekte,
// ferdige siden. Ekte HTTP 301 håndteres av vercel.json i produksjon; denne
// meta-refresh-siden er fallback for lokal dev/preview, der vercel.json
// ikke gjelder.
const target = "/om-krystallsykehjelpen/";
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Omdirigerer …</title>
  </head>
  <body>
    <p>Denne siden har flyttet. Hvis du ikke sendes videre automatisk, <a href={target}>klikk her</a>.</p>
  </body>
</html>

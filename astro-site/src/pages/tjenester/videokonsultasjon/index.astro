---
import Layout from "../../../layouts/Layout.astro";

const bookingUrl =
  "https://psno-patient-platform-fe.svc.pasientsky.no/embedded/planner/booking?serviceProviderId=54907264-049e-11eb-8fc8-26c6f94d64b7";

// Forespørselsmodus: så lenge Marie ikke har satt opp videotimer i kalenderen,
// sender pasienten en forespørsel via skjemaet på siden i stedet for å booke
// direkte. Sett til `false` når videotimer kan bookes i Pasientsky — da
// vises de gamle «Bestill»-knappene igjen og skjemaet skjules.
const visForesporsel = true;
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";

const helpItems = [
  "Veiledning i øvelser og reposisjoneringsmanøvre",
  "Spørsmål etter undersøkelse eller behandling",
  "Bekymringer og usikkerhet rundt svimmelheten",
  "Tilpasning av vestibulær rehabilitering",
];

const steps = [
  visForesporsel
    ? { num: "01", title: "Send en forespørsel", desc: "Velg 40 minutter første gang, eller 20 minutter for en kort oppfølging. Marie tar kontakt innen én virkedag." }
    : { num: "01", title: "Bestill riktig tid", desc: "Velg 40 minutter første gang, eller 20 minutter for en kort oppfølging." },
  { num: "02", title: "Finn et rolig sted", desc: "Ha god plass, stabilt kamera og gjerne en seng eller sofa i nærheten." },
  { num: "03", title: "Få personlig veiledning", desc: "Vi går gjennom spørsmålene dine og øver sammen, steg for steg." },
];

const faqItems = [
  {
    q: "Kan videokonsultasjon erstatte en fysisk undersøkelse?",
    a: "Nei. Video kan brukes til samtale og veiledning, men kan ikke erstatte full klinisk undersøkelse, posisjonstesting, VNG eller annen nødvendig utredning.",
  },
  {
    q: "Hva trenger jeg å ha klart hjemme?",
    a: "Et rolig rom, stabil internettforbindelse, telefon eller datamaskin med kamera, god plass og gjerne en seng eller sofa.",
  },
  {
    q: "Hva hvis jeg blir veldig svimmel underveis?",
    a: "Vi stopper eller tilpasser øvelsen. Dersom manøver er planlagt, bør en annen voksen være til stede for å støtte og hjelpe.",
  },
  {
    q: "Kan jeg bestille uten å ha fått en diagnose?",
    a: "Ved ny, uforklarlig eller annerledes svimmelhet bør pasienten undersøkes fysisk først. Videosamtalen kan ikke brukes til å avkrefte alle andre årsaker.",
  },
];
---

<Layout
  title="Videokonsultasjon | Krystallsykehjelpen"
  description="Videokonsultasjon hos Krystallsykehjelpen — veiledning i øvelser, spørsmål og oppfølging hjemmefra, etter en faglig vurdering."
  activePath="/tjenester/videokonsultasjon/"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Videokonsultasjon</span>
        <h1>Trygg veiledning.<br /><em>Hjemme hos deg.</em></h1>
        <p class="lead">Få personlig hjelp med øvelser, spørsmål og usikkerhet etter svimmelhet eller krystallsyke — i rolige omgivelser hjemme.</p>
        <div class="hero-ctas">
          {visForesporsel ? (
            <a href="#foresporsel" class="btn btn-white">Send forespørsel</a>
          ) : (
            <a href="#pris" class="btn btn-white">Se timer og priser</a>
          )}
          <a href="#hjelp" class="text-link-light">Er dette riktig for meg?</a>
        </div>
      </div>
      <div class="hero-media">
        <img src="/hero-videokonsultasjon.png" alt="Videokonsultasjon med Krystallsykehjelpen" class="hero-photo" />
      </div>
    </div>
  </section>

  <section class="section" id="hjelp">
    <div class="container help-grid">
      <div>
        <h2>Hva kan du få hjelp med?</h2>
        <p class="intro">Det er lett å bli usikker når du skal fortsette på egen hånd. Videokonsultasjonen gir deg tid til å spørre, forstå og øve — uten reisevei og i ditt eget tempo.</p>
      </div>
      <div class="help-list">
        {helpItems.map((text) => (
          <div class="help-item">
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="safety-box">
    <div class="container safety-inner">
      <div>
        <h3>Videoveiledning kommer etter en faglig vurdering</h3>
        <p>Tjenesten er først og fremst for deg som allerede er vurdert av lege, kiropraktor, fysioterapeut eller annet kvalifisert helsepersonell. Ny, uforklarlig eller annerledes svimmelhet bør undersøkes fysisk først.</p>
      </div>
    </div>
  </section>

  <section class="section" id="pris">
    <div class="container">
      <h2 class="center-heading">Tid og pris</h2>
      <div class="price-grid">
        <div class="price-card">
          <span class="mins">20 minutter</span>
          <div class="amount">550 kr</div>
          <div class="subtitle">Kort oppfølging</div>
          <p class="desc">For deg som allerede kjenner øvelsen og trenger noen konkrete avklaringer.</p>
          <ul>
            <li>Ett eller noen få spørsmål</li>
            <li>Kontroll av kjent øvelse</li>
            <li>Mindre justeringer</li>
          </ul>
          {visForesporsel ? (
            <a href="#foresporsel" class="btn btn-primary btn-full" data-type="oppfolging">Send forespørsel</a>
          ) : (
            <a href={bookingUrl} class="btn btn-primary btn-full">Bestill 20 minutter</a>
          )}
        </div>
        <div class="price-card featured">
          <span class="price-badge">Anbefalt første gang</span>
          <span class="mins">40 minutter</span>
          <div class="amount">890 kr</div>
          <div class="subtitle">Grundig veiledning</div>
          <p class="desc">God tid til samtale, spørsmål og trinnvis veiledning i en aktuell manøver.</p>
          <ul>
            <li>Gjennomgang av tidligere funn</li>
            <li>Veiledning steg for steg</li>
            <li>Plan for veien videre</li>
          </ul>
          {visForesporsel ? (
            <a href="#foresporsel" class="btn btn-primary btn-full btn-accent" data-type="forste">Send forespørsel</a>
          ) : (
            <a href={bookingUrl} class="btn btn-primary btn-full btn-accent">Bestill 40 minutter</a>
          )}
        </div>
      </div>
      {visForesporsel && (
        <p class="price-note">Marie tar kontakt innen én virkedag for å avtale tidspunkt.</p>
      )}
    </div>
  </section>

  {visForesporsel && (
    <section class="section request-section" id="foresporsel">
      <div class="container request-container">
        <span class="eyebrow">Forespørsel</span>
        <h2>Er video riktig for deg?</h2>
        <p class="request-lead">Svar på noen korte spørsmål, så ser vi om videokonsultasjon passer, eller om du heller bør undersøkes på klinikken.</p>

        <form id="video-form" class="request-card" novalidate>
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Forespørsel om videokonsultasjon" />
          <input type="hidden" name="from_name" value="Krystallsykehjelpen – videoforespørsel" />
          <input type="hidden" name="Vurdering" id="vurdering" value="" />
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="request-alert" role="note">
            <span class="alert-icon" aria-hidden="true">!</span>
            <p><strong>Ikke send skjema ved akutte symptomer.</strong> Ved nye lammelser, ansiktsskjevhet, talevansker, dobbeltsyn, besvimelse, plutselig kraftig hodepine eller plutselig hørselstap: ring 113. Legevakt: 116 117.</p>
          </div>

          <fieldset>
            <legend>Hva gjelder det?</legend>
            <div class="choices">
              <label class="choice"><input type="radio" name="Timetype" id="type-forste" value="Første time, 40 min" checked /> Første time, 40 min</label>
              <label class="choice"><input type="radio" name="Timetype" id="type-oppfolging" value="Oppfølging, 20 min" /> Oppfølging, 20 min</label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Noen korte spørsmål</legend>
            <div class="question">
              <p>Kommer svimmelheten når du endrer hodestilling, for eksempel når du legger deg ned, snur deg i sengen eller ser opp?</p>
              <div class="choices">
                <label class="choice"><input type="radio" name="Svimmel ved hodebevegelse" id="q1-ja" value="Ja" /> Ja</label>
                <label class="choice"><input type="radio" name="Svimmel ved hodebevegelse" id="q1-nei" value="Nei" /> Nei</label>
                <label class="choice"><input type="radio" name="Svimmel ved hodebevegelse" id="q1-usikker" value="Usikker" /> Usikker</label>
              </div>
            </div>
            <div class="question">
              <p>Varer hvert anfall kortere enn ett minutt?</p>
              <div class="choices">
                <label class="choice"><input type="radio" name="Anfall under ett minutt" id="q2-ja" value="Ja" /> Ja</label>
                <label class="choice"><input type="radio" name="Anfall under ett minutt" id="q2-nei" value="Nei" /> Nei</label>
                <label class="choice"><input type="radio" name="Anfall under ett minutt" id="q2-usikker" value="Usikker" /> Usikker</label>
              </div>
            </div>
            <div class="question">
              <p>Har en lege, kiropraktor eller fysioterapeut undersøkt deg for denne svimmelheten?</p>
              <small>Video passer best når du allerede er vurdert av helsepersonell.</small>
              <div class="choices">
                <label class="choice"><input type="radio" name="Undersøkt av helsepersonell" id="q3-ja" value="Ja" /> Ja</label>
                <label class="choice"><input type="radio" name="Undersøkt av helsepersonell" id="q3-nei" value="Nei" /> Nei</label>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Kontaktinformasjon</legend>
            <div class="field-grid">
              <label class="field">Navn<input type="text" name="name" id="vf-navn" autocomplete="name" required /></label>
              <label class="field">Telefon<input type="tel" name="Telefon" id="vf-tlf" autocomplete="tel" required /></label>
            </div>
            <label class="field">E-post<input type="email" name="email" id="vf-epost" autocomplete="email" required /></label>
            <div class="field">
              <span>Når passer det best?</span>
              <div class="choices">
                <label class="choice"><input type="checkbox" name="Passer best" id="t-formiddag" value="Formiddag" /> Formiddag</label>
                <label class="choice"><input type="checkbox" name="Passer best" id="t-ettermiddag" value="Ettermiddag" /> Ettermiddag</label>
                <label class="choice"><input type="checkbox" name="Passer best" id="t-kveld" value="Kveld" /> Kveld</label>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Vil du fortelle noe mer?</legend>
            <label class="field" for="vf-melding">
              <span>Melding til Marie <span class="optional">(valgfritt)</span></span>
              <textarea name="Melding" id="vf-melding" rows="4" maxlength="1000" placeholder="For eksempel hva du ønsker hjelp med, eller når det passer å bli ringt."></textarea>
            </label>
            <small class="field-hint">Hold det kort. Detaljer om helsen din tar vi heller når Marie ringer.</small>
          </fieldset>

          <label class="consent">
            <input type="checkbox" id="vf-samtykke" />
            <span>Jeg forstår at videokonsultasjon ikke er et akuttilbud, og at Marie tar kontakt for å avtale tid. Jeg skriver ikke inn sensitive helseopplysninger her.</span>
          </label>

          <p id="vf-status" class="form-status" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary">Send forespørsel</button>
        </form>

      </div>
    </section>
  )}

  <section class="helper-section">
    <div class="container helper-grid">
      <div>
        <span class="eyebrow eyebrow-light">Hvis vi skal gjøre en manøver</span>
        <h2>Ha en annen voksen person i nærheten</h2>
        <p>En medhjelper kan støtte deg, hjelpe med hodets plassering og passe på kameraet. Det gir en tryggere og roligere gjennomføring dersom du blir svimmel eller ustø. Ha gjerne seng eller sofa klar.</p>
      </div>
      <div class="helper-visual">
        <div class="helper-avatar a">P</div>
        <div class="helper-avatar b">M</div>
        <div class="helper-avatar c">+1</div>
      </div>
    </div>
  </section>

  <section class="section" id="slik">
    <div class="container">
      <h2 class="center-heading">Slik fungerer det</h2>
      <div class="steps-grid">
        {steps.map((step) => (
          <div class="step">
            <span class="num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-container">
      <h2 class="center-heading">Ofte stilte spørsmål</h2>

      {faqItems.map((item, i) => (
        <div class={`accordion-item ${i === 0 ? "open" : ""}`}>
          <button class="accordion-trigger" aria-expanded={i === 0 ? "true" : "false"}>
            {item.q}
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <div class="accordion-panel"><p>{item.a}</p></div>
        </div>
      ))}

      <div class="acute-box">
        <div class="dot-icon"></div>
        <p><strong>Akutte symptomer:</strong> Videokonsultasjon er ikke en akuttjeneste. Ved nye lammelser, ansiktsskjevhet, talevansker, dobbeltsyn, besvimelse, plutselig kraftig hodepine eller andre alvorlige symptomer — søk akutt hjelp. Ring 113 ved alvorlige eller akutte symptomer. Legevakt: 116 117.</p>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      {visForesporsel ? (
        <>
          <h2>Klar for å sende en forespørsel?</h2>
          <p>Svar på noen korte spørsmål, så tar Marie kontakt innen én virkedag.</p>
          <a href="#foresporsel" class="btn btn-white">Send forespørsel</a>
        </>
      ) : (
        <>
          <h2>Klar for å bestille time?</h2>
          <p>Velg tidspunkt og få veiledning hjemmefra, i ditt eget tempo.</p>
          <a href={bookingUrl} class="btn btn-white">Bestill time</a>
        </>
      )}
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".accordion-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".accordion-item");
      const isOpen = item?.classList.toggle("open");
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  });

  // Forespørselsskjema for videokonsultasjon (kun når visForesporsel = true).
  const vForm = document.getElementById("video-form") as HTMLFormElement | null;
  if (vForm) {
    const status = document.getElementById("vf-status");
    const accessKey = (vForm.querySelector('input[name="access_key"]') as HTMLInputElement | null)?.value;

    // Prisknappene forhåndsvelger riktig timetype.
    document.querySelectorAll<HTMLAnchorElement>("a[data-type]").forEach((a) => {
      a.addEventListener("click", () => {
        const id = a.dataset.type === "oppfolging" ? "type-oppfolging" : "type-forste";
        const radio = document.getElementById(id) as HTMLInputElement | null;
        if (radio) radio.checked = true;
      });
    });

    const svar = (name: string) =>
      (vForm.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement | null)?.value;

    const setStatus = (text: string, type = "") => {
      if (!status) return;
      status.textContent = text;
      status.className = `form-status ${type}`.trim();
    };

    vForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const q1 = svar("Svimmel ved hodebevegelse");
      const q2 = svar("Anfall under ett minutt");
      const q3 = svar("Undersøkt av helsepersonell");
      const samtykke = (document.getElementById("vf-samtykke") as HTMLInputElement | null)?.checked;

      if (!q1 || !q2 || !q3) {
        setStatus("Svar på de tre spørsmålene før du sender.", "error");
        return;
      }
      if (!vForm.checkValidity()) {
        setStatus("Fyll inn navn, telefon og en gyldig e-postadresse.", "error");
        return;
      }
      if (!samtykke) {
        setStatus("Kryss av i boksen over før du sender.", "error");
        return;
      }
      if (!accessKey) {
        setStatus("Skjemaet er ikke koblet til ennå. Ring +47 46384492 eller send e-post til mariekiropraktor@gmail.com i mellomtiden.", "error");
        return;
      }

      // Enkel vurdering: typisk krystallsyke-mønster + allerede undersøkt.
      const passerVideo = q1 === "Ja" && q2 !== "Nei" && q3 === "Ja";
      const vurdering = document.getElementById("vurdering") as HTMLInputElement | null;
      if (vurdering) {
        vurdering.value = passerVideo
          ? "Video passer trolig (typisk mønster, allerede undersøkt)"
          : "Klinikk anbefalt (svarene passer ikke tydelig med video)";
      }

      const data = new FormData(vForm);
      const tider = data.getAll("Passer best").join(", ");
      data.delete("Passer best");
      data.set("Passer best", tider || "Ikke oppgitt");

      setStatus("Sender …");
      const submitBtn = vForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: data,
        });
        const result = await res.json();
        if (!result.success) throw new Error();
        // Videre til takkesiden med bekreftelse og sjekkliste.
        window.location.href = `/tjenester/videokonsultasjon/takk/?r=${passerVideo ? "video" : "klinikk"}`;
      } catch {
        setStatus("Noe gikk galt. Prøv igjen, eller ring +47 46384492.", "error");
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  :root { color-scheme: light; }
  .section { padding: 88px 0; }
  @media (max-width: 640px) { .section { padding: 56px 0; } }

  .eyebrow { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 14px; display: inline-block; }
  .eyebrow-light { color: var(--turquoise); }
  .center-heading { font-size: clamp(1.6rem, 2.6vw, 2.1rem); text-align: center; margin-bottom: 12px; }

  .btn-white { background: #fff; color: var(--navy); }
  .btn-full { width: 100%; text-align: center; justify-content: center; }
  .btn-accent { background: var(--accent); }
  .btn-accent:hover { background: var(--navy-2); }

  .text-link-light {
    color: #fff; font-weight: 600; font-size: 0.95rem;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.4); padding-bottom: 2px; text-decoration: none;
  }
  .text-link-light:hover { border-color: #fff; }

  /* HERO */
  .hero { background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%); position: relative; overflow: hidden; padding: 88px 0 100px; }
  .hero::before {
    content: ""; position: absolute; top: -140px; right: -120px; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(95, 193, 214, 0.35), transparent 70%);
  }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; position: relative; z-index: 2; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; margin-bottom: 22px; }
  .hero h1 em { font-style: italic; color: var(--turquoise); font-family: var(--font-display); }
  .hero .lead { color: rgba(255, 255, 255, 0.85); font-size: 1.12rem; line-height: 1.6; max-width: 460px; margin-bottom: 32px; }
  .hero-ctas { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }

  .hero-media {
    border-radius: 26px; overflow: hidden; box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .hero-photo { width: 100%; height: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }

  /* HELP */
  .help-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start; }
  @media (max-width: 900px) { .help-grid { grid-template-columns: 1fr; } }
  .help-grid h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); margin-bottom: 16px; line-height: 1.2; }
  .help-grid .intro { color: var(--ink-soft); font-size: 1.03rem; line-height: 1.65; }
  .help-list { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 560px) { .help-list { grid-template-columns: 1fr; gap: 12px; } }
  .help-item { background: #fff; border-radius: 18px; padding: 18px 22px; box-shadow: 0 8px 22px rgba(22, 56, 117, 0.06); }
  .help-item p { margin: 0; font-weight: 600; color: var(--navy); font-size: 0.96rem; line-height: 1.4; }

  /* SAFETY */
  .safety-box { background: var(--beige); padding: 52px 0; }
  .safety-inner { display: flex; gap: 26px; align-items: flex-start; max-width: 860px; margin: 0 auto; }
  .safety-inner h3 { font-size: 1.25rem; margin-bottom: 10px; }
  .safety-inner p { color: var(--ink-soft); line-height: 1.65; margin: 0; }
  @media (max-width: 600px) { .safety-inner { flex-direction: column; } }

  /* PRICING */
  .price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin-top: 44px; }
  @media (max-width: 900px) { .price-grid { grid-template-columns: 1fr; } }
  .price-card { border: 1.5px solid var(--line); border-radius: 26px; padding: 34px; background: #fff; position: relative; }
  .price-card.featured { border: 2px solid var(--accent); box-shadow: 0 20px 44px rgba(37, 100, 120, 0.16); }
  @media (max-width: 900px) { .price-card.featured { order: -1; } }
  .price-badge {
    position: absolute; top: -14px; left: 34px; background: var(--accent); color: #fff; font-size: 0.7rem;
    font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px;
  }
  .price-card .mins { color: var(--ink-soft); font-weight: 600; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.05em; }

---
import Layout from "../../../layouts/Layout.astro";

// Hjemmebesøk ved akutt krystallsyke — bygget på samme mal og klasser som
// /tjenester/videokonsultasjon/. Forespørselen sendes via Web3Forms.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";

// Hero-bilde: legg filen i public/ og skriv stien her (f.eks. "/hero-hjemmebesok.jpg").
// Så lenge den er null, vises heroen i én kolonne uten bilde.
const heroImage: string | null = null;

const naarItems = [
  "Kraftig svimmelhet når du snur deg i sengen eller ser opp",
  "Du er for kvalm eller ustø til å kjøre eller ta kollektivt",
  "Det er kveld eller helg, og klinikken er stengt",
  "Du bor i Lillestrøm, Lørenskog, Rælingen eller Oslo-området",
];

const steps = [
  { num: "01", title: "Send en forespørsel", desc: "Fortell kort om svimmelheten og hvor du bor." },
  { num: "02", title: "Jeg ringer deg", desc: "Vi avklarer om hjemmebesøk passer, og avtaler pris og tidspunkt. Som regel ringer jeg innen en time, og alltid innen én arbeidsdag." },
  { num: "03", title: "Behandling hjemme", desc: "Jeg undersøker deg, finner riktig buegang og gjør manøveren der du er." },
];

const faqItems = [
  {
    q: "Hva om det ikke er krystallsyke?",
    a: "Da sier jeg det, og hjelper deg videre til riktig sted.",
  },
  {
    q: "Trenger jeg flere besøk?",
    a: "Det kommer an på hvordan du svarer på behandlingen, og hvordan du fungerer i hverdagen. Vi avtaler veien videre etter første besøk.",
  },
  {
    q: "Kommer du på dagtid også?",
    a: "Nei, hjemmebesøk er bare på kveldstid og i helgene. På dagtid kan du få time på klinikken i Fetsund.",
  },
];
---

<Layout
  title="Hjemmebesøk ved akutt krystallsyke | Krystallsykehjelpen"
  description="For svimmel til å reise? Hjemmebesøk ved akutt krystallsyke på kveldstid og i helgene, i Lillestrøm, Lørenskog, Rælingen og Oslo-området."
  activePath="/tjenester/hjemmebesok/"
>
  <section class="hero">
    <div class={`container hero-grid${heroImage ? "" : " no-media"}`}>
      <div>
        <span class="eyebrow eyebrow-light">Hjemmebesøk</span>
        <h1>For svimmel til å reise?<br /><em>Jeg kommer hjem til deg.</em></h1>
        <p class="lead">Ved akutt krystallsyke kan selv turen til bilen kjennes umulig. Da kan du få undersøkelse og behandling hjemme, på kveldstid og i helgene.</p>
        <div class="hero-ctas">
          <a href="#foresporsel" class="btn btn-white">Send forespørsel</a>
          <a href="#pris" class="text-link-light">Se pris</a>
        </div>
      </div>
      {heroImage && (
        <div class="hero-media">
          <img src={heroImage} alt="Hjemmebesøk ved akutt krystallsyke" class="hero-photo" />
        </div>
      )}
    </div>
  </section>

  <section class="section" id="naar">
    <div class="container help-grid">
      <div>
        <h2>Når passer hjemmebesøk?</h2>
        <p class="intro">Hjemmebesøk er for deg som har typiske tegn på krystallsyke, men er for svimmel eller kvalm til å komme deg til klinikken.</p>
      </div>
      <div class="help-list">
        {naarItems.map((text) => (
          <div class="help-item">
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="safety-box">
    <div class="container safety-inner">
      <div>
        <h3>Når du bør oppsøke lege i stedet</h3>
        <p>Oppsøk lege eller legevakt (116 117) om svimmelheten er annerledes enn typisk krystallsyke, for eksempel om den varer konstant, kommer med hørselstap eller ikke henger sammen med bevegelser av hodet. Ring 113 ved lammelser, ansiktsskjevhet, talevansker, dobbeltsyn, besvimelse eller plutselig kraftig hodepine.</p>
      </div>
    </div>
  </section>

  <section class="section" id="pris">
    <div class="container">
      <h2 class="center-heading">Tid og pris</h2>
      <p class="pris-undertekst">Kveld og helg · samme pris uansett tidspunkt</p>
      <div class="price-grid">
        <div class="price-card featured">
          <span class="mins">Nærområdet</span>
          <div class="amount">2 500 kr</div>
          <p class="desc">Lillestrøm, Lørenskog og Rælingen kommune</p>
        </div>
        <div class="price-card">
          <span class="mins">Oslo og andre kommuner</span>
          <div class="amount">2 900 kr</div>
          <p class="desc">Inkludert 400 kr i reisetillegg for bom, parkering og kjøretid</p>
        </div>
      </div>
      <ul class="pris-punkter">
        <li>Du får bekreftet pris og tidspunkt før jeg kommer</li>
        <li>Ingen ekstra kostnader i tillegg til prisen over</li>
        <li>Undersøkelse og behandling i samme besøk</li>
      </ul>
    </div>
  </section>

  <section class="section steps-section" id="slik">
    <div class="container">
      <h2 class="center-heading">Slik fungerer det</h2>
      <div class="steps-grid">
        {steps.map((step) => (
          <div class="step">
            <span class="num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="helper-section">
    <div class="container helper-grid">
      <div>
        <span class="eyebrow eyebrow-light">Før jeg kommer</span>
        <h2>Ha en seng eller sofa klar</h2>
        <p>Manøvrene gjøres liggende, så det er fint med en seng eller sofa jeg kan komme til fra siden. Er det noen andre hjemme, er det trygt å ha dem i nærheten.</p>
      </div>
      <ul class="klar-liste">
        <li>Seng eller sofa med plass rundt</li>
        <li>Oversikt over medisiner du bruker</li>
        <li>Adresse, adkomst og parkering klart</li>
      </ul>
    </div>
  </section>

  <section class="section request-section" id="foresporsel">
    <div class="container request-container">
      <span class="eyebrow">Forespørsel</span>
      <h2>Be om hjemmebesøk</h2>
      <p class="request-lead">Fyll inn det viktigste, så ringer jeg deg tilbake, som regel innen en time.</p>

      <form id="hjem-form" class="request-card" novalidate>
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="Forespørsel om hjemmebesøk" />
        <input type="hidden" name="from_name" value="Krystallsykehjelpen – hjemmebesøk" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <fieldset>
          <legend>Kontaktinformasjon</legend>
          <div class="field-grid">
            <label class="field">Navn<input type="text" name="name" id="hf-navn" autocomplete="name" required /></label>
            <label class="field">Telefon<input type="tel" name="Telefon" id="hf-tlf" autocomplete="tel" required /></label>
          </div>
          <label class="field">Kommune
            <select name="Kommune" id="hf-kommune" required>
              <option value="">Velg kommune</option>
              <option>Lillestrøm</option>
              <option>Lørenskog</option>
              <option>Rælingen</option>
              <option>Oslo</option>
              <option>Annen kommune</option>
            </select>
          </label>
        </fieldset>

        <fieldset>
          <legend>Om svimmelheten</legend>
          <label class="field" for="hf-melding">
            <span>Kort om svimmelheten</span>
            <textarea name="Melding" id="hf-melding" rows="4" maxlength="1000" placeholder="Når startet det, og hva utløser svimmelheten?"></textarea>
          </label>
          <small class="field-hint">Hold det kort. Resten tar vi når jeg ringer.</small>
        </fieldset>

        <label class="consent">
          <input type="checkbox" id="hf-samtykke" />
          <span>Jeg har ingen lammelser, talevansker, dobbeltsyn eller plutselig kraftig hodepine.</span>
        </label>

        <p id="hf-status" class="form-status" role="status" aria-live="polite"></p>
        <button type="submit" class="btn btn-primary">Send forespørsel</button>
      </form>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-container">
      <h2 class="center-heading">Ofte stilte spørsmål</h2>
      {faqItems.map((item, i) => (
        <div class={`accordion-item ${i === 0 ? "open" : ""}`}>
          <button class="accordion-trigger" aria-expanded={i === 0 ? "true" : "false"}>
            {item.q}
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <div class="accordion-panel"><p>{item.a}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <h2>Kan du ikke komme deg til klinikken?</h2>
      <p>Send en forespørsel, så finner vi en tid i kveld eller i helgen.</p>
      <a href="#foresporsel" class="btn btn-white">Send forespørsel</a>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".accordion-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".accordion-item");
      const isOpen = item?.classList.toggle("open");
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  });

  // Forespørselsskjema for hjemmebesøk.
  const hForm = document.getElementById("hjem-form") as HTMLFormElement | null;
  if (hForm) {
    const status = document.getElementById("hf-status");
    const accessKey = (hForm.querySelector('input[name="access_key"]') as HTMLInputElement | null)?.value;

    const setStatus = (text: string, type = "") => {
      if (!status) return;
      status.textContent = text;
      status.className = `form-status ${type}`.trim();
    };

    hForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const samtykke = (document.getElementById("hf-samtykke") as HTMLInputElement | null)?.checked;

      if (!hForm.checkValidity()) {
        setStatus("Fyll inn navn, telefon og kommune.", "error");
        return;
      }
      if (!samtykke) {
        setStatus("Kryss av i boksen før du sender. Har du noen av disse symptomene, ring 113.", "error");
        return;
      }
      if (!accessKey) {
        setStatus("Skjemaet er ikke koblet til ennå. Ring +47 46384492 i mellomtiden.", "error");
        return;
      }

      setStatus("Sender …");
      const submitBtn = hForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(hForm),
        });
        const result = await res.json();
        if (!result.success) throw new Error();
        hForm.reset();
        setStatus("Takk! Forespørselen er sendt. Jeg ringer deg tilbake, som regel innen en time.", "ok");
      } catch {
        setStatus("Noe gikk galt. Prøv igjen, eller ring +47 46384492.", "error");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  :root { color-scheme: light; }
  .section { padding: 88px 0; }
  @media (max-width: 640px) { .section { padding: 56px 0; } }

  .eyebrow { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 14px; display: inline-block; }
  .eyebrow-light { color: var(--turquoise); }
  .center-heading { font-size: clamp(1.6rem, 2.6vw, 2.1rem); text-align: center; margin-bottom: 12px; }

  .btn-white { background: #fff; color: var(--navy); }
  .btn-full { width: 100%; text-align: center; justify-content: center; }
  .btn-accent { background: var(--accent); }
  .btn-accent:hover { background: var(--navy-2); }

  .text-link-light {
    color: #fff; font-weight: 600; font-size: 0.95rem;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.4); padding-bottom: 2px; text-decoration: none;
  }
  .text-link-light:hover { border-color: #fff; }

  /* HERO */
  .hero { background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%); position: relative; overflow: hidden; padding: 88px 0 100px; }
  .hero::before {
    content: ""; position: absolute; top: -140px; right: -120px; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(95, 193, 214, 0.35), transparent 70%);
  }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; position: relative; z-index: 2; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; margin-bottom: 22px; }
  .hero h1 em { font-style: italic; color: var(--turquoise); font-family: var(--font-display); }
  .hero .lead { color: rgba(255, 255, 255, 0.85); font-size: 1.12rem; line-height: 1.6; max-width: 460px; margin-bottom: 32px; }
  .hero-ctas { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }

  .hero-media {
    border-radius: 26px; overflow: hidden; box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .hero-photo { width: 100%; height: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }

  /* HELP */
  .help-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start; }
  @media (max-width: 900px) { .help-grid { grid-template-columns: 1fr; } }
  .help-grid h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); margin-bottom: 16px; line-height: 1.2; }
  .help-grid .intro { color: var(--ink-soft); font-size: 1.03rem; line-height: 1.65; }
  .help-list { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 560px) { .help-list { grid-template-columns: 1fr; gap: 12px; } }
  .help-item { background: #fff; border-radius: 18px; padding: 18px 22px; box-shadow: 0 8px 22px rgba(22, 56, 117, 0.06); }
  .help-item p { margin: 0; font-weight: 600; color: var(--navy); font-size: 0.96rem; line-height: 1.4; }

  /* SAFETY */
  .safety-box { background: var(--beige); padding: 52px 0; }
  .safety-inner { display: flex; gap: 26px; align-items: flex-start; max-width: 860px; margin: 0 auto; }
  .safety-inner h3 { font-size: 1.25rem; margin-bottom: 10px; }
  .safety-inner p { color: var(--ink-soft); line-height: 1.65; margin: 0; }
  @media (max-width: 600px) { .safety-inner { flex-direction: column; } }

  /* PRICING */
  .price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin-top: 44px; }
  @media (max-width: 900px) { .price-grid { grid-template-columns: 1fr; } }
  .price-card { border: 1.5px solid var(--line); border-radius: 26px; padding: 34px; background: #fff; position: relative; }
  .price-card.featured { border: 2px solid var(--accent); box-shadow: 0 20px 44px rgba(47, 121, 201, 0.16); }
  @media (max-width: 900px) { .price-card.featured { order: -1; } }
  .price-badge {
    position: absolute; top: -14px; left: 34px; background: var(--accent); color: #fff; font-size: 0.7rem;
    font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px;
  }
  .price-card .mins { color: var(--ink-soft); font-weight: 600; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .price-card .amount { font-family: var(--font-display); font-size: 2.5rem; color: var(--navy); margin: 8px 0 4px; }
  .price-card .subtitle { font-weight: 700; color: var(--navy); margin-bottom: 12px; font-size: 1.02rem; }
  .price-card .desc { color: var(--ink-soft); font-size: 0.94rem; line-height: 1.55; margin-bottom: 18px; }
  .price-card ul { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 10px; }
  .price-card li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.9rem; color: var(--ink); }
  .price-card li::before { content: "✓"; color: var(--turquoise); font-weight: 700; }

  .price-note { text-align: center; margin: 22px 0 0; font-size: 0.95rem; }

  /* FORESPØRSEL */
  .request-section { background: var(--beige); }
  .request-container { max-width: 760px; }
  .request-container h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); margin-bottom: 12px; }
  .request-lead { font-size: 1.05rem; line-height: 1.6; max-width: 600px; }
  .request-card {
    background: #fff; border-radius: 26px; padding: clamp(22px, 4vw, 40px); margin-top: 28px;
    box-shadow: 0 16px 40px rgba(22, 56, 117, 0.09); display: grid; gap: 28px;
  }
  .botcheck { display: none; }
  .request-alert {
    border: 2px solid var(--navy-2); border-radius: 18px; padding: 18px 20px;
    display: flex; gap: 14px; align-items: flex-start;
  }
  .alert-icon {
    width: 30px; height: 30px; min-width: 30px; border-radius: 50%; background: var(--navy-2); color: #fff;
    font-family: var(--font-display); font-weight: 600; display: flex; align-items: center; justify-content: center;
  }
  .request-alert p { margin: 0; font-size: 0.94rem; line-height: 1.55; }
  .request-alert strong { color: var(--navy-2); }
  .request-card fieldset { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 14px; }
  .request-card legend { font-family: var(--font-display); font-size: 1.25rem; color: var(--navy); margin-bottom: 8px; padding: 0; }
  .question { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }
  .question:first-of-type { border-top: 0; padding-top: 0; }
  .question p { margin: 0; font-weight: 600; color: var(--navy); line-height: 1.45; }
  .question small { color: var(--ink-soft); font-size: 0.88rem; }
  .choices { display: flex; flex-wrap: wrap; gap: 10px; }
  .choice {
    position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 10px 18px;
    border: 1.5px solid var(--line); border-radius: 999px; background: #fff; cursor: pointer;
    font-size: 0.95rem; color: var(--navy); font-weight: 600;
  }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice:has(input:checked) { background: var(--navy); border-color: var(--navy); color: #fff; }
  .choice:has(input:focus-visible) { outline: 3px solid var(--turquoise); outline-offset: 2px; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .field-grid { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 6px; font-weight: 600; font-size: 0.94rem; color: var(--navy); min-width: 0; }
  .field input {
    font: 400 1rem var(--font-body); padding: 13px 14px; border: 1.5px solid var(--line);
    border-radius: 12px; color: var(--ink); background: #fff; width: 100%;
  }
  .field textarea {
    font: 400 1rem var(--font-body); padding: 13px 14px; border: 1.5px solid var(--line);
    border-radius: 12px; color: var(--ink); background: #fff; width: 100%; resize: vertical; min-height: 110px;
  }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); }
  .optional { font-weight: 400; color: var(--ink-soft); }
  .field-hint { color: var(--ink-soft); font-size: 0.88rem; margin-top: -4px; }
  .consent {
    display: flex; gap: 12px; align-items: flex-start; background: var(--sky); border-radius: 14px;
    padding: 16px; font-size: 0.94rem; line-height: 1.5; color: var(--ink); cursor: pointer;
  }
  .consent input { width: 20px; height: 20px; min-width: 20px; margin-top: 2px; accent-color: var(--navy); }
  .form-status { margin: 0; font-weight: 600; font-size: 0.94rem; }
  .form-status:empty { display: none; }
  .form-status.error { color: var(--navy-2); }
  .request-card .btn-primary { justify-self: start; border: 0; cursor: pointer; }
  .request-card .btn-primary:disabled { opacity: 0.6; cursor: wait; }

  /* MEDHJELPER */
  .helper-section { background: var(--navy); color: #fff; padding: 72px 0; }
  .helper-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; }
  @media (max-width: 900px) { .helper-grid { grid-template-columns: 1fr; } }
  .helper-grid h2 { color: #fff; font-size: clamp(1.5rem, 2.4vw, 2rem); margin-bottom: 16px; line-height: 1.25; }
  .helper-grid p { color: rgba(255, 255, 255, 0.82); line-height: 1.65; font-size: 1rem; margin: 0; }
  .helper-visual {
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 26px;
    padding: 30px; display: flex; gap: 18px; align-items: center; justify-content: center;
  }
  .helper-avatar { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 600; color: #fff; font-size: 1.25rem; }
  .helper-avatar.a { background: linear-gradient(135deg, var(--turquoise), var(--accent)); }
  .helper-avatar.b { background: linear-gradient(135deg, var(--accent), var(--navy-2)); margin-top: 24px; }
  .helper-avatar.c { background: rgba(255, 255, 255, 0.15); border: 1px dashed rgba(255, 255, 255, 0.4); }

  /* STEPS */
  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-top: 44px; }
  @media (max-width: 900px) { .steps-grid { grid-template-columns: 1fr; } }
  .step .num { font-family: var(--font-display); font-size: 1.05rem; color: var(--accent); font-weight: 600; margin-bottom: 12px; display: block; }
  .step h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .step p { color: var(--ink-soft); line-height: 1.6; margin: 0; font-size: 0.95rem; }

  /* FAQ */

# Kopier denne filen til .env og fyll inn ekte verdier. .env er
# gitignored og skal aldri committes.

# Sanity-prosjektet (ikke hemmeligheter — bakes uansett inn i klientkoden)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# Skrivetoken til Sanity, brukt av engangsskriptene i scripts/ (seeding,
# import). Opprettes i sanity.io/manage → prosjektet → API → Tokens
# (rolle: Editor). Skal ALDRI eksponeres til klienten eller committes.
SANITY_API_WRITE_TOKEN=

# Kontaktskjema på /kontakt/ (Web3Forms — gratis, ingen egen backend).
# Opprett konto på web3forms.com og lim inn Access Key-en her.
PUBLIC_WEB3FORMS_KEY=

# Lokal forhåndsvisning av upubliserte svimmelhet-utkast (diagnosisPage og
# svimmelhetPage) — hører hjemme i .env.local, IKKE .env (holdes bevisst
# adskilt fra vanlige prosjekt-variabler siden dette er personlig, midlertidig
# oppsett for én person). Se README/rapport for steg-for-steg-oppskrift på
# å lage et lesetoken (rolle: Viewer) i sanity.io/manage.
SANITY_PREVIEW_DRAFTS=
SANITY_READ_TOKEN=
